<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Action</key>
	<string>replace</string>
	<key>Job</key>
	<dict>
		<key>EnablePressuredExit</key>
		<false/>
		<key>EnableTransactions</key>
		<true/>
		<key>ExitTimeOut</key>
		<integer>18</integer>
		<key>KeepAlive</key>
		<dict>
			<key>Crashed</key>
			<true/>
		</dict>
		<key>Label</key>
		<string>com.apple.abm-helper</string>
		<key>MachServices</key>
		<dict>
			<key>com.apple.abm.helper.wireless</key>
			<dict>
				<key>ResetAtClose</key>
				<true/>
			</dict>
		</dict>
		<key>ProgramArguments</key>
		<array>
			<string>/redwood/bin/bbstart</string>
			<string>/System/Library/PrivateFrameworks/ABMHelper.framework/Support/abm-helper</string>
		</array>
		<key>UserName</key>
		<string>_wireless</string>
	</dict>
	<key>Key</key>
	<string>/System/Library/LaunchDaemons/com.apple.abm-helper.plist</string>
</dict>
</plist>
