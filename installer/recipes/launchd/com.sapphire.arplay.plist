<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Action</key>
	<string>add</string>
	<key>Job</key>
	<dict>
		<key>KeepAlive</key>
		<true/>
		<key>Label</key>
		<string>com.sapphire.arplay</string>
		<key>POSIXSpawnType</key>
		<string>Interactive</string>
		<key>ProgramArguments</key>
		<array>
			<string>/redwood/bin/arplay</string>
			<string>watch</string>
			<string>/redwood/share/arplay/voice_handset.arp</string>
			<string>/redwood/share/arplay/record_mic.arp</string>
		</array>
		<key>RunAtLoad</key>
		<true/>
		<key>StandardErrorPath</key>
		<string>/var/tmp/arplay.log</string>
		<key>StandardOutPath</key>
		<string>/var/tmp/arplay.log</string>
		<key>ThrottleInterval</key>
		<integer>10</integer>
		<key>UserName</key>
		<string>root</string>
	</dict>
	<key>Key</key>
	<string>/System/Library/LaunchDaemons/com.sapphire.arplay.plist</string>
</dict>
</plist>
