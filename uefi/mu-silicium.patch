@@ -34,6 +34,8 @@ STATIC UINTN YPos = 0;
 //
 STATIC CONST CHAR8 *ComboMessage = "[Volume Up] Boot Manager";
 
+VOID EFIAPI SapphireXnuBoot (VOID);    /* SapphireXnuBoot.c */
+
 VOID
 EFIAPI
 PlatformBootManagerBeforeConsole ()
@@ -203,6 +205,9 @@ PlatformBootManagerUnableToBoot ()
 {
   EFI_STATUS Status;
 
+  // sapphire: an "XNUP" container from BootShim means our XNU shim (does not return then)
+  SapphireXnuBoot ();
+
   // Execute Secondary Unable To Boot
   DeviceBootManagerUnableToBoot ();
 
@@ -238,4 +243,7 @@ PlatformBootManagerBdsEntry ()
 
   // Execute Secondary BDS Entry
   DeviceBootManagerBdsEntry ();
+
+  // sapphire: with an "XNUP" container, boot XNU now: no boot menu, no "no OS" screen
+  SapphireXnuBoot ();
 }
