<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.sapphire.fpd: fingerprint unlock (fpd.c). /var/jb/Library/LaunchDaemons is not loaded at boot here, so
  this dict is put into launchd's cache, /System/Library/xpc/launchd.plist, under
  /System/Library/LaunchDaemons/com.sapphire.fpd.plist by fpd-launchd.py (install.sh; the cache before it:
  launchd.plist.pre-fpd). This file itself is also copied to /redwood/share/fpd/ to start the job without a
  reboot (fptest.sh start). Kept alive always (jetsam once killed it as an idle daemon, which launchd counted as a clean
  exit): high jetsam priority, no pressured exit; a restart comes at most every 30 s.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sapphire.fpd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/fpd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>EnablePressuredExit</key>
	<false/>
	<key>EnableTransactions</key>
	<false/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>JetsamProperties</key>
	<dict>
		<key>JetsamPriority</key>
		<integer>18</integer>
		<key>JetsamMemoryLimit</key>
		<integer>32</integer>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>UserName</key>
	<string>root</string>
	<key>POSIXSpawnType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/var/tmp/fpd.out</string>
	<key>StandardErrorPath</key>
	<string>/var/tmp/fpd.out</string>
</dict>
</plist>
