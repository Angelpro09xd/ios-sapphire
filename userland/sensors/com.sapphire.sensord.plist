<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.sapphire.sensord: the motion and environment sensors for iOS (sensord.c). Put into launchd's cache,
  /System/Library/xpc/launchd.plist, under /System/Library/LaunchDaemons/com.sapphire.sensord.plist by launchd-job.py
  (install.sh; the cache before it: launchd.plist.pre-sensord): /var/jb/Library/LaunchDaemons is not loaded at boot
  here. Kept alive like fpd (jetsam once killed fpd as an idle daemon).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sapphire.sensord</string>
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/sensord</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>EnablePressuredExit</key>
	<false/>
	<key>EnableTransactions</key>
	<false/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>JetsamProperties</key>
	<dict>
		<key>JetsamPriority</key>
		<integer>18</integer>
		<key>JetsamMemoryLimit</key>
		<integer>24</integer>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>UserName</key>
	<string>root</string>
	<key>POSIXSpawnType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/var/tmp/sensord.out</string>
	<key>StandardErrorPath</key>
	<string>/var/tmp/sensord.out</string>
</dict>
</plist>
