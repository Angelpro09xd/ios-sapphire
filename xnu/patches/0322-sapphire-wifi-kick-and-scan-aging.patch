+SYSCTL_INT(_kern, OID_AUTO, sweet_wifid_opened, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_wifid_opened, 0,
+    "sapphire: times wifid read RSSI_BOUNDS (the device opened)");
 
