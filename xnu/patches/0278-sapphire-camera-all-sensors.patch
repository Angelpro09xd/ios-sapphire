 /* ---------------------------------------------------------------- op 10: sensor init, mode, stream on */
 
+/*
+ * 0278: the D-PHY sensors. CSID RX_CFG0 = (lanes-1) | lane_cfg << 4 | (csiphy+1) << 20; the macro
+ * uses one lane (CSIPHY1, the CSI mux GPIO34 high), the ultra wide CSIPHY1 with the mux low, the
+ * front CSIPHY2 (DT csiphy-sd-index).
+ */
+#define NT(a) (unsigned)(sizeof(a) / sizeof((a)[0]))
+static const struct cam_sdesc {
+	const char *name;
+	unsigned m, addr, idreg, id;
+	const struct cam_reg *init, *mode, *on, *off;
+	unsigned ni, nm, non, noff, w, h, phy, lanes, settle;
+	uint32_t rxcfg0;
+} sdesc[4] = {
+	[1] = { "OV16A1Q", 1, 0x10, 0x300B, 0x1641, ov_init, ov_mode0, ov_on, ov_off, NT(ov_init), NT(ov_mode0), NT(ov_on),
+		NT(ov_off), 2304, 1728, 2, 4, 0x0E, 0x00332103 },
+	[2] = { "S5K4H7", 1, 0x2D, 0x0000, 0x487B, h7_init, h7_mode0, h7_on, h7_off, NT(h7_init), NT(h7_mode0), NT(h7_on),
+		NT(h7_off), 3264, 2448, 1, 4, 0x0E, 0x00232103 },
+	[3] = { "SC202PCS", 0, 0x36, 0x3107, 0xEB52, sc_init, sc_mode0, sc_on, sc_off, NT(sc_init), NT(sc_mode0), NT(sc_on),
+		NT(sc_off), 1600, 1200, 1, 1, 0x14, 0x00200000 },
+};
+
+/* the current sensor's stream on/off table */
+static int
+cam_stream_onoff(bool on)
+{
+	if (cs.slot == 0) {
+		return on ? cam_replay(0, 0x10, hm6_on, NT(hm6_on), "HM6 stream on") :
+		       cam_replay(0, 0x10, hm6_off, NT(hm6_off), "HM6 stream off");
+	}
+	const struct cam_sdesc *d = &sdesc[cs.slot];
+	return on ? cam_replay(d->m, d->addr, d->on, d->non, "stream on") : cam_replay(d->m, d->addr, d->off, d->noff, "stream off");
+}
