From 84f799b2b11723c0205e423ef3b13faa77050ca9 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Fri, 23 Oct 2026 21:17:44 +0000
Subject: [PATCH] sapphire-0168: the audio test after the USB log is up, the
 graph opened in two parts

0167 on the phone: the graph open (~600 bytes in one packet) was never
answered, and what came before it was lost (the USB log starts ~40 s
into the boot). The test now runs at 45 s; the graph is opened as Linux
does, the stream subgraph and then the device subgraph with the link
into it, each under the 512 bytes the ADSP's receive buffers on
adsp_apps hold; intent requests and the ADSP's buffer sizes are logged.
---
 iokit/Kernel/arm/TopazModem.cpp | 140 ++++++++++++++++++++------------
 1 file changed, 89 insertions(+), 51 deletions(-)

diff --git a/iokit/Kernel/arm/TopazModem.cpp b/iokit/Kernel/arm/TopazModem.cpp
index b2ba9f7..29a42af 100644
--- a/iokit/Kernel/arm/TopazModem.cpp
+++ b/iokit/Kernel/arm/TopazModem.cpp
@@ -8007,6 +8007,8 @@ a_try_send(struct a_chan *c, const void *data, uint32_t len)
 	}
 	if (i == c->ri_count) {
 		if (!c->intent_req_sent) {
+			LOG("adsp: t=%u ms: \"%s\": no receive buffer of %u bytes among the ADSP's %u, asking for one", a_ms, c->name,
+			    len, c->ri_count);
 			a_cmd(CMD_RX_INTENT_REQ, c->lcid, len);
 			c->intent_req_sent = true;
 		}
@@ -8180,6 +8182,7 @@ a_rx_one(void)
 		break;
 	case CMD_RX_INTENT_REQ_ACK:
 		a_rx_advance(8);
+		LOG("adsp: t=%u ms: glink intent request %s (rcid %u)", a_ms, m.p2 ? "granted" : "refused", m.p1);
 		if (m.p2 == 0 && (c = a_by_rcid(m.p1)) != NULL) {
 			c->intent_req_sent = false;
 		}
@@ -8430,6 +8433,7 @@ a_gpr_rx(const uint8_t *p, uint32_t len)
 #define DATA_CMD_WR_SH_MEM_EP_DATA_BUFFER_V2      0x0400100Au
 #define DATA_CMD_RSP_WR_SH_MEM_EP_DATA_BUFFER_DONE_V2 0x05001004u
 #define A_SG        0x4001u
+#define A_SG_DEV    0x4002u
 #define A_CONT_STR  0x5001u
 #define A_CONT_DEV  0x5002u
 #define A_WRSH      0x6001u
@@ -8580,72 +8584,84 @@ a_prm(uint32_t pid, const uint32_t *v, unsigned n)
 	return r;
 }
 
+/*
+ * A graph is opened in two parts, as Linux does (the stream's subgraph, then the device's with the
+ * connection between them): all of it at once is ~600 bytes, more than the 512-byte receive
+ * buffers the ADSP offers on adsp_apps, and that open was never answered.
+ */
+static const struct { uint32_t sg, cont, mid, iid, ip, op; } a_mods[] = {
+	{ A_SG,     A_CONT_STR, 0x07001000, A_WRSH, 0, 1 },        /* WR_SHARED_MEM_EP */
+	{ A_SG,     A_CONT_STR, 0x07001005, A_PCMDEC, 1, 1 },      /* PCM_DEC */
+	{ A_SG,     A_CONT_STR, 0x07001003, A_PCMCNV, 1, 1 },      /* PCM_CNV */
+	{ A_SG_DEV, A_CONT_DEV, 0x07001015, A_MFC, 1, 1 },         /* MFC */
+	{ A_SG_DEV, A_CONT_DEV, 0x07001023, A_CDMA, 1, 0 },        /* CODEC_DMA_SINK */
+};
+
 static int64_t
-a_graph_open(uint32_t cap_str, uint32_t cap_dev)
+a_graph_open_part(uint32_t sg, uint32_t direction, uint32_t cont, uint32_t cap, uint32_t link_from)
 {
-	static const struct { uint32_t cont, mid, iid, ip, op; } mods[] = {
-		{ A_CONT_STR, 0x07001000, A_WRSH, 0, 1 },          /* WR_SHARED_MEM_EP */
-		{ A_CONT_STR, 0x07001005, A_PCMDEC, 1, 1 },        /* PCM_DEC */
-		{ A_CONT_STR, 0x07001003, A_PCMCNV, 1, 1 },        /* PCM_CNV */
-		{ A_CONT_DEV, 0x07001015, A_MFC, 1, 1 },           /* MFC */
-		{ A_CONT_DEV, 0x07001023, A_CDMA, 1, 0 },          /* CODEC_DMA_SINK */
-	};
-	const unsigned nm = sizeof(mods) / sizeof(mods[0]);
+	const unsigned all = sizeof(a_mods) / sizeof(a_mods[0]);
 	struct a_pb *pb = (struct a_pb *)IOMalloc(sizeof(*pb));
+	unsigned nm = 0, nc = 0;
 	uint8_t *p;
 	int64_t r;
 
 	if (pb == NULL) {
 		return -1;
 	}
+	for (unsigned i = 0; i < all; i++) {
+		if (a_mods[i].sg == sg) {
+			nm++;
+			nc += i + 1 < all && a_mods[i + 1].sg == sg;
+		}
+	}
+	nc += link_from != 0;
 	pb->n = 0;
-	/* one subgraph: RX, low latency, playback */
 	p = a_param(pb, APM_PORT, 0x08001001, 4 + 44);
 	a_put32(&p, 1);
-	a_put32(&p, A_SG); a_put32(&p, 3);
-	a_put32(&p, 0x0800100E); a_put32(&p, 4); a_put32(&p, 2);   /* perf mode: low latency */
-	a_put32(&p, 0x0800100F); a_put32(&p, 4); a_put32(&p, 2);   /* direction: RX */
-	a_put32(&p, 0x08001010); a_put32(&p, 4); a_put32(&p, 1);   /* scenario: playback */
-	/* two containers */
-	p = a_param(pb, APM_PORT, 0x08001000, 4 + 2 * 60);
-	a_put32(&p, 2);
-	for (unsigned c = 0; c < 2; c++) {
-		a_put32(&p, c == 0 ? A_CONT_STR : A_CONT_DEV); a_put32(&p, 4);
-		a_put32(&p, 0x08001011); a_put32(&p, 8); a_put32(&p, 1); a_put32(&p, c == 0 ? cap_str : cap_dev);
-		a_put32(&p, 0x08001012); a_put32(&p, 4); a_put32(&p, 1);   /* graph position: stream */
-		a_put32(&p, 0x08001013); a_put32(&p, 4); a_put32(&p, 8192);
-		a_put32(&p, 0x08001014); a_put32(&p, 4); a_put32(&p, 2);   /* processing domain: ADSP */
-	}
-	/* module lists, one per container */
-	p = a_param(pb, APM_PORT, 0x08001002, 4 + 2 * 12 + nm * 8);
-	a_put32(&p, 2);
-	for (unsigned c = 0; c < 2; c++) {
-		uint32_t cont = c == 0 ? A_CONT_STR : A_CONT_DEV, k = 0;
-		for (unsigned i = 0; i < nm; i++) {
-			k += mods[i].cont == cont;
-		}
-		a_put32(&p, A_SG); a_put32(&p, cont); a_put32(&p, k);
-		for (unsigned i = 0; i < nm; i++) {
-			if (mods[i].cont == cont) {
-				a_put32(&p, mods[i].mid); a_put32(&p, mods[i].iid);
-			}
+	a_put32(&p, sg); a_put32(&p, 3);
+	a_put32(&p, 0x0800100E); a_put32(&p, 4); a_put32(&p, 2);    /* perf mode: low latency */
+	a_put32(&p, 0x0800100F); a_put32(&p, 4); a_put32(&p, direction);
+	a_put32(&p, 0x08001010); a_put32(&p, 4); a_put32(&p, 1);    /* scenario: playback */
+	p = a_param(pb, APM_PORT, 0x08001000, 4 + 60);
+	a_put32(&p, 1);
+	a_put32(&p, cont); a_put32(&p, 4);
+	a_put32(&p, 0x08001011); a_put32(&p, 8); a_put32(&p, 1); a_put32(&p, cap);
+	a_put32(&p, 0x08001012); a_put32(&p, 4); a_put32(&p, 1);    /* graph position: stream */
+	a_put32(&p, 0x08001013); a_put32(&p, 4); a_put32(&p, 8192);
+	a_put32(&p, 0x08001014); a_put32(&p, 4); a_put32(&p, 2);    /* processing domain: ADSP */
+	p = a_param(pb, APM_PORT, 0x08001002, 4 + 12 + nm * 8);
+	a_put32(&p, 1);
+	a_put32(&p, sg); a_put32(&p, cont); a_put32(&p, nm);
+	for (unsigned i = 0; i < all; i++) {
+		if (a_mods[i].sg == sg) {
+			a_put32(&p, a_mods[i].mid); a_put32(&p, a_mods[i].iid);
 		}
 	}
-	/* module properties: their ports */
 	p = a_param(pb, APM_PORT, 0x08001003, 4 + nm * 24);
 	a_put32(&p, nm);
-	for (unsigned i = 0; i < nm; i++) {
-		a_put32(&p, mods[i].iid); a_put32(&p, 1);
-		a_put32(&p, 0x08001015); a_put32(&p, 8); a_put32(&p, mods[i].ip); a_put32(&p, mods[i].op);
+	for (unsigned i = 0; i < all; i++) {
+		if (a_mods[i].sg == sg) {
+			a_put32(&p, a_mods[i].iid); a_put32(&p, 1);
+			a_put32(&p, 0x08001015); a_put32(&p, 8); a_put32(&p, a_mods[i].ip); a_put32(&p, a_mods[i].op);
+		}
+	}
+	p = a_param(pb, APM_PORT, 0x08001004, 4 + nc * 16);
+	a_put32(&p, nc);
+	for (unsigned i = 0; i + 1 < all; i++) {
+		if (a_mods[i].sg == sg && a_mods[i + 1].sg == sg) {
+			a_put32(&p, a_mods[i].iid); a_put32(&p, 1); a_put32(&p, a_mods[i + 1].iid); a_put32(&p, 2);
+		}
 	}
-	/* connections: output port 1 -> input port 2, down the chain */
-	p = a_param(pb, APM_PORT, 0x08001004, 4 + (nm - 1) * 16);
-	a_put32(&p, nm - 1);
-	for (unsigned i = 0; i + 1 < nm; i++) {
-		a_put32(&p, mods[i].iid); a_put32(&p, 1); a_put32(&p, mods[i + 1].iid); a_put32(&p, 2);
+	for (unsigned i = 0; link_from != 0 && i < all; i++) {
+		if (a_mods[i].sg == sg) {
+			a_put32(&p, link_from); a_put32(&p, 1); a_put32(&p, a_mods[i].iid); a_put32(&p, 2);
+			break;
+		}
 	}
-	LOG("adsp: graph open: %u bytes of parameters (containers %x/%x)", pb->n, cap_str, cap_dev);
 	r = a_cmd_sync(GPR_PORT_APM_CLIENT, APM_PORT, APM_CMD_GRAPH_OPEN, pb->b, pb->n, 0);
+	LOG("adsp: graph open of subgraph %x (%u modules, %u connections, container %x, %u bytes) -> %lld", sg, nm, nc,
+	    cap, pb->n + 40, r);
 	IOFree(pb, sizeof(*pb));
 	return r;
 }
@@ -8654,12 +8670,24 @@ static int64_t
 a_graph_mgmt(uint32_t opcode)
 {
 	struct a_pb pb = {};
-	uint8_t *p = a_param(&pb, APM_PORT, 0x08001005, 8);   /* APM_PARAM_ID_SUB_GRAPH_LIST */
-	a_put32(&p, 1);
+	uint8_t *p = a_param(&pb, APM_PORT, 0x08001005, 12);   /* APM_PARAM_ID_SUB_GRAPH_LIST */
+	a_put32(&p, 2);
 	a_put32(&p, A_SG);
+	a_put32(&p, A_SG_DEV);
 	return a_cmd_sync(GPR_PORT_APM_CLIENT, APM_PORT, opcode, pb.b, pb.n, 0);
 }
 
+static int64_t
+a_graph_open(uint32_t cap_str, uint32_t cap_dev)
+{
+	/* the stream's subgraph, then the device's (the template's direction for it: TX) with the link into it */
+	int64_t r = a_graph_open_part(A_SG, 2, A_CONT_STR, cap_str, 0);
+	if (r != 0) {
+		return r;
+	}
+	return a_graph_open_part(A_SG_DEV, 1, A_CONT_DEV, cap_dev, A_PCMCNV);
+}
+
 static int64_t
 a_formats(void)
 {
@@ -8913,7 +8941,8 @@ adsp_thread(void *arg __unused, wait_result_t wr __unused)
 				}
 			}
 			a_service();
-			if (a_spf_ready && audio_on >= 2 && !tested) {
+			/* after the USB log is up (it starts ~40 s into the boot), so that all of it is seen */
+			if (a_spf_ready && audio_on >= 2 && !tested && a_ms >= 45000) {
 				tested = true;
 				audio_test();
 			}
@@ -8933,7 +8962,16 @@ adsp_thread(void *arg __unused, wait_result_t wr __unused)
 				next_ask = a_ms + 500;
 			}
 		}
-		if (a_ms == 5000 || a_ms == 30000) {
+		if (a_ms == 44000) {
+			for (unsigned k = 0; k < A_NCH; k++) {
+				uint32_t most = 0;
+				for (unsigned i = 0; i < a_ch[k].ri_count; i++) {
+					most = MAX(most, a_ch[k].ri[i].size);
+				}
+				LOG("adsp: \"%s\": the ADSP gave %u receive buffers, the biggest %u bytes", a_ch[k].name, a_ch[k].ri_count, most);
+			}
+		}
+		if (a_ms == 5000 || a_ms == 30000 || a_ms == 44000) {
 			LOG("adsp: t=%u ms: slave-kernel %08x, glink rx %u tx %u, IPCRTR %s, adsp_apps %s, qrtr node %u, %u services, "
 			    "gpr %u packets, SPF %s after %u asks", a_ms, sk_last, a_rx_msgs, a_tx_msgs, a_up(&a_ch[0]) ? "up" : "down",
 			    a_up(&a_ch[1]) ? "up" : "down", a_node, a_srv_count, a_gpr_rx_count, a_spf_ready ? "READY" : "not ready",
