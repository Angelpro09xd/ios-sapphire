index d5c1044..613db57 100644
--- a/iokit/conf/files.arm64
+++ b/iokit/conf/files.arm64
@@ -11,6 +11,7 @@ iokit/Kernel/arm/SweetPlatformExpert.cpp                         optional iokitc
 
 iokit/Kernel/arm/SweetCPU.cpp                                    optional iokitcpp
 iokit/Kernel/arm/TopazModem.cpp                                  optional iokitcpp
+iokit/Kernel/arm/SweetAMFIService.cpp                            optional iokitcpp
 iokit/Kernel/arm/SweetBusy.cpp                                   optional iokitcpp
 iokit/Kernel/arm/SapphireGpu.cpp                                 optional iokitcpp
 iokit/Kernel/arm/SapphireWLAN.cpp                                optional iokitcpp
