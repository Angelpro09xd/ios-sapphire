From 2dcf3a1cd8d6784335361e2b1b834969c2fe39fd Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 19 Oct 2026 08:09:05 +0300
Subject: [PATCH] topaz-0095: black frame on power off

---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index bd72f09..a63884f 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -121,6 +121,8 @@ public:
 	uint64_t      fScanPhys;      /* what VIG0 currently fetches */
 	uint32_t      fScanStride;
 	uint32_t      fBootSrc, fBootStride;
+	IOBufferMemoryDescriptor *fBlack;   /* zeroed contiguous frame shown while off */
+	uint64_t      fBlackPhys;
 	bool          directPresent(const uint8_t *rec);
 	void          scanFrom(uint64_t pa, uint32_t stride);
 	uint32_t      fFlushTicks;    /* vsync ticks between panel copies */
@@ -212,6 +214,16 @@ AppleCLCD::start(IOService *provider)
 		IOLog("SWEET FB: MDP VIG0 src %#x stride %u (boot), direct scanout ready\n",
 		    fBootSrc, fBootStride);
 		sweet_scanout_set_geometry(fWidth, fHeight, fLogicalW, fLogicalH);
+		/* Power off flips the MDP to this black frame at once: fading the
+		 * uncached boot framebuffer with the CPU crawled down the panel. */
+		fBlack = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous,
+		    (vm_size_t)fRowBytes * fHeight, 0x00000000fffff000ull);
+		if (fBlack != NULL) {
+			bzero(fBlack->getBytesNoCopy(), fBlack->getLength());
+			flush_dcache64((addr64_t)(uintptr_t)fBlack->getBytesNoCopy(), (unsigned)fBlack->getLength(), FALSE);
+			fBlackPhys = fBlack->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+		}
 	}
 	uint32_t hz = 10;
 	PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
@@ -246,6 +258,14 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		client->notify(SWEET_FB_NOTIFY_VSYNC, values, 6);
 	}
 	if (fb->fPowerOff) {
+		if (fb->fVig0 != NULL && fb->fBlackPhys != 0) {
+			if (fb->fScanPhys != fb->fBlackPhys) {
+				fb->scanFrom(fb->fBlackPhys, fb->fRowBytes);
+			}
+			IOLockUnlock(fb->fLock);
+			sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+			return;
+		}
 		if (fb->fVig0 != NULL && fb->fScanPhys != fb->fBootSrc) {
 			fb->scanFrom(fb->fBootSrc, fb->fBootStride);
 		}
-- 
