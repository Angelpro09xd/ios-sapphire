From 05361f83b0b7d2826d10c20ae1ec27f0305ae5d7 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Sun, 25 Oct 2026 13:24:58 +0000
Subject: [PATCH] sapphire-0221: restart and power off: PMIC reboot reason
 (bootloader by default, kern.sweet_reboot_mode) + PSCI SYSTEM_RESET, PSCI
 SYSTEM_OFF

---
 bsd/conf/files                           |  1 +
 bsd/dev/sweet_reboot.c                   | 46 +++++++++++++++++++++
 bsd/dev/sweet_spmi.c                     | 52 +++++++++++++++++++++++-
 iokit/Kernel/arm/SweetPlatformExpert.cpp | 37 +++++++++++++++++
 4 files changed, 134 insertions(+), 2 deletions(-)
 create mode 100644 bsd/dev/sweet_reboot.c

diff --git a/bsd/conf/files b/bsd/conf/files
index 85e76c0..5b58196 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -119,6 +119,7 @@ bsd/dev/sweet_spmi.c			standard
 bsd/dev/sweet_audio_ctl.c		standard
 bsd/dev/sweet_audio_dev.c		standard
 bsd/dev/sweet_qmi_dev.c			standard
+bsd/dev/sweet_reboot.c			standard
 bsd/dev/sweet_usb.c			standard
 bsd/dev/mem.c				standard
 bsd/dev/munge.c 			optional config_requires_u32_munging
diff --git a/bsd/dev/sweet_reboot.c b/bsd/dev/sweet_reboot.c
new file mode 100644
index 0000000..503f196
--- /dev/null
+++ b/bsd/dev/sweet_reboot.c
@@ -0,0 +1,46 @@
+/*
+ * sapphire 0221: where a restart goes (SweetPlatformExpert::haltRestart). sysctl
+ * kern.sweet_reboot_mode = 0 system (Android, from the boot partition), 1 recovery, 2 bootloader
+ * (fastboot, the default: iOS is only ever started with fastboot boot); boot-arg sweet_reboot=N
+ * sets the default.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <pexpert/pexpert.h>
+
+static int sweet_reboot_mode = -1;
+int sweet_reboot_mode_get(void);
+
+int
+sweet_reboot_mode_get(void)
+{
+	if (sweet_reboot_mode < 0) {
+		int mode = 2;
+		(void)PE_parse_boot_argn("sweet_reboot", &mode, sizeof(mode));
+		sweet_reboot_mode = (mode >= 0 && mode <= 2) ? mode : 2;
+	}
+	return sweet_reboot_mode;
+}
+
+static int
+sysctl_sweet_reboot_mode SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int mode = sweet_reboot_mode_get();
+	int error = sysctl_io_number(req, mode, sizeof(mode), &mode, NULL);
+	if (error == 0 && req->newptr != USER_ADDR_NULL) {
+		if (mode < 0 || mode > 2) {
+			return EINVAL;
+		}
+		sweet_reboot_mode = mode;
+		printf("SWEET REBOOT: next restart goes to %s\n",
+		    mode == 2 ? "the bootloader" : mode == 1 ? "recovery" : "the system");
+	}
+	return error;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_reboot_mode, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_reboot_mode, "I", "where a restart goes: 0 system, 1 recovery, 2 bootloader");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 1425ccd..b7b26ec 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -1,7 +1,7 @@
 /*
  * Battery-only adaptation of input/sweet_keys.c, observer EXT_READL.
- * PMIC READ ONLY. The only MMIO store issues a one-byte read command.
- * No interrupt clear, peripheral enable, charger config, or PMIC writes.
+ * PMIC reads, plus one write: the reboot reason (sweet_spmi_set_reboot_reason, 0221).
+ * No interrupt clear, peripheral enable or charger config.
  * Init is serialized by the single built-in SweetBattery personality.
  * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
  */
@@ -143,6 +143,54 @@ sweet_spmi_read_any(unsigned sid, unsigned addr, uint8_t *out)
 	return -4;
 }
 
+/*
+ * sapphire 0221: the one PMIC write this file makes, the reboot reason ABL reads. PM6125's PON
+ * at SID 0 0x800, PON_SOFT_RB_SPARE = +0x8f, bits 7:1 = mode (Linux qcom-pon, pm8998 layout,
+ * reason_shift 1; the device tree's mode-bootloader = 2, mode-recovery = 1). Written through the
+ * arbiter's RW channel of that peripheral (chnls 0x1e00000 + 0x10000 * APID), only if the channel
+ * is ours (owner EE 0), then read back through the observer.
+ */
+#define SP_CHNLS_PA     0x01e00000u
+#define PON_SPARE       0x088fu
+int sweet_spmi_set_reboot_reason(unsigned mode);
+int
+sweet_spmi_set_reboot_reason(unsigned mode)
+{
+	if (mode > 0x7f || (!sp_ready && sweet_spmi_init() != 0)) {
+		return -1;
+	}
+	uint8_t old = 0;
+	if (sweet_spmi_read_any(0, PON_SPARE, &old) != 0) {
+		return -2;
+	}
+	lck_mtx_lock(&sweet_spmi_mtx);
+	uint16_t apid = sp_find_apid(PON_SPARE >> 8);
+	if (apid == SP_NO_APID || (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		lck_mtx_unlock(&sweet_spmi_mtx);
+		printf("SWEET REBOOT: PON channel APID %u is not ours\n", apid);
+		return -3;
+	}
+	vm_offset_t ch = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000);
+	if (ch == 0) {
+		lck_mtx_unlock(&sweet_spmi_mtx);
+		return -4;
+	}
+	uint8_t val = (uint8_t)((old & 1u) | (mode << 1));
+	*(volatile uint32_t *)(ch + 0x10u) = val;                       /* WDATA0 */
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = ((PON_SPARE & 0xffu) << 4); /* EXT_WRITEL (0), BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	uint32_t status = 0;
+	for (unsigned i = 0; i < 1000 && !((status = sp_rd(ch, 0x08u)) & 1u); ++i) {
+		delay(1);
+	}
+	lck_mtx_unlock(&sweet_spmi_mtx);
+	uint8_t now = 0;
+	(void)sweet_spmi_read_any(0, PON_SPARE, &now);
+	printf("SWEET REBOOT: PON spare %#x -> %#x (mode %u, status %#x)\n", old, now, mode, status);
+	return (status & 0x0eu) || !(status & 1u) || now != val ? -5 : 0;
+}
+
 int
 sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 {
diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
index 0631685..ec5795f 100644
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -18,8 +18,45 @@ public:
 	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
 	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
 	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+	int haltRestart(unsigned int type) APPLE_KEXT_OVERRIDE;
 };
 
+/*
+ * sapphire 0221: restart and power off. Nothing set PE_halt_restart, so both did nothing and
+ * XNU panicked after unmounting. Restart writes the reboot reason ABL reads (PMIC PON spare)
+ * and asks PSCI for SYSTEM_RESET; halt is PSCI SYSTEM_OFF. iOS is started with fastboot boot,
+ * so a plain restart would come up in Android: the default is the bootloader (fastboot).
+ * kern.sweet_reboot_mode (or boot-arg sweet_reboot): 0 system, 1 recovery, 2 bootloader.
+ */
+extern "C" int sweet_spmi_set_reboot_reason(unsigned mode);
+extern "C" int sweet_reboot_mode_get(void);
+
+static void
+sweet_psci_call(uint64_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	__asm__ volatile("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	    "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+}
+
+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+	if (type == kPERestartCPU) {
+		int mode = sweet_reboot_mode_get();
+		int rc = sweet_spmi_set_reboot_reason((unsigned)mode);
+		IOLog("SWEET: restart, mode %d (%s), reason write %d\n", mode,
+		    mode == 2 ? "bootloader" : mode == 1 ? "recovery" : "system", rc);
+		IODelay(20000);
+		sweet_psci_call(0x84000009ULL);         /* PSCI SYSTEM_RESET */
+	} else if (type == kPEHaltCPU || type == kPEUPSDelayHaltCPU) {
+		IOLog("SWEET: power off\n");
+		IODelay(20000);
+		sweet_psci_call(0x84000008ULL);         /* PSCI SYSTEM_OFF */
+	}
+	return IODTPlatformExpert::haltRestart(type);
+}
+
 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
 
 bool
