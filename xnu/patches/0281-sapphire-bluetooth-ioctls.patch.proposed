+static int
+qcabt_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	int r = 0;
+	lck_mtx_lock(&sweet_bt_mtx);
+	switch (cmd) {
+	case QCABT_POWER:
+		btlog("ioctl POWER %d", *(int *)data);
+		if (*(int *)data) {
+			r = bt_up ? 0 : bt_init();
+		} else {
+			r = bt_off();
+		}
+		break;
+	case QCABT_SETBAUD:
+		r = bt_up ? bt_set_baud(*(uint32_t *)data) : ENXIO;
+		break;
+	case QCABT_FLOW:
+		if (bt_up) {
+			bt_flow(*(int *)data != 0, 0x80000001u);    /* off: RTS held asserted (manual RFR, ready) */
+		} else {
+			r = ENXIO;
+		}
+		break;
+	case QCABT_FLUSH:
+		if (bt_up) {
+			(void)bt_rx_poll();
+		}
+		lck_mtx_lock(&sweet_bt_rxmtx);
+		bt_rtail = bt_rhead;
+		lck_mtx_unlock(&sweet_bt_rxmtx);
+		break;
+	case QCABT_SWCTRL:
+		if (bt_map()) {
+			*(int *)data = (int)(((volatile uint32_t *)bt_sw)[1] & 1);
+		} else {
+			r = ENOMEM;
+		}
+		break;
+	case QCABT_DRAIN:
+		r = bt_up ? bt_drain(1000) : ENXIO;
+		break;
+	default:
+		r = ENOTTY;
+		break;
+	}
+	if (r != 0 && cmd != (u_long)QCABT_POWER) {
+		btlog("ioctl %#lx: %d", cmd, r);
+	}
+	lck_mtx_unlock(&sweet_bt_mtx);
+	return r;
+}
+
+static int
+qcabt_select(__unused dev_t dev, int which, void *wql, struct proc *p)
+{
+	if (which == FWRITE) {
+		return 1;
+	}
+	if (which != FREAD) {
+		return 0;
+	}
+	lck_mtx_lock(&sweet_bt_rxmtx);
+	int ready = bt_rhead != bt_rtail || !bt_rx_alive;
+	if (!ready) {
+		selrecord(p, &bt_sel, wql);
+	}
+	lck_mtx_unlock(&sweet_bt_rxmtx);
+	return ready;
+}
