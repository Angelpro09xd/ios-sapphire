+/*
+ * bluetoothd's start gate: it checks that /dev/uart.bluetooth exists (the transport is btshim's).
+ * These nodes only exist: open answers ENXIO.
+ */
+static int
+btstub_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return ENXIO;
+}
+
+static const struct cdevsw btstub_cdevsw = {
+	.d_open = btstub_open, .d_close = eno_opcl, .d_read = eno_rdwrt, .d_write = eno_rdwrt, .d_ioctl = eno_ioctl,
+	.d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL, .d_select = eno_select, .d_mmap = eno_mmap,
+	.d_strategy = eno_strat, .d_type = 0,
+};
+
+/* at boot (bsd/dev/sweet_ufs.c): device nodes only, no hardware; boot-arg bt=0 skips it */
+void sweet_bt_boot_init(void);
+void
+sweet_bt_boot_init(void)
+{
+	int on = 1;
+	(void)PE_parse_boot_argn("bt", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	lck_mtx_lock(&sweet_bt_mtx);
+	qcabt_node();
+	int major = cdevsw_add(-1, &btstub_cdevsw);
+	if (major >= 0) {
+		void *a = devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "uart.bluetooth");
+		void *b = devfs_make_node(makedev(major, 1), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "cu.bluetooth");
+		btlog("boot: /dev/uart.bluetooth %s, /dev/cu.bluetooth %s (stubs, major %d)", a ? "made" : "FAILED",
+		    b ? "made" : "FAILED", major);
+	} else {
+		btlog("boot: no major for the uart.bluetooth stubs");
+	}
+	lck_mtx_unlock(&sweet_bt_mtx);
+}
