+/* TX FIFO empty and no TX command running, then one character time; bounded by ms */
+static int
+bt_drain(unsigned ms)
+{
+	for (unsigned i = 0; i < ms * 10; i++) {
+		if ((rd(bt_se, GENI_STATUS) & M_CMD_ACTIVE) == 0 && (rd(bt_se, TX_FIFO_STATUS) & 0x0fffffffu) == 0) {
+			uint32_t baud = bt_baud_now ? bt_baud_now : 115200;
+			IODelay(10 * 1000000u / baud + 10);
+			return 0;
+		}
+		if ((i & 3) == 0) {
+			(void)bt_rx_poll();
+		}
+		IODelay(100);
+	}
+	btlog("drain: TX still busy after %u ms (status %#x, tx fifo %#x)", ms, rd(bt_se, GENI_STATUS), rd(bt_se, TX_FIFO_STATUS));
+	return ETIMEDOUT;
+}
