+/* mi,mdss-dsi-hbm-on-command (lp mode on Android; sent high speed here) */
+static const uint8_t hbm_on[] = {
+	0x39, 0x00, 0x00, 0x40, 0x00, 0x00, 0x02, 0x53, 0xe8, 0x39, 0x00, 0x00, 0x40, 0x00, 0x00, 0x03,
+	0x51, 0x07, 0xff, 0x39, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0xf7, 0x0b,
+};
+/* mi,mdss-dsi-hbm-off-command */
+static const uint8_t hbm_off[] = {
+	0x39, 0x00, 0x00, 0x40, 0x00, 0x00, 0x02, 0x53, 0x28, 0x39, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03,
+	0x51, 0x07, 0xff,
+};
+
+extern "C" int sweet_fb_dsi_seq(const uint8_t *seq, uint32_t len, const char *what);   /* SweetFramebuffer.cpp */
+
+static int
+panel_seq(int which)
+{
+	static const struct { const uint8_t *seq; uint32_t len; const char *what; } t[] = {
+		{ lhbm_on, sizeof(lhbm_on), "local HBM on (1000-nit white)" },
+		{ lhbm_off, sizeof(lhbm_off), "local HBM off" },
+		{ hbm_on, sizeof(hbm_on), "global HBM on" },
+		{ hbm_off, sizeof(hbm_off), "global HBM off" },
+	};
+	int f = sweet_fb_dsi_seq(t[which].seq, t[which].len, t[which].what);
+	LOG("panel: %s: %s (%d)", t[which].what, f == 0 ? "sent" : f == -1 ? "no DSI path" : f == -2 ? "panel off" : "NOT all done", f);
+	return f == 0 ? 0 : f == -2 ? EAGAIN : EIO;
+}
+
+/* ops 15 / 20 with arg bit 8: the spot lit before, off after (onBeforeAuthCapture's 3 frames) */
+static bool
+spot_on(uint32_t arg)
+{
+	if ((arg & 0x100) == 0) {
+		return false;
+	}
+	(void)panel_seq(0);
+	IOSleep(50);
+	return true;
+}
+
+static void
+spot_off(bool on)
+{
+	if (on) {
+		(void)panel_seq(1);
+	}
+}
