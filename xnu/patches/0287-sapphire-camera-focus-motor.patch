From: Angelpro09xd <167892325+Angelpro09xd@users.noreply.github.com>
Subject: [PATCH] sapphire-0287: camera: the main lens's focus motor (GT9764)

Every photo and the preview were out of focus: the main camera's voice-coil focus driver was never
powered, so the lens sat at its rest position. Its 2.8 V (VAF, TLMM GPIO101) now comes up with slot 0
and goes down with everything else. kern.sweet_cam_af moves the lens (10-bit DAC 0..1023); the
GT9764 is set up the way CamX's gt9764 data does it (0x02 = 0x02, 0x06 = 0x40, 0x07 = 0x60) at the
first move after power-up. The CCI read/write take 8-bit register addresses for it, and
kern.sweet_cam_i2c accepts m 10/11 for them.
---
 bsd/dev/sweet_cam.c | 123 +++++++++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 112 insertions(+), 11 deletions(-)

diff --git a/bsd/dev/sweet_cam.c b/bsd/dev/sweet_cam.c
index cc5cda3..c4a6933 100755
--- a/bsd/dev/sweet_cam.c
+++ b/bsd/dev/sweet_cam.c
@@ -20,6 +20,10 @@
  *     0278: op 10 slots 1 (OV16A1Q, CSIPHY2), 2 (S5K4H7, CSIPHY1) and 3 (SC202PCS, CSIPHY1 one lane);
  *     op 11 restarts the sensor's stream after the receiver is set up.
  *     0279: every mapping made once at op 1 (counted in each op's last line).
+ *     0287: the main lens's focus motor (GT9764 VCM driver, master 0 7-bit 0x0C, 8-bit registers):
+ *     VAF (TLMM GPIO101) on with slot 0, kern.sweet_cam_af = lens position 0..1023 (written: moves
+ *     the lens, the driver set up at the first move after power-up; read: the last position, -1
+ *     none); kern.sweet_cam_i2c takes m 10/11 for 8-bit register addresses.
  *     kern.sweet_cam_seek + kern.sweet_cam_frame: the frame in
  *     1 MB reads, kern.sweet_cam_frame_len its size.
  *   kern.sweet_cam_log: the log of the last request (also in the kernel log, "SWEET CAM:").
@@ -90,6 +94,10 @@ static const unsigned mclk_pin[4] = { 20, 21, 27, 28 };
 static const unsigned reset_pin[4] = { 18, 24, 19, 68 };
 #define GPIO_MAIN_VANA  26
 #define GPIO_MAIN_VDIG  85
+#define GPIO_MAIN_VAF   101     /* 0287: the actuator's 2.8 V (DT cam_vaf for slot 0) */
+#define AF_ADDR         0x0C    /* GT9764, 8-bit 0x18 on master 0 */
+static int af_pos = -1;         /* last lens position written, -1: none since power-up */
+static bool af_ready;           /* the GT9764 set up since power-up */
 
 /* PMIC GPIOs: PM6125 GPIO2 (SID 0, 0xC100) = front/UW/macro AVDD, PM7250B GPIO3 (SID 2, 0xC200) = DVDD */
 #define AVDD_SID        0
@@ -464,7 +472,7 @@ cci_run(unsigned m, unsigned q, uint32_t donebit, const char *what)
 
 /* n bytes from a 16-bit register of the 7-bit address addr on master m (queue 1) */
 static bool
-cci_read(unsigned m, unsigned addr, unsigned reg, uint8_t *buf, unsigned n)
+cci_read_w(unsigned m, unsigned addr, unsigned reg, unsigned regw, uint8_t *buf, unsigned n)
 {
 	unsigned q = 1;
 	if (n == 0 || n > 16) {
@@ -472,7 +480,11 @@ cci_read(unsigned m, unsigned addr, unsigned reg, uint8_t *buf, unsigned n)
 	}
 	wr(cci, CCI_Q(m, q) + 0x10, 0x1u | (addr & 0x7f) << 4 | 3u << 16);              /* SET_PARAM, 3 retries */
 	wr(cci, CCI_Q(m, q) + 0x10, 0x6u);                                               /* LOCK */
-	wr(cci, CCI_Q(m, q) + 0x10, 0xBu | 2u << 4 | ((reg >> 8) & 0xff) << 8 | (reg & 0xff) << 16);   /* WRITE_DISABLE_P */
+	if (regw == 1) {
+		wr(cci, CCI_Q(m, q) + 0x10, 0xBu | 1u << 4 | (reg & 0xff) << 8);         /* WRITE_DISABLE_P, 8-bit register */
+	} else {
+		wr(cci, CCI_Q(m, q) + 0x10, 0xBu | 2u << 4 | ((reg >> 8) & 0xff) << 8 | (reg & 0xff) << 16);   /* WRITE_DISABLE_P */
+	}
 	wr(cci, CCI_Q(m, q) + 0x10, 0xAu | n << 4);                                      /* READ */
 	wr(cci, CCI_Q(m, q) + 0x10, 0x7u);                                               /* UNLOCK */
 	if (!cci_run(m, q, m == 0 ? 1u << 0 : 1u << 12, "read")) {
@@ -499,19 +511,30 @@ cci_read(unsigned m, unsigned addr, unsigned reg, uint8_t *buf, unsigned n)
 	return true;
 }
 
+static bool
+cci_read(unsigned m, unsigned addr, unsigned reg, uint8_t *buf, unsigned n)
+{
+	return cci_read_w(m, addr, reg, 2, buf, n);
+}
+
 /* n (1..2) bytes to a 16-bit register (queue 0) */
 static bool
-cci_write(unsigned m, unsigned addr, unsigned reg, uint32_t val, unsigned n)
+cci_write_w(unsigned m, unsigned addr, unsigned reg, unsigned regw, uint32_t val, unsigned n)
 {
 	unsigned q = 0;
 	uint8_t b[4] = { (uint8_t)(reg >> 8), (uint8_t)reg, 0, 0 };
+	unsigned o = 2;
+	if (regw == 1) {
+		b[0] = (uint8_t)reg;
+		o = 1;
+	}
 	if (n == 1) {
-		b[2] = (uint8_t)val;
+		b[o] = (uint8_t)val;
 	} else {
-		b[2] = (uint8_t)(val >> 8);
-		b[3] = (uint8_t)val;
+		b[o] = (uint8_t)(val >> 8);
+		b[o + 1] = (uint8_t)val;
 	}
-	unsigned len = 2 + n;
+	unsigned len = o + n;
 	wr(cci, CCI_Q(m, q) + 0x10, 0x1u | (addr & 0x7f) << 4 | 3u << 16);
 	wr(cci, CCI_Q(m, q) + 0x10, 0x6u);                                               /* LOCK */
 	wr(cci, CCI_Q(m, q) + 0x10, 0x9u | len << 4 | (uint32_t)b[0] << 8 | (uint32_t)b[1] << 16 | (uint32_t)b[2] << 24);
@@ -523,6 +546,12 @@ cci_write(unsigned m, unsigned addr, unsigned reg, uint32_t val, unsigned n)
 	return cci_run(m, q, m == 0 ? 1u << 4 : 1u << 16, "write");
 }
 
+static bool
+cci_write(unsigned m, unsigned addr, unsigned reg, uint32_t val, unsigned n)
+{
+	return cci_write_w(m, addr, reg, 2, val, n);
+}
+
 /* ---------------------------------------------------------------- the requests */
 
 static bool
@@ -664,6 +693,9 @@ slot_on(unsigned slot)
 		ok = ok && pin_out(GPIO_VIO, 1); IOSleep(1);
 		ok = ok && pin_out(GPIO_MAIN_VANA, 1); IOSleep(1);
 		ok = ok && pin_out(GPIO_MAIN_VDIG, 1); IOSleep(1);
+		ok = ok && pin_out(GPIO_MAIN_VAF, 1); IOSleep(1);   /* 0287 */
+		af_ready = false;
+		af_pos = -1;
 		ok = ok && pin_out(rst, 1); IOSleep(5);
 		ok = ok && mclk_on(0); IOSleep(25);
 		break;
@@ -718,6 +750,9 @@ cam_off(void)
 		(void)pin_out(reset_pin[s], 0);
 	}
 	(void)pin_out(GPIO_CSI_MUX, 0);
+	(void)pin_out(GPIO_MAIN_VAF, 0);
+	af_ready = false;
+	af_pos = -1;
 	(void)pin_out(GPIO_MAIN_VDIG, 0);
 	(void)pin_out(GPIO_MAIN_VANA, 0);
 	(void)dvdd(0);
@@ -2167,7 +2202,7 @@ static bool
 cam_premap(void)
 {
 	static bool done;
-	static const unsigned pins[] = { 18, 19, 20, 21, 22, 23, 24, 26, 27, 28, 29, 30, 34, 54, 68, 85, 83 };
+	static const unsigned pins[] = { 18, 19, 20, 21, 22, 23, 24, 26, 27, 28, 29, 30, 34, 54, 68, 85, 83, 101 };
 	if (done) {
 		return true;
 	}
@@ -2317,6 +2352,67 @@ hexnum(const char **p, bool *ok)
 	return v;
 }
 
+/*
+ * 0287: the main lens. GT9764 (CamX gt9764 data of both HM6 modules): 0x02 = 0x02 (out of power-down,
+ * ring control on), 0x06 = 0x40 (SAC mode), 0x07 = 0x60 (SAC timing); the position is a 10-bit DAC
+ * at 0x03 (bits 9:8) and 0x04 (bits 7:0). 0 = the lens farthest from the sensor's macro end.
+ */
+static int
+af_move(int pos)
+{
+	if (!camss_up || !slot_up[0]) {
+		camlog("af: the main camera is off");
+		return EAGAIN;
+	}
+	if (!af_ready) {
+		bool ok = cci_write_w(0, AF_ADDR, 0x02, 1, 0x02, 1);
+		IOSleep(1);
+		ok = ok && cci_write_w(0, AF_ADDR, 0x06, 1, 0x40, 1);
+		ok = ok && cci_write_w(0, AF_ADDR, 0x07, 1, 0x60, 1);
+		uint8_t id[2] = { 0, 0 };
+		(void)cci_read_w(0, AF_ADDR, 0x00, 1, id, 1);
+		camlog("af: GT9764 setup %s (reg 0x00 = %#x)", ok ? "ok" : "FAILED", id[0]);
+		if (!ok) {
+			return EIO;
+		}
+		af_ready = true;
+	}
+	bool ok = cci_write_w(0, AF_ADDR, 0x03, 1, (uint32_t)(pos >> 8) & 3, 1) &&
+	    cci_write_w(0, AF_ADDR, 0x04, 1, (uint32_t)pos & 0xff, 1);
+	if (!ok) {
+		camlog("af: position %d FAILED", pos);
+		af_ready = false;
+		return EIO;
+	}
+	af_pos = pos;
+	return 0;
+}
+
+static int
+sysctl_sweet_cam_af SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = af_pos;
+	int err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	if (v < 0 || v > 1023) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_cam_mtx);
+	if (!af_ready) {
+		cam_log_len = 0;
+		cam_log[0] = 0;
+	}
+	int r = af_move(v);
+	lck_mtx_unlock(&sweet_cam_mtx);
+	return r;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_af, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_cam_af, "I", "main lens position 0..1023 (GT9764); -1: not set since power-up");
+
 static int
 sysctl_sweet_cam_i2c SYSCTL_HANDLER_ARGS
 {
@@ -2329,7 +2425,12 @@ sysctl_sweet_cam_i2c SYSCTL_HANDLER_ARGS
 	const char *p = buf;
 	bool o1, o2, o3, o4;
 	unsigned m = hexnum(&p, &o1), addr = hexnum(&p, &o2), reg = hexnum(&p, &o3), val = hexnum(&p, &o4);
-	if (!o1 || !o2 || !o3 || m > 1 || addr > 0x7f || reg > 0xffff) {
+	unsigned regw = 2;
+	if (m == 0x10 || m == 0x11) {   /* 0287: 8-bit register address */
+		m &= 1;
+		regw = 1;
+	}
+	if (!o1 || !o2 || !o3 || m > 1 || addr > 0x7f || reg > (regw == 1 ? 0xffu : 0xffffu)) {
 		return EINVAL;
 	}
 	lck_mtx_lock(&sweet_cam_mtx);
@@ -2340,12 +2441,12 @@ sysctl_sweet_cam_i2c SYSCTL_HANDLER_ARGS
 		camlog("i2c: camss is off (op 1 first)");
 		r = EAGAIN;
 	} else if (o4) {
-		bool ok = cci_write(m, addr, reg, val, val > 0xff ? 2 : 1);
+		bool ok = cci_write_w(m, addr, reg, regw, val, val > 0xff ? 2 : 1);
 		camlog("i2c: m%u %#x reg %#06x <- %#x: %s", m, addr, reg, val, ok ? "ok" : "FAILED");
 		r = ok ? 0 : EIO;
 	} else {
 		uint8_t b[2];
-		bool ok = cci_read(m, addr, reg, b, 2);
+		bool ok = cci_read_w(m, addr, reg, regw, b, 2);
 		camlog("i2c: m%u %#x reg %#06x = %02x %02x%s", m, addr, reg, ok ? b[0] : 0, ok ? b[1] : 0, ok ? "" : " (FAILED)");
 		r = ok ? 0 : EIO;
 	}
