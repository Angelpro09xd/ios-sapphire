diff --git a/iokit/Kernel/arm/SweetKeyStore.cpp b/iokit/Kernel/arm/SweetKeyStore.cpp
index 482c0bd..43960bd 100755
--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -165,6 +165,7 @@ static_assert(sizeof(struct sweet_aks_bag) == 104, "bag blob size");
 static const uint8_t sweet_aks_check_key[] = "SWEET AKS system bag v1";
 
 static IOLock *sweet_aks_lock;          /* the fields of sa; never held across anything that blocks */
+static volatile uint32_t sweet_aks_pass_ok;     /* 0261: good passcodes so far */
 static AppleKeyStore *sweet_aks_service;
 static thread_call_t sweet_aks_grace_call;
 static uint32_t sweet_aks_grace_secs;
@@ -482,6 +483,7 @@ sweet_aks_check(const uint8_t *pass, size_t len, uint32_t *post)
 	if (match) {
 		sa.failed = 0;
 		sa.backoff_until = 0;
+		sweet_aks_pass_ok++;            /* 0261: ends a fingerprint lockout */
 	} else {
 		failed = ++sa.failed;
 		sweet_aks_arm_backoff_locked();
@@ -1168,4 +1170,58 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 	    post != 0 ? ", now " : "", post != 0 ? sweet_aks_state_name(mkb) : "");
 	return ret;
 }
+/*
+ * 0261: unlock by fingerprint (SweetQsee.cpp kern.sweet_qsee op 27). Only when a passcode is set,
+ * the device has been unlocked with it since boot, it is locked now, and SweetQsee matched an
+ * enrolled finger less than 3 s ago (the match is used up). Then exactly what a good passcode
+ * does: unlocked, failures and back-off cleared, the same interest messages.
+ * 0 ok, EPERM conditions not met, EAGAIN no recent match.
+ */
+extern "C" bool sweet_qsee_last_match(uint64_t *age_ms, uint32_t *fid, bool consume);   /* SweetQsee.cpp */
+
+extern "C" uint32_t
+sweet_aks_passcode_unlocks(void)
+{
+	return sweet_aks_pass_ok;
+}
+
+extern "C" int
+sweet_aks_biometric_unlock(void)
+{
+	uint32_t post = 0, fid = 0;
+	uint64_t age = 0;
+	const char *why = NULL;
+
+	if (sweet_aks_lock == NULL) {
+		IOLog("SWEET AKS: fingerprint unlock: no key store\n");
+		return EPERM;
+	}
+	IOLockLock(sweet_aks_lock);
+	if (!sa.has_pass) {
+		why = "no passcode set";
+	} else if (!sa.been_unlocked) {
+		why = "not unlocked with the passcode since boot";
+	} else if (!sa.locked) {
+		why = "not locked";
+	}
+	if (why == NULL && !sweet_qsee_last_match(&age, &fid, false)) {
+		IOLockUnlock(sweet_aks_lock);
+		IOLog("SWEET AKS: fingerprint unlock: no fingerprint match in the last 3 s\n");
+		return EAGAIN;
+	}
+	if (why == NULL) {
+		(void)sweet_qsee_last_match(&age, &fid, true);
+		sa.failed = 0;
+		sa.backoff_until = 0;
+		sweet_aks_unlock_locked(&post);
+	}
+	IOLockUnlock(sweet_aks_lock);
+	if (why != NULL) {
+		IOLog("SWEET AKS: fingerprint unlock refused: %s\n", why);
+		return EPERM;
+	}
+	sweet_aks_post(post);
+	IOLog("SWEET AKS: unlocked by fingerprint (finger %u, matched %llu ms ago)\n", fid, age);
+	return 0;
+}
 #endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetQsee.cpp b/iokit/Kernel/arm/SweetQsee.cpp
index 56d1c43..f62e211 100755
--- a/iokit/Kernel/arm/SweetQsee.cpp
+++ b/iokit/Kernel/arm/SweetQsee.cpp
@@ -56,6 +56,10 @@
  * (1000-nit white circle), 23 local HBM off (back to normal), 24 global HBM on, 25 global HBM off,
  * through SweetFramebuffer's DSI command path; kern.sweet_qsee_arg bit 8 (0x100) makes ops 15
  * and 20 light the spot first (3 frames), and turn it off at the end.
+ * 0261: op 26 = lit auth while the finger is on the spot (kern.sweet_fod_press, sweet_touch.c):
+ * until a match, the finger lifted (> 150 ms) or 3 s; at most 5 failed attempts until the next
+ * good passcode. op 27 = unlock by the last match (< 3 s old) through SweetKeyStore. Both log one
+ * summary line per attempt (quiet: no per-command lines).
  * A listener request from TrustZone (INCOMPLETE / BLOCKED_ON_LISTENER) is logged and answered
