 bsd/dev/sweet_touch.c                 |  42 +++++++++++
 iokit/Kernel/arm/SweetFramebuffer.cpp |  10 ++-
 iokit/Kernel/arm/SweetKeyStore.cpp    |  56 ++++++++++++++
 iokit/Kernel/arm/SweetQsee.cpp        | 134 +++++++++++++++++++++++++++++++++-
 5 files changed, 237 insertions(+), 9 deletions(-)

