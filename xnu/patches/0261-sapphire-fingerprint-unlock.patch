-#define LOG(fmt, ...)       IOLog("qsee: " fmt "\n", ##__VA_ARGS__)
+static bool q_quiet;                            /* 0261: ops 26/27: only their summary lines */
+#define LOG(fmt, ...)       do { if (!q_quiet) IOLog("qsee: " fmt "\n", ##__VA_ARGS__); } while (0)
+#define LOGA(fmt, ...)      IOLog("qsee: " fmt "\n", ##__VA_ARGS__)
 
 #define QSEE_POOL_PA        0xE8000000ull
 #define QSEE_POOL_SIZE      0x01000000ull
@@ -2153,7 +2159,7 @@ static const uint8_t hbm_off[] = {
 	0x51, 0x07, 0xff,
 };
 
-extern "C" int sweet_fb_dsi_seq(const uint8_t *seq, uint32_t len, const char *what);   /* SweetFramebuffer.cpp */
+extern "C" int sweet_fb_dsi_seq(const uint8_t *seq, uint32_t len, const char *what, int quiet);   /* SweetFramebuffer.cpp */
 
 static int
 panel_seq(int which)
@@ -2164,7 +2170,7 @@ panel_seq(int which)
 		{ hbm_on, sizeof(hbm_on), "global HBM on" },
