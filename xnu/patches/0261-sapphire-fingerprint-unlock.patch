  *   18 untrusted auth with retries, 19 enumerate + authenticator id, 20 = 18 with kern.sweet_qsee_arg,
- *   22/23 local HBM on/off, 24/25 global HBM on/off.
+ *   22/23 local HBM on/off, 24/25 global HBM on/off, 26 auth while pressed, 27 unlock by the match.
  * Reading it gives the result of the last request (0 ok, else an errno).
  *
  * Memory: TrustZone reads what it is given by physical address, below 4 GB, physically
@@ -101,7 +105,9 @@ extern "C" const char *topaz_fw_phone(void);
 extern "C" int topaz_rpm_ldo(uint32_t id, uint32_t uv, uint32_t ma, uint32_t set);
