 	return n;
 }
 
+/* ---------------------------------------------------------------- 0261: fingerprint unlock */
+
+extern "C" int sweet_fod_press;                 /* bsd/dev/sweet_touch.c, kern.sweet_fod_press */
+extern "C" uint32_t sweet_aks_passcode_unlocks(void);   /* SweetKeyStore.cpp */
+extern "C" int sweet_aks_biometric_unlock(void);
+
+static volatile uint64_t q_match_abs;           /* mach_absolute_time of the last match (0: none) */
+static volatile uint32_t q_match_fid;
+static uint32_t q_fod_fails, q_fod_epoch;
+
+/* for SweetKeyStore: the last match if under 3 s old; consume: used up. No lock (op 27 holds q_lock). */
+extern "C" bool
+sweet_qsee_last_match(uint64_t *age_ms, uint32_t *fid, bool consume)
+{
+	uint64_t t = q_match_abs;
+	if (t == 0) {
+		return false;
+	}
+	uint64_t age = ms_since(t);
+	if (age >= 3000) {
+		return false;
+	}
+	*age_ms = age;
+	*fid = q_match_fid;
+	if (consume) {
+		q_match_abs = 0;
+	}
+	return true;
+}
+
+/*
+ * op 26: the spot lit (local HBM), then op 20's auth (type 1, UNTRUSTED_CFG 0, exposure 1, retries
+ * per SENSOR_INIT) again and again until a match, the finger off the spot for over 150 ms, or 3 s;
+ * the spot off on every exit. *value: the finger id (its 32 bits) on a match, -1008 no match,
+ * -EINTR the finger lifted first, else -error.
+ */
+static int
+fp_fod_auth(int *value)
+{
+	if (!q_inited || q_goodix_id == 0) {
+		LOGA("op 26: run op 10 first");
+		return EAGAIN;
+	}
+	uint32_t epoch = sweet_aks_passcode_unlocks();
+	if (epoch != q_fod_epoch) {
+		q_fod_epoch = epoch;
+		q_fod_fails = 0;
+	}
+	if (q_fod_fails >= 5) {
+		LOGA("op 26: %u failed fingerprint attempts: passcode required", q_fod_fails);
+		return EPERM;
+	}
+	const uint64_t t0 = mach_absolute_time();
+	unsigned tries = 0;
+	int v = -1008;
+	q_quiet = true;
+	(void)panel_seq(0);
+	IOSleep(50);
+	for (;;) {
+		int r1 = 0;
+		v = -1008;
+		int rr = fp_auth_retry(&r1, 0);
+		tries++;
+		if (rr != 0) {
+			v = -(rr > 0 ? rr : EIO);
+			break;
+		}
+		v = r1;
+		if (v != 0 && (v > 0 || v < -5000)) {
+			break;                              /* a finger id */
+		}
+		if (v == 0) {
+			v = -1008;
+		}
+		/* the finger still there? (lifted for over 150 ms: stop) */
+		unsigned off_ms = 0;
+		while (!sweet_fod_press && off_ms <= 150) {
+			IOSleep(10);
+			off_ms += 10;
+		}
+		if (!sweet_fod_press) {
+			v = -EINTR;
+			break;
+		}
+		if (ms_since(t0) >= 3000) {
+			break;
+		}
+	}
+	(void)panel_seq(1);
+	q_quiet = false;
+	bool match = v > 0 || v < -5000;
+	if (match) {
+		q_match_fid = (uint32_t)v;
+		q_match_abs = mach_absolute_time();
+		q_fod_fails = 0;
+	} else if (v == -1008 || v == -1011) {
+		q_fod_fails++;
+	}
+	*value = v;
+	LOGA("op 26: %s after %u tries, %llu ms (value %d, finger %u, %u failed attempts)", match ? "MATCH" :
+	    v == -EINTR ? "finger lifted" : v == -1008 ? "no match" : "error", tries, ms_since(t0), v,
+	    match ? (uint32_t)v : 0, q_fod_fails);
+	return 0;
+}
+
+/* op 27: unlock by the last match (SweetKeyStore decides) */
+static int
+fp_bio_unlock(void)
+{
+	int r = sweet_aks_biometric_unlock();
+	LOGA("op 27: fingerprint unlock: %s", r == 0 ? "UNLOCKED" : r == EAGAIN ? "no recent match" : "refused (see SWEET AKS)");
+	return r;
+}
+
 /* op 12: AUTH_CANCEL, sensor off */
 static int
 fp_stop(void)
@@ -2608,6 +2728,12 @@ sweet_qsee_op(int op)
 	case 25:
 		r = panel_seq(op - 22);
 		break;
+	case 26:
+		r = fp_fod_auth(&value);
+		break;
+	case 27:
+		r = fp_bio_unlock();
+		break;
 	case 12:
 		r = fp_stop();
 		break;
