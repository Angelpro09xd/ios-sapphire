diff --git a/bsd/sys/sapphire_net.h b/bsd/sys/sapphire_net.h
new file mode 100644
index 0000000..3021d77
--- /dev/null
+++ b/bsd/sys/sapphire_net.h
@@ -0,0 +1,68 @@
+/*
+ * Ported from HackiOS (OOSEX GANG, github.com/oosexgang/hackios-xnu-kernel @8e61187098f2, bsd/sys/redwood_net.h;
+ * Apple Public Source License 2.0, as the rest of XNU) for sapphire: renamed, and fed by the
+ * WCN3988 station of TopazModem.cpp through bsd/dev/sapphire_wlan.c instead of ath11k.
+ */
+/*
+ * en0, and what stands behind it.
+ *
+ * The network interface iOS uses here is made in bsd/dev/sapphire_net.c with the kernel's own
+ * interface KPI: Ethernet as far as the rest of the kernel and user space can tell. What carries
+ * the frames is a "link", a driver of its own that knows nothing about interfaces: QEMU's virtio
+ * network device today (bsd/dev/sapphire_virtio_net.c), the phone's radio or frames carried over
+ * the boot loader's USB channel tomorrow. This is all the two know of each other.
+ *
+ * A link driver
+ *   - fills in a struct sapphire_net_link and calls sapphire_net_attach() once, when it is ready
+ *     to carry frames (for a radio: when its firmware is up, not when it has joined a network);
+ *   - hands every frame that arrives to sapphire_net_input(): from its own thread, or from
+ *     the poll function the interface's thread calls for it. Not from interrupt context;
+ *   - says with sapphire_net_link_state() when frames can pass and when they no longer can
+ *     (the cable, or for a radio: associated and the keys set). configd starts DHCP on that.
+ * A frame is what goes over an Ethernet cable without the checksum at its end: destination,
+ * source, type, payload; at most SAPPHIRE_NET_FRAME_MAX bytes. A radio whose frames are 802.11
+ * converts in its driver (or has its firmware do it: "Ethernet decap/encap").
+ */
+#ifndef _SYS_SAPPHIRE_NET_H_
+#define _SYS_SAPPHIRE_NET_H_
+
+#ifdef KERNEL
+#include <sys/kpi_mbuf.h>
+
+#define SAPPHIRE_NET_FRAME_MAX   1514
+
+struct sapphire_net_link {
+	const char *    name;           /* for the log */
+	uint8_t         address[6];     /* the interface's Ethernet address */
+	bool            wireless;       /* the interface is told to be Wi-Fi (its "subfamily"), which is how the
+	                                 * network stack and configd tell a radio from a cable */
+	bool            up;             /* frames can pass from the start (else: wait for sapphire_net_link_state()) */
+	/*
+	 * Send one frame: a chain of mbufs, `length` bytes in all, the Ethernet header first. The
+	 * packet stays the caller's: copy it (mbuf_copydata()). Returns false if it had to be dropped.
+	 * Called by one thread at a time, never from interrupt context.
+	 */
+	bool            (*transmit)(mbuf_t packet, size_t length);
+	/*
+	 * Optional. Look whether frames have arrived and call sapphire_net_input() for each; returns
+	 * how many there were. The interface's thread calls it every 2 ms while frames are coming and
+	 * every 10 ms when none has for a while. A link that has a thread or an interrupt of its own
+	 * leaves it NULL.
+	 */
+	unsigned        (*poll)(void);
+};
+
+/* Make en0 on top of that link (the structure must stay). One link, once: false if there is one already. */
+bool sapphire_net_attach(const struct sapphire_net_link *link);
+/* A frame has arrived. Copied; the buffer is the caller's again on return. */
+void sapphire_net_input(const uint8_t *frame, size_t length);
+/* Frames can pass now / can no longer pass. */
+void sapphire_net_link_state(bool up);
+
+void sapphire_net_init(void);            /* the links there are: each looks for its hardware (or its boot-arg) */
+/* an Apple80211 request (SIOCGA80211, SIOCSA80211) for the interface of a radio: sapphire_apple80211.c */
+errno_t sapphire_apple80211_ioctl(u_long command, void *data);
+void sapphire_wlan_init(void);           /* bsd/dev/sapphire_wlan.c: boot-arg wifi=1, the WCN3988 station */
+#endif /* KERNEL */
+
+#endif /* _SYS_SAPPHIRE_NET_H_ */
diff --git a/bsd/sys/sapphire_sta.h b/bsd/sys/sapphire_sta.h
new file mode 100644
index 0000000..79841ff
--- /dev/null
+++ b/bsd/sys/sapphire_sta.h
@@ -0,0 +1,130 @@
+/*
+ * Ported from HackiOS (OOSEX GANG, github.com/oosexgang/hackios-xnu-kernel @8e61187098f2, bsd/sys/redwood_sta.h;
+ * Apple Public Source License 2.0, as the rest of XNU) for sapphire: renamed, and fed by the
+ * WCN3988 station of TopazModem.cpp through bsd/dev/sapphire_wlan.c instead of ath11k.
+ */
+/*
+ * Darwin on sapphire: the station boundary.
+ *
+ * On one side whatever does the scanning and the joining with a radio: the station logic over
+ * ath11k on the phone (wifi/lx in the repository). On the other whoever wants a network: the
+ * Apple80211 requests of iOS's Wi-Fi side, answered in bsd/dev/sapphire_apple80211.c, and the
+ * kernel's own join of the network it was given in a file (bsd/dev/sapphire_wifi.c). Frames do
+ * not pass here, and neither does "the link is up": those go through bsd/sys/sapphire_net.h,
+ * which the station side calls itself.
+ *
+ * Between the two stands bsd/dev/sapphire_sta.c: one thread, on which every call into the station
+ * side is made, one at a time, and what the last scan heard, kept for whoever asks.
+ *
+ * Nothing but C's own types here: the station side is not compiled as XNU's code.
+ */
+#ifndef _SYS_SAPPHIRE_STA_H_
+#define _SYS_SAPPHIRE_STA_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define SAPPHIRE_STA_ELEMENTS_MOST       1024
+
+/* One access point, as a scan heard it. */
+struct sapphire_sta_bss {
+	uint8_t bssid[6];
+	uint8_t ssid[32], ssid_length;
+	uint16_t frequency;                     /* MHz */
+	int16_t rssi;                           /* dBm */
+	uint16_t beacon_interval;               /* in units of 1024 microseconds */
+	uint16_t capability;                    /* the beacon's capability field */
+	uint32_t age_ms;                        /* how long ago it was last heard */
+	uint16_t elements_length;               /* the beacon's information elements as received: who asks */
+	uint8_t elements[SAPPHIRE_STA_ELEMENTS_MOST];    /* reads the network's protection out of them itself */
+};
+
+/* What to scan for. All zero: every channel, the radio's own way. */
+struct sapphire_sta_scan {
+	uint8_t ssid[32], ssid_length;          /* ask for this network by name (a hidden one answers only then) */
+	uint16_t frequencies[64], frequency_count;      /* only these channels */
+	bool passive;                           /* only listen */
+	uint16_t dwell_ms;                      /* on each channel; 0: the radio's own */
+};
+
+enum { SAPPHIRE_STA_OPEN, SAPPHIRE_STA_WPA2_PSK };
+
+struct sapphire_sta_join {
+	uint8_t ssid[32], ssid_length;
+	uint8_t bssid[6];                       /* all zero: the access point of that name heard best */
+	int security;
+	uint8_t pmk[32];                        /* WPA2 with a passphrase: the key made of the passphrase and the name ... */
+	uint8_t passphrase[64], passphrase_length;      /* ... or, if this is not empty, the passphrase itself */
+};
+
+enum sapphire_sta_phase { SAPPHIRE_STA_OFF, SAPPHIRE_STA_IDLE, SAPPHIRE_STA_SCANNING, SAPPHIRE_STA_JOINING, SAPPHIRE_STA_JOINED };
+
+struct sapphire_sta_state {
+	enum sapphire_sta_phase phase;
+	struct sapphire_sta_bss bss;             /* the network joined or being joined */
+	int last_error;                         /* why the last join failed or the network was lost (an errno); 0: it was not */
+};
+
+#define SAPPHIRE_STA_CHANNEL_PASSIVE     1u      /* the radio may only listen there */
+#define SAPPHIRE_STA_CHANNEL_RADAR       2u      /* ... and has to look out for radar */
+
+struct sapphire_sta_channel {
+	uint16_t frequency;                     /* MHz */
+	uint16_t flags;
+};
+
+/*
+ * What the station side supplies. All but state() are called on one thread, one at a time, and
+ * may take as long as the thing takes: scan() returns when the scan is over, join() when frames
+ * can pass or it is known why not. Each gives 0 or an errno.
+ */
+struct sapphire_sta_ops {
+	int (*power)(bool on);                  /* off: leave the network, stop the radio; on: start it */
+	int (*scan)(const struct sapphire_sta_scan *what);
+	void (*heard)(void (*each)(const struct sapphire_sta_bss *bss, void *context), void *context);   /* by the last scan */
+	int (*join)(const struct sapphire_sta_join *what);
+	int (*leave)(void);
+	void (*state)(struct sapphire_sta_state *state);         /* on any thread; does not sleep */
+	unsigned (*channels)(struct sapphire_sta_channel *channels, unsigned most);      /* what the radio may tune to */
+	uint8_t address[6];
+};
+
+/* What happens, said to whoever listens (the Apple80211 side). */
+enum sapphire_sta_event {
+	SAPPHIRE_STA_POWER,                      /* status: 1 on, 0 off */
+	SAPPHIRE_STA_SCAN_DONE,                  /* status: 0, or the scan's errno */
+	SAPPHIRE_STA_JOIN_DONE,                  /* status: 0, or the join's errno */
+	SAPPHIRE_STA_LINK,                       /* status: 1 a network is joined, 0 it has been left when asked,
+	                                         * an errno: it was lost (the access point showed us the door) */
+};
+
+#ifdef KERNEL
+/* a line for the log that is always said (HackiOS: sys/redwood_input.h) */
+#define sapphire_wifi_tell printf
+
+/* ---- the station side ---- */
+void     sapphire_sta_attach(const struct sapphire_sta_ops *ops);         /* NULL: it is going away (waits for a call under way) */
+void     sapphire_sta_lost(int error);                                   /* the network joined is gone by itself */
+
+/* ---- who wants a network: each asks and returns; the outcome is an event. 0, or an errno ---- */
+bool     sapphire_sta_present(void);
+int      sapphire_sta_ask_power(bool on);
+int      sapphire_sta_ask_scan(const struct sapphire_sta_scan *what);
+int      sapphire_sta_ask_join(const struct sapphire_sta_join *what);
+/* ... and joined again whenever the radio is turned on, until some other network is asked for */
+int      sapphire_sta_ask_join_standing(const struct sapphire_sta_join *what);
+int      sapphire_sta_ask_leave(void);
+bool     sapphire_sta_busy(void);                                        /* something asked for is not over yet */
+bool     sapphire_sta_powered(void);
+/* the `index`th access point the last scan heard: true, or false when there are not that many */
+bool     sapphire_sta_heard(unsigned index, struct sapphire_sta_bss *bss);
+void     sapphire_sta_state(struct sapphire_sta_state *state);
+unsigned sapphire_sta_channels(struct sapphire_sta_channel *channels, unsigned most);
+bool     sapphire_sta_address(uint8_t *address);
+
+/* ---- the listener: bsd/dev/sapphire_apple80211.c ---- */
+void     sapphire_apple80211_event(enum sapphire_sta_event event, int status);
+void     sapphire_apple80211_summary(void);                              /* what was asked in this run, to the log */
+#endif
+
+#endif
diff --git a/iokit/Kernel/arm/SapphireWLAN.cpp b/iokit/Kernel/arm/SapphireWLAN.cpp
new file mode 100644
index 0000000..430fdfa
--- /dev/null
+++ b/iokit/Kernel/arm/SapphireWLAN.cpp
@@ -0,0 +1,142 @@
+/*
+ * Ported from HackiOS (OOSEX GANG, github.com/oosexgang/hackios-xnu-kernel @8e61187098f2, iokit/Kernel/RedwoodWLAN.cpp;
+ * Apple Public Source License 2.0, as the rest of XNU) for sapphire: renamed, and fed by the
+ * WCN3988 station of TopazModem.cpp through bsd/dev/sapphire_wlan.c instead of ath11k.
+ */
+/*
+ * SapphireWLAN: the registry entries by which iOS finds the Wi-Fi interface.
+ *
+ * en0 is made with the BSD interface KPI (bsd/dev/sapphire_net.c) and has no IOKit object behind
+ * it of its own; iOS looks for two, as IO80211Family would have made them:
+ *
+ *   - wifid's device is whatever service has the property IO80211InterfaceRole =
+ *     "Infrastructure", and IO80211.framework binds to an interface through a service whose
+ *     IOInterfaceName is the interface's name. The service has no user client, on purpose:
+ *     the framework's attempt to open one fails, it says "Falling back to IOCTL path", and
+ *     from then on every request is an ioctl on a socket, which bsd/dev/sapphire_apple80211.c
+ *     answers.
+ *   - SystemConfiguration (SCNetworkInterfaceCopyAll) lists the network interfaces it finds as
+ *     objects of the class IONetworkInterface, and calls one a Wi-Fi interface when its parent
+ *     is of the class IO80211Controller; type, unit, name and built-in-ness are properties of
+ *     the interface, the hardware address one of the controller. configd makes a network
+ *     service (DHCP and the rest) for an interface it has listed, and only an interface with a
+ *     service can be the one the system routes through -- which wifid waits for after a join
+ *     ("failed to become routable interface") before Settings ticks the network.
+ *
+ * So: a controller of the class IO80211Controller under the platform, and below it one object
+ * that is both, an IONetworkInterface with wifid's properties. Both classes are ours, named as
+ * IO80211Family and IONetworkingFamily name theirs; neither has anything but properties.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+
+extern "C" void SapphireWLANStart(const char * interface, const uint8_t * address);
+
+class IO80211Controller : public IOService
+{
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+
+OSDefineMetaClassAndStructors(IO80211Controller, IOService);
+
+class IONetworkInterface : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class SapphireWLAN : public IONetworkInterface
+{
+	OSDeclareDefaultStructors(SapphireWLAN);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+	    IOUserClient ** handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SapphireWLAN, IONetworkInterface);
+
+/* There is none (see the top); that somebody asked shows that the service was found. */
+IOReturn
+SapphireWLAN::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties, IOUserClient ** handler)
+{
+	static unsigned said;
+
+	if (said++ < 8) {
+		IOLog("SapphireWLAN: a user client of type %u is asked for: there is none\n", (unsigned) type);
+	}
+	return kIOReturnUnsupported;
+}
+
+/* attach, start, register: the service, or NULL */
+static IOService *
+publish(IOService * service, IOService * provider, const char * name)
+{
+	if (service == NULL || !service->attach(provider)) {
+		OSSafeReleaseNULL(service);
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+/* Once, when the interface of a radio exists. */
+void
+SapphireWLANStart(const char * interface, const uint8_t * address)
+{
+	IOService * platform = IOService::getPlatform();
+	IO80211Controller * controller = OSTypeAlloc(IO80211Controller);
+	SapphireWLAN * wlan = OSTypeAlloc(SapphireWLAN);
+	OSData * mac;
+	OSNumber * number;
+
+	if (platform == NULL || controller == NULL || wlan == NULL || !controller->init() || !wlan->init()) {
+		OSSafeReleaseNULL(controller);
+		OSSafeReleaseNULL(wlan);
+		IOLog("SapphireWLAN: cannot create the services\n");
+		return;
+	}
+	if ((mac = OSData::withBytes(address, 6)) != NULL) {
+		controller->setProperty("IOMACAddress", mac);
+		mac->release();
+	}
+	controller->setProperty("IOBuiltin", true);
+	if ((controller = (IO80211Controller *) publish(controller, platform, "SapphireWLANController")) == NULL) {
+		wlan->release();
+		IOLog("SapphireWLAN: the controller did not start\n");
+		return;
+	}
+
+	wlan->setProperty("IOInterfaceName", interface);
+	wlan->setProperty("BSD Name", interface);
+	wlan->setProperty("IOInterfaceNamePrefix", "en");
+	if ((number = OSNumber::withNumber(6ULL, 32)) != NULL) {        /* IFT_ETHER */
+		wlan->setProperty("IOInterfaceType", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber((unsigned long long) (interface[2] - '0'), 32)) != NULL) {
+		wlan->setProperty("IOInterfaceUnit", number);
+		number->release();
+	}
+	wlan->setProperty("IOBuiltin", true);
+	wlan->setProperty("IOPrimaryInterface", true);
+	wlan->setProperty("IO80211InterfaceRole", "Infrastructure");
+	if (publish(wlan, controller, "SapphireWLAN") == NULL) {
+		IOLog("SapphireWLAN: the service did not start\n");
+	} else {
+		wlan->release();
+	}
+	controller->release();
+}
