diff --git a/bsd/dev/sweet_vibrate.c b/bsd/dev/sweet_vibrate.c
new file mode 100755
index 0000000..6e46e20
--- /dev/null
+++ b/bsd/dev/sweet_vibrate.c
@@ -0,0 +1,211 @@
+/*
+ * sapphire 0263: the vibration motor. PM7250B LDO vibrator (dtbo 045 fragment 15,
+ * qcom,qpnp-vibrator-ldo): SPMI SID 3, peripheral 0x5300; VSET 0x5340/0x5341 in mV (3000 mV =
+ * 0x0bb8, qcom,vib-ldo-volt-uv), EN_CTL 0x5346 bit 7, STATUS1 0x5308 bit 7 VREG_READY
+ * (leds-qpnp-vibrator-ldo.c). Overdrive is disabled on this board: just on and off.
+ *   kern.sweet_vibrate = N: on for N ms (cap 2000), 0 stops; a new write replaces the running one.
+ *   kern.sweet_vibrate_pattern = "on,off,on,..." (ms, up to 10 steps, each capped at 2000):
+ *     iOS-like patterns; an empty string stops.
+ * The motor is turned off by a thread call; a generation number keeps a stale one from acting.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/thread_call.h>
+#include <libkern/OSAtomic.h>
+#include "sweet_spmi.h"
+
+extern void IODelay(unsigned microseconds);
+int sweet_spmi_read_any(unsigned sid, unsigned addr, uint8_t *out);
+
+#define VIB_SID         3
+#define VIB_STATUS1     0x5308
+#define VIB_VSET_LB     0x5340
+#define VIB_VSET_UB     0x5341
+#define VIB_EN_CTL      0x5346
+#define VIB_MAX_MS      2000
+#define VIB_STEPS       10
+
+static LCK_GRP_DECLARE(sweet_vib_grp, "sweet_vibrate");
+static LCK_MTX_DECLARE(sweet_vib_mtx, &sweet_vib_grp);
+static thread_call_t vib_call;
+static uint64_t vib_gen;
+static bool vib_vset_done, vib_logged, vib_on;
+static int vib_ms;
+static char vib_pattern[96];
+static uint32_t vib_steps[VIB_STEPS], vib_nsteps, vib_step;
+
+/* the motor on or off; sweet_vib_mtx held */
+static int
+vib_set(bool on)
+{
+	int r = 0;
+	if (on && !vib_vset_done) {
+		r = sweet_spmi_write(VIB_SID, VIB_VSET_LB, 0xb8);
+		if (r == 0) {
+			r = sweet_spmi_write(VIB_SID, VIB_VSET_UB, 0x0b);
+		}
+		if (r != 0) {
+			printf("SWEET VIB: setting 3000 mV failed: %d\n", r);
+			return r;
+		}
+		vib_vset_done = true;
+	}
+	uint8_t en = 0;
+	if (sweet_spmi_read_any(VIB_SID, VIB_EN_CTL, &en) != 0) {
+		printf("SWEET VIB: EN_CTL not readable\n");
+		return -1;
+	}
+	r = sweet_spmi_write(VIB_SID, VIB_EN_CTL, on ? (en | 0x80) : (en & 0x7f));
+	if (r == 0 && on) {
+		uint8_t st = 0;
+		for (int i = 0; i < 20; i++) {          /* VREG_READY, bounded (the driver polls ~100 us steps) */
+			if (sweet_spmi_read_any(VIB_SID, VIB_STATUS1, &st) == 0 && (st & 0x80)) {
+				break;
+			}
+			IODelay(100);
+		}
+		if (!vib_logged) {
+			uint8_t lb = 0, ub = 0, en2 = 0;
+			(void)sweet_spmi_read_any(VIB_SID, VIB_VSET_LB, &lb);
+			(void)sweet_spmi_read_any(VIB_SID, VIB_VSET_UB, &ub);
+			(void)sweet_spmi_read_any(VIB_SID, VIB_EN_CTL, &en2);
+			printf("SWEET VIB: first vibration: vset %u mV, en_ctl %#x -> %#x, status1 %#x (ready %u)\n",
+			    lb | (unsigned)ub << 8, en, en2, st, st >> 7);
+			vib_logged = true;
+		}
+	}
+	if (r != 0) {
+		printf("SWEET VIB: motor %s: SPMI write failed %d\n", on ? "on" : "off", r);
+	}
+	vib_on = on && r == 0;
+	return r;
+}
+
+static void
+vib_arm(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	thread_call_enter1_delayed(vib_call, (thread_call_param_t)(uintptr_t)vib_gen, deadline);
+}
+
+/* the end of a step: off, or the next pattern step */
+static void
+vib_fire(thread_call_param_t p0 __unused, thread_call_param_t p1)
+{
+	lck_mtx_lock(&sweet_vib_mtx);
+	if ((uint64_t)(uintptr_t)p1 == vib_gen) {
+		if (vib_nsteps != 0 && vib_step + 1 < vib_nsteps) {
+			vib_step++;
+			bool on = (vib_step & 1) == 0;
+			(void)vib_set(on);
+			vib_arm(vib_steps[vib_step]);
+		} else {
+			(void)vib_set(false);
+			vib_nsteps = 0;
+		}
+	}
+	lck_mtx_unlock(&sweet_vib_mtx);
+}
+
+/* a new request: the running one (if any) ends; steps[0] on, steps[1] off, ... */
+static int
+vib_start(const uint32_t *steps, uint32_t n)
+{
+	int r = 0;
+	if (sweet_spmi_init() != 0) {
+		return ENODEV;
+	}
+	if (vib_call == NULL) {
+		thread_call_t c = thread_call_allocate(vib_fire, NULL);
+		if (c == NULL) {
+			return ENOMEM;
+		}
+		if (!OSCompareAndSwapPtr(NULL, c, (void * volatile *)&vib_call)) {
+			thread_call_free(c);
+		}
+	}
+	lck_mtx_lock(&sweet_vib_mtx);
+	vib_gen++;
+	(void)thread_call_cancel(vib_call);
+	vib_nsteps = 0;
+	if (n == 0 || steps[0] == 0) {
+		if (vib_on || n == 0) {
+			r = vib_set(false);
+		}
+	} else {
+		memcpy(vib_steps, steps, n * sizeof(steps[0]));
+		vib_nsteps = n;
+		vib_step = 0;
+		r = vib_set(true);
+		if (r == 0) {
+			vib_arm(steps[0]);
+		} else {
+			vib_nsteps = 0;
+		}
+	}
+	lck_mtx_unlock(&sweet_vib_mtx);
+	return r == 0 ? 0 : EIO;
+}
+
+static int
+sysctl_sweet_vibrate SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int ms = vib_ms;
+	int err = sysctl_io_number(req, ms, sizeof(ms), &ms, NULL);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	ms = ms < 0 ? 0 : ms > VIB_MAX_MS ? VIB_MAX_MS : ms;
+	vib_ms = ms;
+	uint32_t s = (uint32_t)ms;
+	return vib_start(&s, ms == 0 ? 0 : 1);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_vibrate, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_vibrate, "I", "vibrate for N ms (max 2000), 0 stops");
+
+static int
+sysctl_sweet_vibrate_pattern SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[sizeof(vib_pattern)];
+	strlcpy(buf, vib_pattern, sizeof(buf));
+	int err = sysctl_handle_string(oidp, buf, sizeof(buf), req);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	uint32_t steps[VIB_STEPS], n = 0;
+	const char *p = buf;
+	while (*p != 0 && n < VIB_STEPS) {
+		uint32_t v = 0;
+		bool digits = false;
+		while (*p >= '0' && *p <= '9') {
+			v = v * 10 + (uint32_t)(*p - '0');
+			v = v > VIB_MAX_MS ? VIB_MAX_MS : v;
+			digits = true;
+			p++;
+		}
+		if (!digits) {
+			return EINVAL;
+		}
+		steps[n++] = v;
+		if (*p == ',') {
+			p++;
+		} else if (*p != 0) {
+			return EINVAL;
+		}
+	}
+	strlcpy(vib_pattern, buf, sizeof(vib_pattern));
+	return vib_start(steps, n);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_vibrate_pattern, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_vibrate_pattern, "A", "vibration pattern: on,off,on,... ms (max 10 steps)");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
