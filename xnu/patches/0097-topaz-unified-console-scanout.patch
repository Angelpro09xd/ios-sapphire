From f27dd6cbae997eef96a1673c38c8bf7f6afa6b53 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 19 Oct 2026 08:31:42 +0300
Subject: [PATCH] topaz-0097: console on a cached shadow frame scanned by the
 MDP

---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 36 +++++++++-
 osfmk/console/video_console.c         | 97 +++++++++++++++++++++++++++
 2 files changed, 132 insertions(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 79fd421..3861a97 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -37,6 +37,11 @@
 #include "SweetSurface.h"
 
 extern "C" int sweet_console_muted;     /* osfmk/console/serial_console.c */
+extern "C" void sweet_console_retarget(vm_offset_t va);   /* osfmk/console/video_console.c */
+extern "C" void (*sweet_console_show_hook)(void);
+class AppleCLCD;
+static AppleCLCD *sweet_cons_fb;
+static void sweet_cons_show(void);
 extern "C" void flush_dcache64(addr64_t addr, unsigned count, int phys);  /* osfmk/arm/caches.c */
 extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 
@@ -130,6 +135,8 @@ public:
 	/* topaz fade: cached copy of the last frame and a contiguous output frame */
 	IOBufferMemoryDescriptor *fFadeOrig, *fFadeOut;
 	uint64_t      fFadeOutPhys;
+	IOBufferMemoryDescriptor *fCons;    /* console shadow frame (cached, contiguous) */
+	uint64_t      fConsPhys;
 	const uint8_t *fLastVA;       /* last directly scanned frame (panel window) */
 	uint32_t      fLastStride;
 	SweetSurface *fLastSurf;      /* keeps fLastVA alive */
@@ -221,6 +228,21 @@ AppleCLCD::start(IOService *provider)
 		    fBootSrc, fBootStride);
 		sweet_scanout_set_geometry(fWidth, fHeight, fLogicalW, fLogicalH);
 		vm_size_t fsz = (vm_size_t)fRowBytes * fHeight;
+		fCons = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous, fsz, 0x00000000fffff000ull);
+		if (fCons != NULL && fBootStride == fRowBytes) {
+			uint8_t *c = (uint8_t *)fCons->getBytesNoCopy();
+			memcpy(c, (const void *)fPixels, fsz);  /* keep what the console drew */
+			flush_dcache64((addr64_t)(uintptr_t)c, (unsigned)fsz, FALSE);
+			fConsPhys = fCons->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+			sweet_cons_fb = this;
+			sweet_console_show_hook = sweet_cons_show;
+			scanFrom(fConsPhys, fRowBytes);
+			sweet_console_retarget((vm_offset_t)c);
+			IOLog("SWEET FB: console on shadow frame %#llx\n", fConsPhys);
+		} else {
+			OSSafeReleaseNULL(fCons);
+		}
 		fFadeOrig = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut, fsz, page_size);
 		fFadeOut = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
 		    kIODirectionInOut | kIOMemoryPhysicallyContiguous, fsz, 0x00000000fffff000ull);
@@ -273,7 +295,9 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 			if (step <= SWEET_FB_FADE_STEPS) {
 				fb->fFadeStep = step + 1;
 			}
-			const uint8_t *src = fb->fLastVA ? fb->fLastVA : (const uint8_t *)fb->fPixels;
+			const uint8_t *src = fb->fLastVA ? fb->fLastVA :
+			    (fb->fConsPhys != 0 && fb->fScanPhys == fb->fConsPhys) ?
+			    (const uint8_t *)fb->fCons->getBytesNoCopy() : (const uint8_t *)fb->fPixels;
 			uint32_t srcStride = fb->fLastVA ? fb->fLastStride : fb->fRowBytes;
 			IOLockUnlock(fb->fLock);
 			if (step <= SWEET_FB_FADE_STEPS) {
@@ -380,6 +404,16 @@ AppleCLCD::scanFrom(uint64_t pa, uint32_t stride)
 	fScanStride = stride;
 }
 
+/* panic: show the console frame (MMIO only, no locks) */
+static void
+sweet_cons_show(void)
+{
+	AppleCLCD *fb = sweet_cons_fb;
+	if (fb != NULL && fb->fVig0 != NULL && fb->fScanPhys != fb->fConsPhys) {
+		fb->scanFrom(fb->fConsPhys, fb->fRowBytes);
+	}
+}
+
 void
 AppleCLCD::fadeStep(const uint8_t *src, uint32_t srcStride, uint32_t step)
 {
diff --git a/osfmk/console/video_console.c b/osfmk/console/video_console.c
index 84092bd..1dc46bf 100644
--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -140,6 +140,24 @@ static struct {
 	void (*update_color)(int color, boolean_t fore);
 } gc_ops;
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * topaz: one display path. Once AppleCLCD is up the console draws into a
+ * cached, physically contiguous shadow frame that the MDP scans out, like
+ * iOS surfaces; each drawn text row is cleaned to memory right away, so text
+ * appears at cache speed and stays visible in a panic.
+ */
+extern void flush_dcache64(addr64_t addr, unsigned count, int phys);
+void sweet_console_retarget(vm_offset_t va);
+void (*sweet_console_show_hook)(void);
+static vm_offset_t sweet_shadow_va;
+static void (*sweet_orig_paint)(unsigned int, unsigned int, unsigned char, int, unsigned char, int);
+static void (*sweet_orig_clear)(unsigned int, unsigned int, unsigned int, unsigned int, int);
+static void (*sweet_orig_sdown)(int, unsigned int, unsigned int);
+static void (*sweet_orig_sup)(int, unsigned int, unsigned int);
+static void (*sweet_orig_cursor)(unsigned int, unsigned int);
+#endif
+
 static unsigned char *gc_buffer_attributes;
 static unsigned char *gc_buffer_characters;
 static unsigned char *gc_buffer_colorcodes;
@@ -2925,6 +2943,9 @@ initialize_screen(PE_Video * boot_vinfo, unsigned int op)
 			gc_ops.hide_cursor  = vc_reverse_cursor;
 			gc_ops.show_cursor  = vc_reverse_cursor;
 			gc_ops.update_color = vc_update_color;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+			sweet_shadow_va = 0;    /* re-initialised on the boot framebuffer */
+#endif
 			gc_initialize(&vinfo);
 		}
 	}
@@ -3300,3 +3321,79 @@ vc_set_progressmeter(int new_value)
 }
 
 #endif /* defined(XNU_TARGET_OS_OSX) */
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+static void
+sweet_flush_rows(unsigned int top, unsigned int bottom)
+{
+	if (vinfo.v_rows == 0 || bottom <= top) {
+		return;
+	}
+	uint64_t band = (uint64_t)(vinfo.v_height / vinfo.v_rows) * vinfo.v_rowbytes;
+	if (bottom > vinfo.v_rows) {
+		bottom = vinfo.v_rows;
+	}
+	flush_dcache64((addr64_t)(vinfo.v_baseaddr + top * band), (unsigned)((bottom - top) * band), FALSE);
+	if (panic_active() && sweet_console_show_hook != NULL) {
+		sweet_console_show_hook();
+	}
+}
+
+static void
+sweet_paint(unsigned int xx, unsigned int yy, unsigned char ch, int attrs, unsigned char chp, int attrsp)
+{
+	sweet_orig_paint(xx, yy, ch, attrs, chp, attrsp);
+	sweet_flush_rows(yy, yy + 1);
+}
+
+static void
+sweet_clear(unsigned int xx, unsigned int yy, unsigned int top, unsigned int bottom, int which)
+{
+	sweet_orig_clear(xx, yy, top, bottom, which);
+	sweet_flush_rows(0, vinfo.v_rows);
+}
+
+static void
+sweet_sdown(int num, unsigned int top, unsigned int bottom)
+{
+	sweet_orig_sdown(num, top, bottom);
+	sweet_flush_rows(top, bottom);
+}
+
+static void
+sweet_sup(int num, unsigned int top, unsigned int bottom)
+{
+	sweet_orig_sup(num, top, bottom);
+	sweet_flush_rows(top, bottom);
+}
+
+static void
+sweet_cursor(unsigned int xx, unsigned int yy)
+{
+	sweet_orig_cursor(xx, yy);
+	sweet_flush_rows(yy, yy + 1);
+}
+
+/* Point the console at the shadow frame (same geometry as the boot one). */
+void
+sweet_console_retarget(vm_offset_t va)
+{
+	VCPUTC_LOCK_LOCK();
+	if (gc_ops.paint_char != sweet_paint) {
+		sweet_orig_paint = gc_ops.paint_char;
+		sweet_orig_clear = gc_ops.clear_screen;
+		sweet_orig_sdown = gc_ops.scroll_down;
+		sweet_orig_sup = gc_ops.scroll_up;
+		sweet_orig_cursor = gc_ops.show_cursor;
+	}
+	vinfo.v_baseaddr = va;
+	sweet_shadow_va = va;
+	gc_ops.paint_char = sweet_paint;
+	gc_ops.clear_screen = sweet_clear;
+	gc_ops.scroll_down = sweet_sdown;
+	gc_ops.scroll_up = sweet_sup;
+	gc_ops.hide_cursor = sweet_cursor;
+	gc_ops.show_cursor = sweet_cursor;
+	VCPUTC_LOCK_UNLOCK();
+}
+#endif
-- 
2.43.0

