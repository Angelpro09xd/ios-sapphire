From e10f3b847d7db66da9e49ae8327bbcdd938d287a Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 19 Oct 2026 08:21:13 +0300
Subject: [PATCH 96/96] topaz-0095: leave the dim to backboardd

---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index bd72f09..e3c75fd 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -246,8 +246,15 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		client->notify(SWEET_FB_NOTIFY_VSYNC, values, 6);
 	}
 	if (fb->fPowerOff) {
+		/*
+		 * topaz: backboardd animates the dim itself and leaves its last frame
+		 * on the direct scanout; keep showing it. The kernel fade below only
+		 * serves the copy path (it crawled over the uncached boot framebuffer).
+		 */
 		if (fb->fVig0 != NULL && fb->fScanPhys != fb->fBootSrc) {
-			fb->scanFrom(fb->fBootSrc, fb->fBootStride);
+			IOLockUnlock(fb->fLock);
+			sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+			return;
 		}
 		/* Fade out: halve every channel each vsync, then black, then idle. */
 		uint32_t step = fb->fFadeStep;
-- 
