+
+/* q_cmd with the caller's fields; the gf result, or ~0u when the call itself failed */
+static uint32_t
+gf_cmd(uint32_t target, uint32_t cmd, uint32_t len, const char *name)
+{
+	q_cmd[0] = 0;
+	put32(q_cmd, 4, target);
+	put32(q_cmd, 8, cmd);
+	put32(q_cmd, 0x0c, 0);
+	if (!gf_send(q_goodix_id, q_cmd, len, name)) {
+		LOG("%s (%u,%u): the call itself failed", name, target, cmd);
+		return ~0u;
+	}
+	uint32_t r = get32(q_cmd, 0x0c);
+	LOG("%s (%u,%u): gf result %u %s", name, target, cmd, r, gf_err_name(r));
+	return r;
+}
