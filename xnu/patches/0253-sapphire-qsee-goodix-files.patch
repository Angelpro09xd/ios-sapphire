+	q_cmd[0x2bd] = 0;
+	q_cmd[0x2be] = 1;
+	g = gf_cmd(1002, 2, 0x2c0, "SENSOR_INIT");
+	LOG("SENSOR_INIT: chip type %u (+0x238); config +0x20 %08x %08x %08x %08x crc %08x; +0x138 crc %08x; +0x23d crc %08x",
+	    get32(q_cmd, 0x238), get32(q_cmd, 0x20), get32(q_cmd, 0x24), get32(q_cmd, 0x28), get32(q_cmd, 0x2c),
+	    crc32(0, q_cmd + 0x20, 0x118), crc32(0, q_cmd + 0x138, 0x100), crc32(0, q_cmd + 0x23d, 0x2a));
+	if (g != 0) {
+		goto fail;
+	}
+	/* ALGO_INIT: CustomizedAlgo::init */
+	bzero(q_cmd, 0x30);
+	put32(q_cmd, 0x24, 1);
+	g = gf_cmd(1001, 0, 0x30, "ALGO_INIT");
+	LOG("ALGO_INIT: out +0x24 %u, +0x28 %08x%08x", get32(q_cmd, 0x24), get32(q_cmd, 0x2c), get32(q_cmd, 0x28));
+	if (g != 0) {
+		goto fail;
+	}
+	bzero(q_cmd, 0x1c);
+	g = gf_cmd(1000, 13, 0x1c, "AUTH_INIT_FINISHED");
+	if (g != 0) {
+		goto fail;
+	}
+	bzero(q_cmd, 0x120);
+	put32(q_cmd, 0x1c, 0);
+	strlcpy((char *)q_cmd + 0x20, "/data/vendor_de/0/fpdata", 256);
+	g = gf_cmd(1000, 0, 0x120, "SET_ACTIVE_GROUP");
+	if (g != 0) {
+		goto fail;
+	}
+	q_inited = true;
+	LOG("op 10: init done in %llu ms (%u file requests so far; sensor awake, op 11 captures, op 12 stops)", ms_since(t0),
+	    q_fs_reqs);
+	return 0;
+fail:
+	LOG("op 10: stopped at gf %u %s after %llu ms (%u file requests); sensor off", g, g == ~0u ? "(call failed)" :
+	    gf_err_name(g), ms_since(t0), q_fs_reqs);
+	fp_power_off();
+	return EIO;
+}
+
+/* op 11: AUTHENTICATE, CAPTURE_IMG, ALGO_AUTHENTICATE, ALGO_KPI, AUTH_CANCEL (no illumination here) */
+static int
+fp_capture(void)
+{
+	uint32_t ga = ~0u, gc = ~0u, gk = ~0u;
+
+	if (!q_inited || q_goodix_id == 0) {
+		LOG("op 11: run op 10 first");
+		return EAGAIN;
+	}
+	bzero(q_cmd, 0x30);
+	put32(q_cmd, 0x1c, 0);
+	put64(q_cmd, 0x20, 1);
+	uint32_t g = gf_cmd(1000, 1, 0x30, "AUTHENTICATE");
+	if (g == ~0u) {
+		return EIO;
+	}
+	if (g == 0) {
+		bzero(q_cmd, 0x28);
+		put32(q_cmd, 0x1c, 0);                  /* retry index */
+		put32(q_cmd, 0x20, 2);                  /* op: authenticate */
+		gc = gf_cmd(1002, 3, 0x28, "CAPTURE_IMG");
+		if (gc == 0) {
+			bzero(q_cmd, 0xa4);
+			q_cmd[0x9e] = 0;
+			q_cmd[0x9f] = 0;
+			ga = gf_cmd(1001, 2, 0xa4, "ALGO_AUTHENTICATE");
+		}
+		bzero(q_cmd, 0xbc);
+		gk = gf_cmd(1001, 4, 0xbc, "ALGO_KPI");
+		if (gk == 0) {
+			LOG("KPI: quality %u, valid area %u, match score %u, study %u, key points %u, increase rate %u, overlay %u",
+			    get32(q_cmd, 0x1c), get32(q_cmd, 0x20), get32(q_cmd, 0x24), get32(q_cmd, 0x28), get32(q_cmd, 0x2c),
+			    get32(q_cmd, 0x30), get32(q_cmd, 0x34));
+			LOG("KPI: us raw %u, preprocess %u, feature %u, auth %u", get32(q_cmd, 0x38), get32(q_cmd, 0x40),
+			    get32(q_cmd, 0x44), get32(q_cmd, 0x48));
+		}
+	}
+	bzero(q_cmd, 0x1c);
+	(void)gf_cmd(1000, 8, 0x1c, "AUTH_CANCEL");
+	LOG("op 11: authenticate %u %s, capture %u %s, algo %u %s, kpi %u %s", g, gf_err_name(g), gc,
+	    gc == ~0u ? "-" : gf_err_name(gc), ga, ga == ~0u ? "-" : gf_err_name(ga), gk, gk == ~0u ? "-" : gf_err_name(gk));
+	return 0;
+}
+
+/* op 12: AUTH_CANCEL, sensor off */
+static int
+fp_stop(void)
+{
+	if (q_goodix_id != 0 && q_va != NULL) {
+		bzero(q_cmd, 0x1c);
+		(void)gf_cmd(1000, 8, 0x1c, "AUTH_CANCEL");
+	}
+	fp_power_off();
+	q_inited = false;
+	LOG("op 12: stopped (%u file requests served this boot)", q_fs_reqs);
+	return 0;
+}
