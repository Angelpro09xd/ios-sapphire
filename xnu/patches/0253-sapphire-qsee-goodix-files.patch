+/* room for need bytes (exact: what user space gives; else doubling from 64 KB), within the caps */
+static bool
+qf_reserve(int i, uint32_t need, bool exact)
+{
+	struct qfile *f = &q_files[i];
+	if (need <= f->cap) {
+		return true;
+	}
+	if (need > QF_FILE_MAX) {
+		return false;
+	}
+	uint32_t cap = exact ? need : MAX(MAX(need, f->cap * 2), 0x10000u);
+	cap = MIN(cap, QF_FILE_MAX);
+	if (qf_total() - f->cap + cap > QF_TOTAL_MAX) {
+		return false;
 	}
-	if (!enabled) {
+	uint8_t *d = (uint8_t *)IOMalloc(cap);
+	if (d == NULL) {
+		return false;
+	}
+	if (f->data != NULL) {
+		memcpy(d, f->data, f->len);
+		IOFree(f->data, f->cap);
+	}
+	f->data = d;
+	f->cap = cap;
+	return true;
+}
+
+static void
+qf_free(int i)
+{
+	if (q_files[i].data != NULL) {
+		IOFree(q_files[i].data, q_files[i].cap);
+	}
+	bzero(&q_files[i], sizeof(q_files[i]));
+	for (unsigned k = 0; k < QF_NFD; k++) {
+		if (q_fds[k].used && q_fds[k].file == i) {
+			q_fds[k].file = -1;
+		}
+	}
+}
