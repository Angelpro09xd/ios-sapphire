From: Angelpro09xd <167892325+Angelpro09xd@users.noreply.github.com>
Subject: [PATCH] sapphire-0253: Goodix TA file listener, init and one capture (milestone 2)

Listener 10 (the QSEE file service) is registered with its own 20 KB buffer
in the pool and served inside the SCM loop (up to 2000 rounds), one log line
per request. Files come from a kernel RAM store that user space fills through
the new write-only sysctl kern.sweet_qsee_file ("name\0bytes", up to 5 MB
each, 8 files, 12 MB in all; empty bytes drop one) and that
kern.sweet_qsee_files lists. The TA sees them by basename; its writes,
creates, removes and renames change the RAM copy only and are logged: nothing
reaches any disk. Op 10 = the milestone with the listener up, then
SENSOR_INIT (chip type and config checksums logged), ALGO_INIT,
AUTH_INIT_FINISHED, SET_ACTIVE_GROUP 0; op 11 = AUTHENTICATE, CAPTURE_IMG,
ALGO_AUTHENTICATE, ALGO_KPI (quality, area, score...), AUTH_CANCEL; op 12 =
AUTH_CANCEL and sensor off. gf results are named from libgf_hal's whole error
table; long commands dump only their first 64 bytes.
---
 bsd/dev/sweet_qsee_ctl.c       |  53 ++-
 iokit/Kernel/arm/SweetQsee.cpp | 922 ++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 954 insertions(+), 21 deletions(-)

diff --git a/bsd/dev/sweet_qsee_ctl.c b/bsd/dev/sweet_qsee_ctl.c
index 70af9bd..5f1519d 100755
--- a/bsd/dev/sweet_qsee_ctl.c
+++ b/bsd/dev/sweet_qsee_ctl.c
@@ -7,7 +7,10 @@
  *     WAKEUP(reset) + WAKEUP + PRE_DETECT + DETECT_SENSOR), 2 the sensor's GPIOs off,
  *   3 APP_SHUTDOWN goodixfp, 4 goodixfp shutdown + start only, 5 op 1 reusing a loaded goodixfp,
  *   6 op 1 with slow power timings, 7 L9's PMIC registers (read only), 8 register the QSEE log
- *   buffer, 9 copy it for kern.sweet_qsee_log (read only, opaque: the raw 32 KB)
+ *   buffer, 9 copy it for kern.sweet_qsee_log (read only, opaque: the raw 32 KB), 10 init with
+ *   the file listener, 11 one capture, 12 cancel and sensor off
+ * kern.sweet_qsee_file (write only): "name\0bytes" puts a file the TA may read into the kernel's
+ * RAM store (empty bytes drop it); kern.sweet_qsee_files lists the store.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -56,4 +59,52 @@ sysctl_sweet_qsee_log SYSCTL_HANDLER_ARGS
 
 SYSCTL_PROC(_kern, OID_AUTO, sweet_qsee_log, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED,
     0, 0, sysctl_sweet_qsee_log, "S", "the QSEE log buffer copied by kern.sweet_qsee=9 (raw)");
+
+/* 0253: the TA's files, RAM only (iokit/Kernel/arm/SweetQsee.cpp) */
+int sweet_qsee_file_put(const uint8_t *buf, uint32_t len);
+uint32_t sweet_qsee_files_list(char *out, uint32_t max);
+
+static int
+sysctl_sweet_qsee_file SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	size_t len = req->newlen;
+	if (req->newptr == USER_ADDR_NULL) {
+		return 0;
+	}
+	if (len < 2 || len > (5u << 20) + 64) {
+		return len < 2 ? EINVAL : EFBIG;
+	}
+	uint8_t *buf = kalloc_data(len, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	int err = SYSCTL_IN(req, buf, len);
+	if (err == 0) {
+		err = sweet_qsee_file_put(buf, (uint32_t)len);
+	}
+	kfree_data(buf, len);
+	return err;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_qsee_file, CTLTYPE_OPAQUE | CTLFLAG_WR | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_qsee_file, "S", "a file for the goodix TA: write name\\0bytes (RAM only)");
+
+static int
+sysctl_sweet_qsee_files SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	const uint32_t max = 2048;
+	char *buf = kalloc_data(max, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	uint32_t n = sweet_qsee_files_list(buf, max);
+	int err = SYSCTL_OUT(req, buf, n + 1);
+	kfree_data(buf, max);
+	return err;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_qsee_files, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_qsee_files, "A", "the goodix TA's RAM file store: name size dirty source");
 #endif /* ARM64_BOARD_CONFIG_SWEET */
