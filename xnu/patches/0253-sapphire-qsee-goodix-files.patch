+static const char *
+fs_cmd_name(uint32_t c)
+{
+	static const char *const names[] = { "start", "open", "openat", "unlinkat", "fcntl", "creat", "read", "write",
+		                             "close", "lseek", "link", "unlink", "rmdir", "fstat", "lstat", "mkdir", "testdir",
+		                             "telldir", "remove", "chown_chmod", "unused", "sync", "rename", "par_free_size",
+		                             "dir_open", "dir_read", "dir_close", "get_errno" };
+	return c >= 0x201 && c < 0x201 + sizeof(names) / sizeof(names[0]) ? names[c - 0x201] : "?";
+}
+
+static int32_t
+fs_open(const char *name, uint32_t flags, int *e)
+{
+	int i = qf_find(name);
+	if (i < 0) {
+		if ((flags & 0x40) == 0) {             /* O_CREAT */
+			*e = ENOENT;
+			return -1;
+		}
+		i = qf_create(name);
+		if (i < 0) {
+			*e = ENOSPC;
+			return -1;
 		}
+		q_files[i].dirty = true;
+	}
+	if ((flags & 0x200) != 0 && (flags & 3) != 0) {  /* O_TRUNC, for writing */
+		q_files[i].len = 0;
+		q_files[i].dirty = true;
+	}
+	for (unsigned k = 0; k < QF_NFD; k++) {
+		if (!q_fds[k].used) {
+			q_fds[k].used = true;
+			q_fds[k].file = i;
+			q_fds[k].pos = (flags & 0x400) != 0 ? q_files[i].len : 0;   /* O_APPEND */
+			return QF_FD_BASE + (int32_t)k;
+		}
+	}
+	*e = EMFILE;
+	return -1;
+}
+
+static void
+fs_stat(uint8_t *b, int i)
+{
+	bzero(b + 4, 96);
+	put32(b, 4 + 16, 0x8180);                   /* st_mode: S_IFREG | 0600 */
+	put32(b, 4 + 20, 1);                        /* st_nlink */
+	put64(b, 4 + 44, q_files[i].len);           /* st_size */
+	put32(b, 4 + 52, 4096);                     /* st_blksize */
+	put64(b, 4 + 56, (q_files[i].len + 511) / 512);
+}
