+static int
+qf_fd(int fd)
+{
+	int k = fd - QF_FD_BASE;
+	if (k < 0 || k >= QF_NFD || !q_fds[k].used || q_fds[k].file < 0 || !q_files[q_fds[k].file].used) {
+		return -1;
+	}
+	return k;
+}
