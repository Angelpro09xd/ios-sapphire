+			x0 = scm_call(FN_LISTENER_RSP, 0x2, a, 2, ret);
+			continue;
+		}
+		LOG("%s: result %d %s, resp_type %x, data %u (0x%x)%s", what, (int32_t)res, result_name(res), type, data, data,
