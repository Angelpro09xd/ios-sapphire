+/* kern.sweet_qsee_file: "name\0bytes" from user space; no bytes: the file is dropped */
+extern "C" int
+sweet_qsee_file_put(const uint8_t *buf, uint32_t len)
+{
+	uint32_t nl = 0;
+
+	if (!qsee_enabled()) {
 		return ENODEV;
 	}
+	while (nl < len && nl < 64 && buf[nl] != 0) {
+		nl++;
+	}
+	if (nl == 0 || nl >= 64 || nl >= len) {
+		return EINVAL;
+	}
+	char name[64];
+	memcpy(name, buf, nl);
+	name[nl] = 0;
+	if (strchr(name, '/') != NULL) {
+		return EINVAL;
+	}
+	const uint8_t *data = buf + nl + 1;
+	uint32_t dlen = len - nl - 1;
+	if (dlen > QF_FILE_MAX) {
+		return EFBIG;
+	}
+	qsee_lock_init();
+	IOLockLock(q_lock);
+	int r = 0, i = qf_find(name);
+	if (dlen == 0) {
+		if (i >= 0) {
+			qf_free(i);
+		}
+		LOG("file %s: cleared", name);
+	} else {
+		if (i < 0) {
+			i = qf_create(name);
+		}
+		if (i < 0) {
+			r = ENOSPC;
+		} else {
+			q_files[i].len = 0;
+			if (!qf_reserve(i, dlen, true)) {
+				r = ENOSPC;
+			} else {
+				memcpy(q_files[i].data, data, dlen);
+				q_files[i].len = dlen;
+				q_files[i].dirty = false;
+				q_files[i].from_user = true;
+			}
+		}
+		LOG("file %s: %u bytes from user space: %s (store %u bytes)", name, dlen, r == 0 ? "kept" : "NO ROOM", qf_total());
+	}
+	IOLockUnlock(q_lock);
+	return r;
+}
