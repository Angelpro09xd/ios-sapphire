+/* the basename of a 256-byte path field (bounded: never reads past it) */
+static void
+qf_basename(const uint8_t *p, char out[64])
+{
+	char path[257];
+	memcpy(path, p, 256);
+	path[256] = 0;
+	const char *b = path;
+	for (const char *c = path; *c != 0; c++) {
+		if (*c == '/') {
+			b = c + 1;
+		}
+	}
+	strlcpy(out, b, 64);
+}
+
+static int
+qf_find(const char *name)
+{
+	for (int i = 0; i < QF_MAX_FILES; i++) {
+		if (q_files[i].used && strcmp(q_files[i].name, name) == 0) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+static int
+qf_create(const char *name)
+{
+	if (name[0] == 0) {
+		return -1;
+	}
+	for (int i = 0; i < QF_MAX_FILES; i++) {
+		if (!q_files[i].used) {
+			bzero(&q_files[i], sizeof(q_files[i]));
+			strlcpy(q_files[i].name, name, sizeof(q_files[i].name));
+			q_files[i].used = true;
+			return i;
+		}
+	}
+	return -1;
+}
