+/* ---------------------------------------------------------------- 0253: files (listener 10) */
+
+/*
+ * The TA's files (persist/goodix/..., fpdata/...) come from a RAM store that user space fills through
+ * kern.sweet_qsee_file ("name\0bytes"; empty bytes clear it). The TA sees them by basename. All its
+ * writes, creates, removes and renames change the RAM copy only (an overlay, logged): nothing
+ * reaches any disk. kern.sweet_qsee_files lists the store.
+ */
+struct qfile {
+	char     name[64];
+	uint8_t *data;
+	uint32_t len, cap;
+	bool     used, dirty, from_user;
+};
+static struct qfile q_files[QF_MAX_FILES];
+static struct { int file; uint32_t pos; bool used; } q_fds[QF_NFD];
+static int q_errno;
+static uint32_t q_fs_reqs;
+static bool q_lsnr_tried, q_inited;
+static uint8_t q_cmd[0x400];                    /* the biggest command here: SENSOR_INIT, 0x2c0 */
