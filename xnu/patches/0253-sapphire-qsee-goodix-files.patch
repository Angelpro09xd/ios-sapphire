+/* listener 10 with its buffer in the pool (once per boot: TZ keeps it) */
+static bool
+fs_register(void)
+{
+	uint64_t ret[3];
+
+	if (q_lsnr_ok || q_lsnr_tried) {
+		return q_lsnr_ok;
+	}
+	q_lsnr_tried = true;
+	bzero(q_va + OFF_LSB, LSB_SIZE);
+	mb();
+	uint64_t a[3] = { FS_LISTENER, QSEE_POOL_PA + OFF_LSB, LSB_SIZE };
+	int64_t x0 = scm_call(FN_REG_LISTENER, 0x83, a, 3, ret);
+	LOG("listener %u: REGISTER (smcinvoke id) buffer %llx %u bytes: x0 %lld, result %d", FS_LISTENER, QSEE_POOL_PA + OFF_LSB,
+	    LSB_SIZE, x0, (int32_t)ret[0]);
+	if (x0 != 0) {
+		x0 = scm_call(FN_REG_LISTENER_OLD, 0x83, a, 3, ret);
+		LOG("listener %u: REGISTER (legacy id): x0 %lld, result %d", FS_LISTENER, x0, (int32_t)ret[0]);
+	}
+	q_lsnr_ok = x0 == 0 && (uint32_t)ret[0] == RES_SUCCESS;
+	LOG("listener %u (file service): %s", FS_LISTENER, q_lsnr_ok ? "registered" : "NOT registered");
+	return q_lsnr_ok;
+}
