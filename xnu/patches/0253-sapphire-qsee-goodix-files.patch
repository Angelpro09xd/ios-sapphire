+/* one file-service request in the listener buffer, answered in place (minkipc fs_msg.h layouts) */
+static void
+fs_serve(void)
+{
+	uint8_t *b = q_va + OFF_LSB;
+	char name[64], name2[64];
+	int e = 0;
+	int32_t ret = -1;
+	uint32_t cmd = get32(b, 0);
+
+	mb();
+	q_fs_reqs++;
+	switch (cmd) {
+	case 0x202:                                 /* OPEN {path[256]; flags} */
+	case 0x203:                                 /* OPENAT {dirfd; path[256]; flags} */
+	case 0x206: {                               /* CREAT {path[256]; mode} */
+		uint32_t po = cmd == 0x203 ? 8 : 4;
+		uint32_t flags = cmd == 0x206 ? 0x241u : get32(b, po + 256);
+		qf_basename(b + po, name);
+		ret = fs_open(name, flags, &e);
+		put32(b, 4, (uint32_t)ret);
+		LOG("fs %s %s flags 0%o -> %d%s", fs_cmd_name(cmd), name, flags, ret, ret < 0 ? (e == ENOENT ? " (no such file)" : " (error)") : "");
+		break;
+	}
+	case 0x207: {                               /* READ {fd; count} -> {buf[20000]; ret@20004} */
+		int32_t fd = (int32_t)get32(b, 4);
+		uint32_t count = get32(b, 8), n = 0;
+		int k = qf_fd(fd);
+		if (k < 0) {
+			e = EBADF;
+		} else {
+			struct qfile *f = &q_files[q_fds[k].file];
+			uint32_t pos = q_fds[k].pos;
+			n = pos < f->len ? MIN(MIN(count, FS_MAX_DATA), f->len - pos) : 0;
+			if (n > 0) {
+				memcpy(b + 4, f->data + pos, n);
+			}
+			q_fds[k].pos = pos + n;
+			ret = (int32_t)n;
+			LOG("fs read %s @%u %u -> %u", f->name, pos, count, n);
+		}
+		put32(b, 4 + FS_MAX_DATA, (uint32_t)ret);
+		if (k < 0) {
+			LOG("fs read fd %d: bad fd", fd);
+		}
+		break;
+	}
+	case 0x208: {                               /* WRITE {fd; buf[20000]; count@20008} -> {ret} */
+		int32_t fd = (int32_t)get32(b, 4);
+		uint32_t count = get32(b, 8 + FS_MAX_DATA);
+		int k = qf_fd(fd);
+		if (k < 0 || count > FS_MAX_DATA) {
+			e = k < 0 ? EBADF : EINVAL;
+			LOG("fs write fd %d count %u: %s", fd, count, k < 0 ? "bad fd" : "too long");
+		} else {
+			int fi = q_fds[k].file;
+			struct qfile *f = &q_files[fi];
+			uint32_t pos = q_fds[k].pos;
+			if (!qf_reserve(fi, pos + count, false)) {
+				e = ENOSPC;
+				LOG("fs write %s @%u %u: NO ROOM in the RAM store", f->name, pos, count);
+			} else {
+				if (pos > f->len) {
+					bzero(f->data + f->len, pos - f->len);
+				}
+				memcpy(f->data + pos, b + 8, count);
+				q_fds[k].pos = pos + count;
+				f->len = MAX(f->len, pos + count);
+				f->dirty = true;
+				ret = (int32_t)count;
+				LOG("fs write %s @%u %u (now %u bytes; RAM only)", f->name, pos, count, f->len);
+			}
+		}
+		put32(b, 4, (uint32_t)ret);
+		break;
+	}
+	case 0x209: {                               /* CLOSE {fd} */
+		int32_t fd = (int32_t)get32(b, 4);
+		int k = fd - QF_FD_BASE;
+		if (k >= 0 && k < QF_NFD && q_fds[k].used) {
+			q_fds[k].used = false;
+			ret = 0;
+		} else {
+			e = EBADF;
+		}
+		put32(b, 4, (uint32_t)ret);
+		LOG("fs close %d -> %d", fd, ret);
+		break;
+	}
+	case 0x20A: {                               /* LSEEK {fd; off; whence} -> {ret} */
+		int32_t fd = (int32_t)get32(b, 4), off = (int32_t)get32(b, 8), whence = (int32_t)get32(b, 12);
+		int k = qf_fd(fd);
+		if (k < 0 || whence < 0 || whence > 2) {
+			e = k < 0 ? EBADF : EINVAL;
+		} else {
+			int64_t base = whence == 0 ? 0 : whence == 1 ? (int64_t)q_fds[k].pos : (int64_t)q_files[q_fds[k].file].len;
+			int64_t np = base + off;
+			if (np < 0 || np > (int64_t)QF_FILE_MAX) {
+				e = EINVAL;
+			} else {
+				q_fds[k].pos = (uint32_t)np;
+				ret = (int32_t)np;
+			}
+		}
+		put32(b, 4, (uint32_t)ret);
+		LOG("fs lseek %d %d whence %d -> %d", fd, off, whence, ret);
+		break;
+	}
+	case 0x204:                                 /* UNLINKAT {dirfd; path} */
+	case 0x20C:                                 /* UNLINK {path} */
+	case 0x213: {                               /* REMOVE {path} */
+		qf_basename(b + (cmd == 0x204 ? 8 : 4), name);
+		int i = qf_find(name);
+		if (i < 0) {
+			e = ENOENT;
+		} else {
+			qf_free(i);
+			ret = 0;
+		}
+		put32(b, 4, (uint32_t)ret);
+		LOG("fs %s %s -> %d (RAM only)", fs_cmd_name(cmd), name, ret);
+		break;
+	}
+	case 0x20E:                                 /* FSTAT {fd} -> {stat; ret@100} */
+	case 0x20F: {                               /* LSTAT {path} */
+		int i = -1;
+		if (cmd == 0x20E) {
+			int k = qf_fd((int32_t)get32(b, 4));
+			i = k < 0 ? -1 : q_fds[k].file;
+			strlcpy(name, i < 0 ? "(bad fd)" : q_files[i].name, sizeof(name));
+		} else {
+			qf_basename(b + 4, name);
+			i = qf_find(name);
+		}
+		if (i < 0) {
+			e = cmd == 0x20E ? EBADF : ENOENT;
+			bzero(b + 4, 96);
+		} else {
+			fs_stat(b, i);
+			ret = 0;
+		}
+		put32(b, 100, (uint32_t)ret);
+		LOG("fs %s %s -> %d (size %u)", fs_cmd_name(cmd), name, ret, i < 0 ? 0 : q_files[i].len);
+		break;
+	}
+	case 0x217: {                               /* RENAME {old[256]; new[256]} */
+		qf_basename(b + 4, name);
+		qf_basename(b + 260, name2);
+		int i = qf_find(name), j = qf_find(name2);
+		if (i < 0 || name2[0] == 0) {
+			e = ENOENT;
+		} else {
+			if (j >= 0 && j != i) {
+				qf_free(j);
+			}
+			strlcpy(q_files[i].name, name2, sizeof(q_files[i].name));
+			q_files[i].dirty = true;
+			ret = 0;
+		}
+		put32(b, 4, (uint32_t)ret);
+		LOG("fs rename %s -> %s: %d (RAM only)", name, name2, ret);
+		break;
+	}
+	case 0x205:                                 /* FCNTL */
+	case 0x20D:                                 /* RMDIR */
+	case 0x210:                                 /* MKDIR */
+	case 0x211:                                 /* TESTDIR: every directory "exists" */
+	case 0x214:                                 /* CHOWN_CHMOD */
+	case 0x216:                                 /* SYNC */
+		ret = 0;
+		if (cmd == 0x205 || cmd == 0x216) {
+			LOG("fs %s fd %d -> 0", fs_cmd_name(cmd), (int32_t)get32(b, 4));
+		} else {
+			char path[64];
+			memcpy(path, b + 4, sizeof(path) - 1);
+			path[sizeof(path) - 1] = 0;
+			LOG("fs %s %s -> 0", fs_cmd_name(cmd), path);
+		}
+		put32(b, 4, 0);
+		break;
+	case 0x218:                                 /* PAR_FR_SIZE -> {u64 size; ret} */
+		put64(b, 4, 64ull << 20);
+		put32(b, 12, 0);
+		ret = 0;
+		LOG("fs par_free_size -> 64 MB");
+		break;
+	case 0x219:                                 /* DIR_OPEN -> {u64 pdir; ret} */
+		put64(b, 4, 0);
+		put32(b, 12, (uint32_t)-1);
+		e = ENOENT;
+		LOG("fs dir_open: not supported -> -1");
+		break;
+	case 0x21A:                                 /* DIR_READ -> {dirent(275); ret} */
+		put32(b, 4 + 275, (uint32_t)-1);
+		LOG("fs dir_read: not supported -> -1");
+		break;
+	case 0x21B:                                 /* DIR_CLOSE */
+		put32(b, 4, 0);
+		ret = 0;
+		break;
+	case 0x21C:                                 /* GET_ERRNO -> {ret = errno} */
+		put32(b, 4, (uint32_t)q_errno);
+		LOG("fs get_errno -> %d", q_errno);
+		ret = 0;
+		e = q_errno;
+		break;
+	default:
+		put32(b, 4, (uint32_t)-1);
+		LOG("fs: unknown request %x -> -1", cmd);
+		break;
+	}
+	if (ret < 0) {
+		q_errno = e != 0 ? e : EIO;
 	}
+	mb();
+}
