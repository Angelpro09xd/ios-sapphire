From: Angelpro09xd <167892325+Angelpro09xd@users.noreply.github.com>
Subject: [PATCH] sapphire-0265: FastRPC to the ADSP sensors PD, step 1

The ADSP sensor core answers QMI but has only its timer sensor: the sensors
PD needs an HLOS process attached over FastRPC that serves its reverse calls
(sscrpcd on Android). Step 1: the GLINK channel fastrpcglink-apps-dsp, 64 KB
of the modem pool under the audio buffers through SMMU stream 0x1c3 in bypass,
the sensors PD attach (handle 1, pd 2), adsp_listener init2/next2 and
adsp_default_listener register; every reverse call is logged and answered
unsupported. kern.sweet_frpc = 1 starts it (or boot-arg frpc=1),
kern.sweet_frpc_log holds its log.
---
--- a/bsd/dev/sweet_qmi_dev.c	2026-10-30 00:13:19.200294400 +0100
+++ b/bsd/dev/sweet_qmi_dev.c	2026-10-30 00:13:19.287713500 +0100
@@ -313,6 +313,39 @@
 SYSCTL_PROC(_kern, OID_AUTO, sweet_modem_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
     0, 0, sysctl_sweet_modem_stats, "A", "modem GLINK/QRTR counters");
 
+/*
+ * 0265: FastRPC to the ADSP's sensors PD (TopazModem.cpp): kern.sweet_frpc = 1 attaches and starts the
+ * reverse-call listener (EAGAIN: the GLINK channel is not up yet); reading it gives the state
+ * (0 idle, 1 running, 2 listening, negative: the step it stopped at). kern.sweet_frpc_log: its log.
+ */
+extern int topaz_frpc_start(void);
+extern int topaz_frpc_state(void);
+extern int topaz_frpc_log(char *buf, size_t len);
+static int
+sysctl_sweet_frpc SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = topaz_frpc_state();
+	int err = sysctl_io_number(req, v, sizeof(v), &v, NULL);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	return v == 1 ? topaz_frpc_start() : EINVAL;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_frpc, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_frpc, "I", "FastRPC to the ADSP sensors PD: 1 starts; state");
+
+static int
+sysctl_sweet_frpc_log SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	static char buf[12288];
+	int n = topaz_frpc_log(buf, sizeof(buf));
+	return SYSCTL_OUT(req, buf, (size_t)(n > 0 ? n : 0) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_frpc_log, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_frpc_log, "A", "FastRPC log");
+
