From: Angelpro09xd <167892325+Angelpro09xd@users.noreply.github.com>
Subject: [PATCH] sapphire-0267: apps_std for the sensors PD from a RAM file store

The sensors PD (0266) opens apps_std through remotectl and stats
/vendor/etc/sensors/sns_reg_config. The reverse calls are now unpacked and
packed as libadsprpc listener_android does (u32 length per buffer, data
8-byte aligned) and served: remotectl open of apps_std gets a handle;
apps_std fopen, fopen_with_env, fread, fwrite, fclose, fseek, ftell, flen,
feof, fgets, fileExists, opendir/readdir/closedir, stat (31), frename,
fremove, from files written to kern.sweet_frpc_file ("path NUL bytes",
RAM only, listed by kern.sweet_frpc_files). Writes by the PD stay in RAM.
Method numbers and argument sizes from the apps_std skel in Lunaris
libadsprpc. next2 gets a 48 KB slot.
---
--- a/bsd/dev/sweet_qmi_dev.c	2026-10-30 00:35:17.532517000 +0100
+++ b/bsd/dev/sweet_qmi_dev.c	2026-10-30 00:35:58.727984400 +0100
@@ -346,6 +346,54 @@
 SYSCTL_PROC(_kern, OID_AUTO, sweet_frpc_log, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
     0, 0, sysctl_sweet_frpc_log, "A", "FastRPC log");
 
+/*
+ * 0267: the files the sensors PD reads (apps_std over FastRPC), RAM only: kern.sweet_frpc_file = "path\0bytes"
+ * (full path, e.g. /vendor/etc/sensors/sns_reg_config); kern.sweet_frpc_files lists them.
+ */
+extern int topaz_frpc_file_put(const uint8_t *buf, uint32_t len);
+extern int topaz_frpc_files(char *out, size_t max);
+static int
+sysctl_sweet_frpc_file SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	size_t len = req->newlen;
+	if (req->newptr == USER_ADDR_NULL) {
+		return 0;
+	}
+	if (len < 3 || len > (1u << 20)) {
+		return len < 3 ? EINVAL : EFBIG;
+	}
+	uint8_t *buf = kalloc_data(len, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	int err = SYSCTL_IN(req, buf, len);
+	if (err == 0) {
+		err = topaz_frpc_file_put(buf, (uint32_t)len);
+	}
+	kfree_data(buf, len);
+	return err;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_frpc_file, CTLTYPE_OPAQUE | CTLFLAG_WR | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_frpc_file, "S", "a file for the sensors PD: write path\0bytes (RAM only)");
+
+static int
+sysctl_sweet_frpc_files SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	const size_t max = 128 * 1024;
+	char *buf = kalloc_data(max, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	int n = topaz_frpc_files(buf, max);
+	int err = SYSCTL_OUT(req, buf, (size_t)(n > 0 ? n : 0) + 1);
+	kfree_data(buf, max);
+	return err;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_frpc_files, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_frpc_files, "A", "the sensors PD's RAM files");
+
