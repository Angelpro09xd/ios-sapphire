 	{ "modem.b02", 0x1e25000, 0x2930, 0x0858b3a0 },
@@ -198,11 +201,48 @@ static const struct { const char *name; uint32_t off, size, crc; } fw_files[] =
 	{ "modem.b29", 0x49ed000, 0x7d52c, 0x7d6f01a3 },
