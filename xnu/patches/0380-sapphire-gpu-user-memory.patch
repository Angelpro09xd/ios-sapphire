+/*
+ * sapphire 0380: whether any mapping of page PN has written it since the last call for it, for a device that reads
+ * the page behind the processor's caches and cleans only what was written (the GPU of SapphireGpu.cpp, which is not
+ * coherent with them: its user memory buffers). When it was written, the page is made to fault on its next write
+ * again, as pmap_clear_modify makes it, and the bit is cleared; the caller cleans the page after the call.
+ *
+ * pmap_is_modified followed by pmap_clear_modify would lose writes: phys_attribute_clear() write-protects the page's
+ * mappings under its PV lock and clears the bit after that lock is let go, so a write fault taken in between on
+ * another processor (arm_fast_fault, which sets the bit under the same lock and makes the mapping writable again) has
+ * its bit cleared with its mapping left writable -- that write and every later one would never be seen. Here the test,
+ * the write-protection and the clearing are one step under the page's PV lock: a write fault falls wholly before it
+ * (its store done by the time the TLB invalidation of the write-protection completes, and cleaned by the caller after)
+ * or wholly after it (the bit set again, for the next call).
+ *
+ * The first look is without the lock: a write that faulted before the call set the bit before it. Pages the pmap does
+ * not manage, and a page with a wired mapping (which arm_force_fast_fault leaves writable: the bit is left set), answer
+ * TRUE every time. The VM's own account of these pages does not rest on the bit while the device holds them: it holds
+ * them through an IOPL prepared for writing, which marks each page dirty (vm_object_iopl_request, SET_PAGE_DIRTY), and
+ * gives the bit back (pmap_set_modify) when it lets them go.
+ */
+boolean_t
+pmap_test_and_clear_modify(
+	ppnum_t pn)
+{
+#if XNU_MONITOR
+	(void)pn;
+	return TRUE;            /* (no PPL entry for it: every page answers written, and is cleaned every time) */
+#else
+	pmap_paddr_t    pa = ptoa(pn);
+	unsigned int    pai;
+	boolean_t       modified;
+
+	if (!pa_valid(pa)) {
+		return TRUE;
+	}
+	if (!ppattr_pa_test_bits(pa, PP_ATTR_MODIFIED)) {
+		return FALSE;
+	}
+	pai = pa_index(pa);
+	pvh_lock(pai);
+	modified = ppattr_pa_test_bits(pa, PP_ATTR_MODIFIED);
+	if (modified &&
+	    arm_force_fast_fault_with_flush_range(pn, VM_PROT_ALL & ~VM_PROT_WRITE, PMAP_OPTIONS_FF_LOCKED, NULL)) {
+		ppattr_pa_clear_bits(pa, PP_ATTR_MODIFIED);
+	}
+	pvh_unlock(pai);
+	return modified;
+#endif
+}
