+/*
+ * kern.sweet_audio: the audio test driven from user space (ssh), carried out by TopazModem's
+ * ADSP thread, which owns the GLINK edge and the SoundWire buses.
+ * Write a request, read the answer:
+ *   op << 56 | target << 48 | addr << 32 | value
+ *   op 1 beep (value: seconds), 2 write, 3 read (the answer: the value), 4 the whole test again,
+ *   5 test flags (value; TopazModem.cpp a_flags)
+ *   target 1 WCD937x, 2 RX macro, 3 VA macro, 4 RX SoundWire master, 5 VA SoundWire master,
+ *   6 FS1815 (addr: I2C address << 8 | register), 7 the WCD937x's RX SoundWire slave
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/kernel.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <libkern/libkern.h>
+
+extern void IOSleep(unsigned int milliseconds);
+
+volatile uint64_t sweet_audio_req, sweet_audio_rsp;
+volatile uint32_t sweet_audio_seq, sweet_audio_done;
+
+static int
+sysctl_sweet_audio SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint64_t v = sweet_audio_rsp;
+	int err = sysctl_io_number(req, (long long)v, sizeof(v), &v, NULL);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	uint32_t seq = sweet_audio_seq + 1;
+	sweet_audio_req = v;
+	__asm__ volatile("dmb ish" ::: "memory");
+	sweet_audio_seq = seq;
+	for (int i = 0; i < 60000 && sweet_audio_done != seq; i++) {
+		IOSleep(1);
+	}
+	return sweet_audio_done == seq ? 0 : ETIMEDOUT;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_audio, CTLTYPE_QUAD | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_audio, "Q", "audio test requests (sweet_audio_ctl.c)");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
