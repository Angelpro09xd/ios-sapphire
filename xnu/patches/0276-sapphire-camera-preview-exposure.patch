-			return EINVAL;
-		}
-		cs.phy = 0; cs.cphy = true; cs.settle = 0x32;
-		if (!cci_read(0, 0x10, 0x0000, id, 2) || (id[0] << 8 | id[1]) != 0x1AD6) {
-			camlog("op 10: no S5KHM6 at m0 0x10: stop");
-			return ENODEV;
-		}
-		r = cam_replay(0, 0x10, hm6_init, sizeof(hm6_init) / sizeof(hm6_init[0]), "HM6 init");
-		r = r ? r : cam_replay(0, 0x10, mt, mn, "HM6 mode");
-		r = r ? r : cam_replay(0, 0x10, hm6_on, sizeof(hm6_on) / sizeof(hm6_on[0]), "HM6 stream on");
+		r = hm6_switch(mode);
+		cam_frame_off = 0;
