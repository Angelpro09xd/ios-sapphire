 		(void)pin_out(mclk_pin[s], 0);
@@ -794,6 +808,8 @@ fail:
 
 /* ---------------------------------------------------------------- op 10: sensor init, mode, stream on */
 
+static int hm6_switch(unsigned mode);
+
 static int
 cam_sensor_on(void)
 {
@@ -808,24 +824,9 @@ cam_sensor_on(void)
 		return EAGAIN;
 	}
 	if (slot == 0) {
-		if (mode == 0) {
-			mt = hm6_mode0; mn = sizeof(hm6_mode0) / sizeof(hm6_mode0[0]); cs.w = 12000; cs.h = 9000;
-		} else if (mode == 1) {
-			mt = hm6_mode1; mn = sizeof(hm6_mode1) / sizeof(hm6_mode1[0]); cs.w = 4000; cs.h = 3000;
-		} else if (mode == 4) {
-			mt = hm6_mode4; mn = sizeof(hm6_mode4) / sizeof(hm6_mode4[0]); cs.w = 4000; cs.h = 3000;
-		} else {
