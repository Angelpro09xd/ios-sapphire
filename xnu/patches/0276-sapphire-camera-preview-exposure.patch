 	} else if (slot == 2) {
 		if (mode != 0) {
 			camlog("op 10: S5K4H7 mode %u not built in (0)", mode);
@@ -1250,7 +1251,7 @@ sysctl_sweet_cam_frame SYSCTL_HANDLER_ARGS
 	} else {
 		uint32_t n = cam_frame_len - (uint32_t)cam_seek;
 		n = n > (1u << 20) ? (1u << 20) : n;
-		err = SYSCTL_OUT(req, cam_pool + cam_seek, n);
+		err = SYSCTL_OUT(req, cam_pool + cam_frame_off + cam_seek, n);
 		if (err == 0 && req->oldptr != USER_ADDR_NULL) {
 			cam_seek += n;
 		}
@@ -1571,11 +1572,439 @@ cam_capture_staged(void)
 	    cam_pool[10], cam_pool[11], cam_pool[12], cam_pool[13], cam_pool[14], cam_pool[15]);
 	(void)smmu_fault("after");
 	cam_frame_len = changed != 0 ? bytes : 0;
+	cam_frame_off = 0;
 	cam_seek = 0;
 	camlog("op 23: %s (%u bytes in kern.sweet_cam_frame)", changed ? "FRAME CAPTURED" : "nothing written", cam_frame_len);
 	return changed && !fault ? 0 : EIO;
 }
 
+/* ================================================================ 0276: exposure, preview ring, still */
+
+/*
+ * kern.sweet_cam_exp: write "coarse_lines analog_gain_x1000 [frame_length_lines]" (decimal) ->
+ * HM6 0x0202 / 0x0204 (1x = 0x20, max 64x = 0x800) / 0x0340 inside a group hold (0x0104);
+ * read: the current mode, its line time and limits and the values in use.
+ * Op 30 preview: HM6 in mode (arg >> 4 & 0xF, default 1; 3 = 1280x720), frames into a ring of
+ * 4 buffers at the start of the pool; a kernel thread follows CSID RDI0 SOF/EOF: at each SOF
+ * it programs the next buffer into WM7 (latched at the next SOF), at each EOF it publishes the
+ * buffer just finished (kern.sweet_cam_latest). kern.sweet_cam_sel picks what
+ * kern.sweet_cam_frame reads: -1 the newest preview frame, 0-3 a ring buffer, 100 the still.
+ * Op 31 stops the preview. Op 32: preview off, mode 0 with the exposure time carried over, one
+ * 108 MP frame at the pool start (it overwrites the ring: op 30 again after reading it).
+ */
+#define PV_NBUF         4
+
+static const unsigned hm6_fps_x100[5] = { 704, 3004, 3004, 12000, 3000 };
+static struct { bool set; uint32_t coarse, gain_x1000, fll; } ex;
+static uint32_t m_fll, m_llp, m_line_ns;
+static volatile bool pv_run, pv_alive;
+static volatile int pv_latest = -1;
+static volatile uint64_t pv_seq, pv_ts_ns, pv_ovf;
+static volatile uint32_t pv_fault;
+static uint32_t pv_bytes, pv_stride, pv_mode, cam_still_len;
+static int cam_sel = 100;
+
+static uint16_t
+tbl_last(const struct cam_reg *t, unsigned n, uint16_t addr, uint16_t dflt)
+{
+	uint16_t v = dflt;
+	for (unsigned i = 0; i < n; i++) {
+		if (t[i].blen == 0 && t[i].dt == 2 && t[i].addr == addr) {
+			v = t[i].val;
+		}
+	}
+	return v;
+}
+
+static bool
+hm6_mode_table(unsigned mode, const struct cam_reg **t, unsigned *n)
+{
+	switch (mode) {
+	case 0: *t = hm6_mode0; *n = sizeof(hm6_mode0) / sizeof(hm6_mode0[0]); cs.w = 12000; cs.h = 9000; return true;
+	case 1: *t = hm6_mode1; *n = sizeof(hm6_mode1) / sizeof(hm6_mode1[0]); cs.w = 4000; cs.h = 3000; return true;
+	case 3: *t = hm6_mode3; *n = sizeof(hm6_mode3) / sizeof(hm6_mode3[0]); cs.w = 1280; cs.h = 720; return true;
+	case 4: *t = hm6_mode4; *n = sizeof(hm6_mode4) / sizeof(hm6_mode4[0]); cs.w = 4000; cs.h = 3000; return true;
+	default: return false;
+	}
+}
+
+static uint32_t
+exp_max_lines(void)
+{
+	uint32_t fll = ex.fll != 0 ? ex.fll : m_fll;
+	return fll > 16 ? fll - 16 : 12;
+}
+
+/* the exposure in ex to the sensor (page 0x4000, group hold) */
+static int
+hm6_apply_exposure(void)
+{
+	uint32_t code = ex.gain_x1000 * 32 / 1000;
+	code = code < 0x20 ? 0x20 : code > 0x800 ? 0x800 : code;
+	uint32_t lines = ex.coarse < 12 ? 12 : ex.coarse > exp_max_lines() ? exp_max_lines() : ex.coarse;
+	bool ok = cci_write(0, 0x10, 0xFCFC, 0x4000, 2) && cci_write(0, 0x10, 0x0104, 0x0101, 2);
+	if (ok && ex.fll != 0) {
+		ok = cci_write(0, 0x10, 0x0340, ex.fll, 2);
+	}
+	ok = ok && cci_write(0, 0x10, 0x0202, lines, 2) && cci_write(0, 0x10, 0x0204, code, 2);
+	ok = ok && cci_write(0, 0x10, 0x0104, 0x0001, 2);
+	camlog("exposure: %u lines (%u us), gain code %#x (%u.%03ux), frame length %u: %s", lines,
+	    (uint32_t)((uint64_t)lines * m_line_ns / 1000), code, code / 32, (code % 32) * 1000 / 32, ex.fll ? ex.fll : m_fll,
+	    ok ? "written" : "FAILED");
+	return ok ? 0 : EIO;
+}
+
+/* HM6 into mode: init + mode + stream on the first time, else stream off + mode + stream on */
+static int
+hm6_switch(unsigned mode)
+{
+	const struct cam_reg *mt;
+	unsigned mn;
+	uint8_t id[2];
+	int r = 0;
+	uint32_t old_line_ns = m_line_ns;
+
+	if (!camss_up || !slot_up[0]) {
+		camlog("HM6: slot 0 is not powered (ops 1, 2 first)");
+		return EAGAIN;
+	}
+	if (!hm6_mode_table(mode, &mt, &mn)) {
+		camlog("HM6: mode %u not built in (0, 1, 3, 4)", mode);
+		return EINVAL;
+	}
+	if (cam_streaming && cs.slot == 0) {
+		r = cam_replay(0, 0x10, hm6_off, sizeof(hm6_off) / sizeof(hm6_off[0]), "HM6 stream off");
+	} else {
+		if (!cci_read(0, 0x10, 0x0000, id, 2) || (id[0] << 8 | id[1]) != 0x1AD6) {
+			camlog("HM6: no S5KHM6 at m0 0x10: stop");
+			return ENODEV;
+		}
+		r = cam_replay(0, 0x10, hm6_init, sizeof(hm6_init) / sizeof(hm6_init[0]), "HM6 init");
+	}
+	cam_streaming = false;
+	r = r ? r : cam_replay(0, 0x10, mt, mn, "HM6 mode");
+	if (r != 0) {
+		return r;
+	}
+	m_fll = tbl_last(mt, mn, 0x0340, 1);
+	m_llp = tbl_last(mt, mn, 0x0342, 0);
+	m_line_ns = (uint32_t)(100000000000ull / ((uint64_t)hm6_fps_x100[mode] * m_fll));
+	if (ex.set) {
+		if (old_line_ns != 0 && old_line_ns != m_line_ns) {
+			/* the same exposure time in the new mode's lines; its own frame length */
+			ex.coarse = (uint32_t)((uint64_t)ex.coarse * old_line_ns / m_line_ns);
+			ex.fll = 0;
+		}
+		(void)hm6_apply_exposure();
+	}
+	r = cam_replay(0, 0x10, hm6_on, sizeof(hm6_on) / sizeof(hm6_on[0]), "HM6 stream on");
+	cs.slot = 0; cs.mode = mode; cs.phy = 0; cs.cphy = true; cs.settle = 0x32;
+	cam_streaming = r == 0;
+	camlog("HM6 mode %u: %ux%u, frame length %u lines, line length %u, line time %u ns: %s", mode, cs.w, cs.h, m_fll, m_llp,
+	    m_line_ns, r == 0 ? "streaming" : "FAILED");
+	return r;
+}
+
+static int
+sysctl_sweet_cam_exp SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[256];
+	snprintf(buf, sizeof(buf), "mode %u %ux%u fll %u llp %u line_ns %u coarse %u (min 12 max %u) gain_x1000 %u (1000-64000) "
+	    "fll_set %u set %u streaming %u", cs.mode, cs.w, cs.h, m_fll, m_llp, m_line_ns, ex.coarse, exp_max_lines(), ex.gain_x1000,
+	    ex.fll, ex.set, cam_streaming);
+	int err = sysctl_handle_string(oidp, buf, sizeof(buf), req);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	uint32_t v[3] = { 0, 0, 0 };
+	unsigned k = 0;
+	for (const char *p = buf; *p != 0 && k < 3;) {
+		while (*p == ' ') {
+			p++;
+		}
+		if (*p < '0' || *p > '9') {
+			break;
+		}
+		while (*p >= '0' && *p <= '9') {
+			v[k] = v[k] * 10 + (uint32_t)(*p++ - '0');
+		}
+		k++;
+	}
+	if (k < 2 || v[1] < 1000 || v[1] > 64000) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_cam_mtx);
+	cam_log_len = 0;
+	cam_log[0] = 0;
+	ex.set = true;
+	ex.coarse = v[0];
+	ex.gain_x1000 = v[1];
+	ex.fll = k > 2 ? v[2] : 0;
+	int r = 0;
+	if (cam_streaming && cs.slot == 0) {
+		r = hm6_apply_exposure();
+	} else {
+		camlog("exposure kept for the next HM6 stream");
+	}
+	lck_mtx_unlock(&sweet_cam_mtx);
+	return r;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_exp, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_cam_exp, "A", "HM6 exposure: write \"lines gain_x1000 [frame_length]\"; read the state");
+
+/* ---------------------------------------------------------------- the preview thread */
+
+static void
+pv_thread(void *arg __unused, wait_result_t wres __unused)
+{
+	vm_offset_t t = cam_csid;
+	int cur = -1;
+	unsigned prog = 0, polls = 0;
+	while (pv_run) {
+		uint32_t rdi = rd(t, 0x040);
+		if (rdi != 0) {
+			wr(t, 0x048, rdi);
+			wr(t, 0x080, 1);
+		}
+		if ((rdi & (1u << 9)) && cur >= 0) {            /* EOF: buffer cur is complete */
+			pv_latest = cur;
+			uint64_t ns;
+			absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+			pv_ts_ns = ns;
+			pv_seq++;
+		}
+		if (rdi & (1u << 12)) {                         /* SOF: prog was latched; the next one now */
+			cur = (int)prog;
+			prog = (prog + 1) % PV_NBUF;
+			wr(t, 0x2304, (uint32_t)(CAM_POOL_PA + (uint64_t)prog * pv_stride));
+			wr(t, 0x102C, 0x2);
+		}
+		if (rdi & (1u << 2)) {
+			pv_ovf++;
+		}
+		if ((++polls & 63) == 0) {
+			uint32_t s0 = rd(t, 0x104C), s1 = rd(t, 0x1050), b0 = rd(t, 0x1A28), b1 = rd(t, 0x1A2C);
+			if (s0 | s1) {
+				wr(t, 0x1040, s0); wr(t, 0x1044, s1); wr(t, 0x1030, 1);
+			}
+			if (b0 | b1) {
+				wr(t, 0x1A20, b0); wr(t, 0x1A24, b1); wr(t, 0x1A30, 1);
+			}
+			uint32_t fsr = s_cbp ? rd(s_cbp, 0x58) : 0;
+			if (fsr & SMMU_FSR_FAULT) {
+				pv_fault = fsr;
+				wr(t, 0x2300, 0);                       /* stop writing at once */
+				wr(t, 0x102C, 0x2);
+				break;
+			}
+		}
+		IOSleep(1);
+	}
+	pv_alive = false;
+	thread_terminate(current_thread());
+}
+
+static void
+pv_stop(void)
+{
+	if (!pv_alive) {
+		return;
+	}
+	pv_run = false;
+	for (int i = 0; i < 200 && pv_alive; i++) {
+		IOSleep(1);
+	}
+	if (cam_csid != 0) {
+		wr(cam_csid, 0x308, 0);                         /* RDI0 halt at the frame boundary */
+		wr(cam_csid, 0x2300, 0);
+		wr(cam_csid, 0x102C, 0x2);
+	}
+	camlog("preview stopped after %llu frames (overflows %llu, SMMU fault %#x)", pv_seq, pv_ovf, pv_fault);
+}
+
+/* op 30 */
+static int
+pv_start(void)
+{
+	unsigned mode = ((unsigned)cam_arg >> 4) & 0xF;
+	mode = mode == 0 ? 1 : mode;
+	if (mode != 1 && mode != 3 && mode != 4) {
+		camlog("op 30: preview modes are 1, 3, 4");
+		return EINVAL;
+	}
+	pv_stop();
+	int r = hm6_switch(mode);
+	if (r == 0 && !cam_csid_up) {
+		r = cam_link_on();
+	}
+	if (r == 0 && !s_ready) {
+		r = cam_smmu_stage();
+	}
+	if (r != 0) {
+		return r;
+	}
+	pv_bytes = cs.w * cs.h * 10 / 8;
+	pv_stride = (pv_bytes + 0xFFF) & ~0xFFFu;
+	if (CAM_POOL_PA + (uint64_t)PV_NBUF * pv_stride > CAM_MAP_END) {
+		camlog("op 30: %u buffers of %u bytes do not fit", PV_NBUF, pv_stride);
+		return ENOMEM;
+	}
+	vm_offset_t t = cam_csid;
+	step("preview: WM7 frame mode, %u buffers of %u bytes from %#llx", PV_NBUF, pv_stride, CAM_POOL_PA);
+	wr(t, 0x308, 0);
+	wr(t, 0x1034, 0xFFFFFFFF); wr(t, 0x1038, 0xFFFFFFFF); wr(t, 0x103C, 0xFFFFFFFF);
+	wr(t, 0x1040, 0xFFFFFFFF); wr(t, 0x1044, 0xFFFFFFFF); wr(t, 0x1048, 0xFFFFFFFF); wr(t, 0x1030, 1);
+	wr(t, 0x1A18, 0xFFFFFFFF); wr(t, 0x1A1C, 0xFFFFFFFF);
+	wr(t, 0x1A20, 0xFFFFFFFF); wr(t, 0x1A24, 0xFFFFFFFF); wr(t, 0x1A30, 1);
+	wr(t, 0x231C, 0xF);
+	wr(t, 0x230C, 0x0000FFFF);
+	wr(t, 0x2318, 0xA);
+	wr(t, 0x2314, 0xFFFF);
+	wr(t, 0x2304, (uint32_t)CAM_POOL_PA);
+	wr(t, 0x2308, pv_bytes);
+	wr(t, 0x2338, 0);
+	wr(t, 0x233C, 1);
+	wr(t, 0x1460, 0x1);
+	wr(t, 0x1470, 0x00140014);
+	wr(t, 0x2300, 0x00010001);
+	wr(t, 0x102C, 0x2);
+	smmu_fsr_clear("before the preview");
+	w_ready = false;                                /* op 23 must configure WM7 again */
+	pv_seq = 0;
+	pv_ovf = 0;
+	pv_fault = 0;
+	pv_latest = -1;
+	pv_mode = mode;
+	pv_run = true;
+	pv_alive = true;
+	thread_t th;
+	if (kernel_thread_start(pv_thread, NULL, &th) != KERN_SUCCESS) {
+		pv_run = pv_alive = false;
+		camlog("op 30: no thread");
+		return ENOMEM;
+	}
+	thread_deallocate(th);
+	wr(t, 0x308, 1);                                /* RDI0 resume */
+	cam_sel = -1;
+	cam_frame_off = 0;
+	cam_frame_len = 0;
+	IOSleep(300);
+	camlog("op 30: preview mode %u (%ux%u, %u bytes a frame): %llu frames in 300 ms, latest buffer %d", mode, cs.w, cs.h,
+	    pv_bytes, pv_seq, pv_latest);
+	return pv_seq != 0 ? 0 : EIO;
+}
+
+/* op 32 */
+static int
+cam_still(void)
+{
+	pv_stop();
+	int r = hm6_switch(0);
+	if (r == 0 && !cam_csid_up) {
+		r = cam_link_on();
+	}
+	if (r == 0 && !s_ready) {
+		r = cam_smmu_stage();
+	}
+	IOSleep(300);                                   /* the first frames after a mode change */
+	r = r ? r : cam_wm_config();
+	r = r ? r : cam_capture_staged();
+	cam_still_len = r == 0 ? cs.w * cs.h * 10 / 8 : 0;
+	cam_sel = 100;
+	cam_frame_off = 0;
+	camlog("op 32: still %ux%u: %s (op 30 restarts the preview, which overwrites it)", cs.w, cs.h, r == 0 ? "CAPTURED" : "FAILED");
+	return r;
+}
+
+static int
+sysctl_sweet_cam_latest SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[200];
+	int n = snprintf(buf, sizeof(buf), "running %u seq %llu buf %d off %#x bytes %u w %u h %u mode %u t_ns %llu ovf %llu fault %#x",
+	    pv_alive, pv_seq, pv_latest, pv_latest >= 0 ? (uint32_t)pv_latest * pv_stride : 0, pv_bytes, cs.w, cs.h, pv_mode,
+	    pv_ts_ns, pv_ovf, pv_fault);
+	return SYSCTL_OUT(req, buf, (size_t)n + 1);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_latest, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_cam_latest, "A", "the preview ring: newest complete frame");
+
+/* what kern.sweet_cam_frame reads: -1 the newest preview frame, 0..3 a ring buffer, 100 the still */
+static int
+sysctl_sweet_cam_sel SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = cam_sel;
+	int err = sysctl_io_number(req, v, sizeof(v), &v, NULL);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	lck_mtx_lock(&sweet_cam_mtx);
+	if (v == 100) {
+		cam_frame_off = 0;
+		cam_frame_len = cam_still_len;
+	} else if (v >= -1 && v < PV_NBUF && pv_stride != 0) {
+		int b = v < 0 ? pv_latest : v;
+		if (b < 0) {
+			err = EAGAIN;
+		} else {
+			cam_frame_off = (uint32_t)b * pv_stride;
+			cam_frame_len = pv_bytes;
+		}
+	} else {
+		err = EINVAL;
+	}
+	if (err == 0) {
+		cam_sel = v;
+		cam_seek = 0;
+	}
+	lck_mtx_unlock(&sweet_cam_mtx);
+	return err;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_sel, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_cam_sel, "I", "kern.sweet_cam_frame source: -1 newest preview, 0-3 ring buffer, 100 still");
+
+/* op 9's extra: the stream, the capture path and their clocks */
+static void
+cam_stream_off_all(void)
+{
+	pv_stop();
+	if (cam_csid != 0 && cam_csid_up) {
+		wr(cam_csid, 0x308, 0);
+		wr(cam_csid, 0x2300, 0);
+		wr(cam_csid, 0x1460, 0);
+		wr(cam_csid, 0x102C, 0x2);
+	}
+	if (cam_streaming && camss_up) {
+		(void)cam_replay(cs.slot == 0 ? 0 : 1, cs.slot == 0 ? 0x10 : 0x2D, cs.slot == 0 ? hm6_off : h7_off,
+		    cs.slot == 0 ? (unsigned)(sizeof(hm6_off) / sizeof(hm6_off[0])) : (unsigned)(sizeof(h7_off) / sizeof(h7_off[0])),
+		    "stream off");
+	}
+	if (cam_phy != 0 && cam_csid_up) {
+		wr(cam_phy, 0x814, 0);                          /* CSIPHY lanes off, reset */
+		wr(cam_phy, 0x800, 0x01);
+		IOSleep(1);
+		wr(cam_phy, 0x800, 0x00);
+	}
+	if (gcc != 0) {
+		branch_off("tfe_0", 0x5201Cu);
+		branch_off("tfe_0_cphy_rx", 0x5207Cu);
+		branch_off("tfe_0_csid", 0x520ACu);
+		for (unsigned n = 0; n < 3; n++) {
+			branch_off("csiphytimer", 0x59018u + 0x1Cu * n);
+			branch_off("cphy", 0x52088u + 4u * n);
+		}
+	}
+	cam_streaming = false;
+	cam_csid_up = false;
+	w_ready = false;
+	/* the RPM votes for L4/L18 stay: they are APPS' only vote on rails the display and USB PHYs share, at the values UEFI set */
+}
+
 static int
 sysctl_sweet_cam SYSCTL_HANDLER_ARGS
 {
@@ -1613,6 +2042,16 @@ sysctl_sweet_cam SYSCTL_HANDLER_ARGS
 	case 20:
 		r = cam_smmu_stage();
 		break;
+	case 30:
+		r = pv_start();
+		break;
+	case 31:
+		pv_stop();
+		r = 0;
+		break;
+	case 32:
+		r = cam_still();
+		break;
 	case 21:
 		r = cam_tfe_read();
 		break;
