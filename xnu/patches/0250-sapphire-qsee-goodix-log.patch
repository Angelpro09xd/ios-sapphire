 static int
-milestone(bool restart)
+l9_readback(void)
+{
+	static const uint8_t regs[] = { 0x04, 0x05, 0x08, 0x40, 0x41, 0x45, 0x46 };
+	uint8_t v[sizeof(regs)] = {};
+	int e = sweet_spmi_init();
+	if (e != 0) {
+		LOG("L9: SPMI not available (%d)", e);
+		return EIO;
+	}
+	for (unsigned i = 0; i < sizeof(regs); i++) {
+		e = sweet_spmi_read_any(0, 0x4800u + regs[i], &v[i]);
+		if (e != 0) {
+			LOG("L9: SPMI read 0x%x failed: %d", 0x4800u + regs[i], e);
+			return EIO;
+		}
+	}
+	LOG("L9 (PM6125 0x4800): type %02x subtype %02x status1 %02x (ready %u), vset %u mV, mode %02x, en_ctl %02x (%s)", v[0],
+	    v[1], v[2], v[2] >> 7, v[3] | (unsigned)v[4] << 8, v[5], v[6], (v[6] & 0x80) ? "enabled" : "not enabled by apps");
+	return 0;
