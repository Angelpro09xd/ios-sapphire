+/* ---------------------------------------------------------------- the QSEE log */
+
+/* once per boot (TZ keeps the buffer): the pool's 32 KB, zeroed */
+static void
+tz_log_register(void)
+{
+	uint64_t ret[3];
+
+	if (q_log_tried) {
+		return;
+	}
+	q_log_tried = true;
+	bzero(q_va + OFF_LOG, LOG_SIZE);
+	mb();
+	uint64_t a[2] = { QSEE_POOL_PA + OFF_LOG, LOG_SIZE };
+	int64_t x0 = scm_call(FN_REG_LOG_BUF, 0x22, a, 2, ret);
+	q_log_ok = x0 == 0 && (uint32_t)ret[0] != RES_FAILURE;
+	LOG("QSEE log buffer %llx (%u bytes): x0 %lld, result %d, resp_type %x, data %x: %s", QSEE_POOL_PA + OFF_LOG, LOG_SIZE,
+	    x0, (int32_t)ret[0], (uint32_t)ret[1], (uint32_t)ret[2], q_log_ok ? "registered" : "NOT registered, no TZ log");
+}
+
+/*
+ * The log lines TZ wrote since the last call. Header {wrap, offset} (u16 pairs, or u32 on v2:
+ * told apart by the first non-zero offset), then a ring; every index is taken modulo the ring.
+ */
+static void
+tz_log_dump(const char *cmd)
+{
+	if (!q_log_ok) {
+		return;
+	}
+	const volatile uint8_t *b = q_va + OFF_LOG;
+	mb();
+	uint32_t w16 = b[0] | (uint32_t)b[1] << 8, o16 = b[2] | (uint32_t)b[3] << 8;
+	uint32_t w32 = w16 | o16 << 16, o32 = b[4] | (uint32_t)b[5] << 8 | (uint32_t)b[6] << 16 | (uint32_t)b[7] << 24;
+	if (q_log_ver == 0) {
+		if (o16 != 0) {
+			q_log_ver = 1;
+		} else if (o32 != 0 && o32 < LOG_SIZE) {
+			q_log_ver = 2;
+		} else {
+			LOG("TZ %s| (log still empty: %02x %02x %02x %02x %02x %02x %02x %02x)", cmd, b[0], b[1], b[2], b[3], b[4],
+			    b[5], b[6], b[7]);
+			return;
+		}
+		LOG("TZ log: header v%u (wrap/offset %u bytes each)", q_log_ver, q_log_ver == 1 ? 2 : 4);
+	}
+	const uint32_t hdr = q_log_ver == 1 ? 4 : 8, ring = LOG_SIZE - hdr;
+	const uint32_t wrap = q_log_ver == 1 ? w16 : w32, off = q_log_ver == 1 ? o16 : o32;
+	if (off >= ring) {
+		LOG("TZ %s| offset %u beyond the ring (%u): log dumps stopped", cmd, off, ring);
+		q_log_ok = false;
+		return;
+	}
+	uint32_t start = q_log_off, n;
+	if (wrap == q_log_wrap && off >= q_log_off) {
+		n = off - q_log_off;
+	} else if (wrap == q_log_wrap + 1 && off < q_log_off) {
+		n = ring - q_log_off + off;
+	} else {
+		LOG("TZ %s| (the log wrapped past us: wrap %u -> %u, offset %u -> %u; the whole ring)", cmd, q_log_wrap, wrap,
+		    q_log_off, off);
+		start = off;
+		n = ring;
+	}
+	q_log_wrap = wrap;
+	q_log_off = off;
+	char line[161];
+	unsigned len = 0, lines = 0;
+	for (uint32_t i = 0; i < n && i < ring; i++) {
+		char c = (char)b[hdr + (start + i) % ring];
+		if (c == '\0' || c == '\r') {
+			continue;
+		}
+		if (c != '\n') {
+			line[len++] = (c >= 0x20 && c < 0x7f) ? c : '.';
+		}
+		if (c == '\n' || len == sizeof(line) - 1) {
+			line[len] = 0;
+			if (len > 0 && lines < 400) {
+				LOG("TZ %s|%s", cmd, line);
+			}
+			lines += len > 0;
+			len = 0;
+		}
+	}
+	if (len > 0 && lines < 400) {
+		line[len] = 0;
+		LOG("TZ %s|%s", cmd, line);
+		lines++;
+	}
+	if (lines > 400) {
+		LOG("TZ %s| (%u more lines not shown)", cmd, lines - 400);
+	}
+}
