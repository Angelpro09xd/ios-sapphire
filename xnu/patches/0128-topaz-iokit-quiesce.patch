From 42c9317e46133256f425ef525d5a1d4ef6609d48 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Tue, 20 Oct 2026 14:39:17 +0300
Subject: [PATCH] topaz-0128: no registry-root busy hold for the IOKit daemon
 (IOKit never quiesced; wifid hung boot)

---
 iokit/Kernel/IOService.cpp    | 2 ++
 iokit/Kernel/IOStartIOKit.cpp | 9 +++++++++
 2 files changed, 11 insertions(+)

diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 59c834e..6a518c3 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -1200,7 +1200,9 @@ IOService::iokitDaemonLaunched(void)
 	}
 	IOServiceTrace(IOSERVICE_KEXTD_READY, 0, 0, 0, 0);
 	startDeferredMatches();
+#if !defined(ARM64_BOARD_CONFIG_SWEET)                 /* SWEET takes no hold for it (IOStartIOKit.cpp) */
 	getServiceRoot()->adjustBusy(-1);
+#endif
 	IOService::publishUserResource(gIOResourceIOKitKey);
 #endif /* !NO_KEXTD */
 }
diff --git a/iokit/Kernel/IOStartIOKit.cpp b/iokit/Kernel/IOStartIOKit.cpp
index d74c063..0f71f63 100644
--- a/iokit/Kernel/IOStartIOKit.cpp
+++ b/iokit/Kernel/IOStartIOKit.cpp
@@ -188,7 +188,16 @@ StartIOKitMatching(void)
 	}
 
 #if !NO_KEXTD
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * SWEET: no IOKit daemon ever reports that it has launched (no kexts to manage), so this
+	 * hold kept the registry root busy forever: IOKit never quiesced, configd's InterfaceNamer
+	 * never said "quiet", and wifid (and SpringBoard behind it) waited for that at boot.
+	 */
+	if (false) {
+#else
 	if (OSKext::iokitDaemonAvailable()) {
+#endif
 		/* Add a busy count to keep the registry busy until the IOKit daemon has
 		 * completely finished launching. This is decremented when the IOKit daemon
 		 * messages the kernel after the in-kernel linker has been
-- 
2.43.0

