--- a/iokit/Kernel/arm/TopazModem.cpp
+++ b/iokit/Kernel/arm/TopazModem.cpp
@@ -11375,6 +11375,692 @@ topaz_rpm_stats(uint64_t *requests, uint64_t *refused, uint64_t *timeouts, uint6
 	*wait_us_max = rpm_st.wait_us_max;
