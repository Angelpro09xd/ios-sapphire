+/*
+ * sapphire 0299: the boot screen. The shim (shim/splash.c) puts its picture on the panel and starts
+ * xnu straight away with sweet_splash=<physical address of the picture: "SPLH", width, height, 0,
+ * then width * height a8r8g8b8>. xnu then draws no log (serial_console.c, sweet_early.c) and paints
+ * the boot screen itself while it boots: the picture as soon as the console exists (the panel memory
+ * is found black by then), then a thread types the lines out and keeps the frame on the panel --
+ * the boot framebuffer, then AppleCLCD's console frame -- until iOS's first frame
+ * (SweetFramebuffer.cpp clears sweet_splash_active). Volume up held meanwhile restarts into
+ * recovery (sweet_keys.c).
+ */
+int sweet_splash_active;
+static uint64_t sweet_splash_pa;
+static const uint32_t *sweet_splash_pic;        /* the shim's picture, mapped */
+static uint32_t sweet_splash_w, sweet_splash_h;
+
+#define SPLASH_PIC_Y    380
+#define SPLASH_GREY     0xff8a8a8au
+#define SPLASH_HEART    0xffff3b5cu
+
+static const unsigned char sweet_splash_heart[16] = {
+	0x00, 0x00, 0x00, 0x00, 0x36, 0x7f, 0x7f, 0x7f, 0x7f, 0x3e, 0x1c, 0x08, 0x00, 0x00, 0x00, 0x00,
+};
+
+/* the picture, centred, on black: the whole frame */
+static void
+sweet_splash_base(uint32_t *dst, unsigned int pitch, unsigned int w, unsigned int h)
+{
+	unsigned int x0 = (w - sweet_splash_w) / 2;
+	for (unsigned int y = 0; y < h; y++) {
+		uint32_t *row = (uint32_t *)((uintptr_t)dst + (uintptr_t)y * pitch);
+		unsigned int py = y - SPLASH_PIC_Y;
+		if (y < SPLASH_PIC_Y || py >= sweet_splash_h) {
+			for (unsigned int x = 0; x < w; x++) {
+				row[x] = 0xff000000u;
+			}
+			continue;
+		}
+		for (unsigned int x = 0; x < x0; x++) {
+			row[x] = 0xff000000u;
+		}
+		memcpy(row + x0, sweet_splash_pic + (size_t)py * sweet_splash_w, sweet_splash_w * 4);
+		for (unsigned int x = x0 + sweet_splash_w; x < w; x++) {
+			row[x] = 0xff000000u;
+		}
+	}
+}
+
+static void
+sweet_splash_first(void)
+{
+	static int parsed;
+	if (!parsed) {
+		parsed = 1;
+		uint64_t pa = 0;
+		if (PE_parse_boot_argn("sweet_splash", &pa, sizeof(pa)) && pa > 1) {
+			sweet_splash_pa = pa;
+		}
+	}
+	if (sweet_splash_pa == 0 || vinfo.v_baseaddr == 0 || vinfo.v_depth != 32 || sweet_splash_pic != NULL) {
+		return;
+	}
+	vm_offset_t m = ml_io_map_unmappable((vm_map_offset_t)(sweet_splash_pa & ~(uint64_t)PAGE_MASK),
+	    round_page(16 + (vm_size_t)vinfo.v_width * vinfo.v_height * 4 + PAGE_SIZE), VM_WIMG_WCOMB);
+	if (m == 0) {
+		return;
+	}
+	const uint32_t *hdr = (const uint32_t *)(m + (sweet_splash_pa & PAGE_MASK));
+	if (hdr[0] != 0x484c5053u || hdr[1] == 0 || hdr[1] > vinfo.v_width || hdr[2] == 0 ||
+	    SPLASH_PIC_Y + hdr[2] > vinfo.v_height) {
+		return;
+	}
+	sweet_splash_w = hdr[1];
+	sweet_splash_h = hdr[2];
+	sweet_splash_pic = hdr + 4;
+	sweet_splash_active = 1;
+	sweet_splash_base((uint32_t *)vinfo.v_baseaddr, vinfo.v_rowbytes, vinfo.v_width, vinfo.v_height);
+}
+
+/* one 8x16 glyph (iso_font: bit 0 is the left column), scaled */
+static void
+sweet_splash_glyph(uint32_t *f, unsigned int w, unsigned int h, int x0, int y0,
+    const unsigned char *g, int scale, uint32_t fg)
+{
+	for (int gy = 0; gy < 16; gy++) {
+		for (int gx = 0; gx < 8; gx++) {
+			if (!(g[gy] & (1u << gx))) {
+				continue;
+			}
+			for (int sy = 0; sy < scale; sy++) {
+				int y = y0 + gy * scale + sy;
+				for (int sx = 0; sx < scale; sx++) {
+					int x = x0 + gx * scale + sx;
+					if (x >= 0 && y >= 0 && (unsigned int)x < w && (unsigned int)y < h) {
+						f[(size_t)y * w + x] = fg;
+					}
+				}
+			}
+		}
+	}
+}
+
+/* the frame (or the rows y0..y1 of it) onto whatever the console draws to now */
+static void
+sweet_splash_show(const uint32_t *f, unsigned int y0, unsigned int y1)
+{
+	VCPUTC_LOCK_LOCK();
+	if (sweet_splash_active && vinfo.v_baseaddr != 0 && vinfo.v_depth == 32) {
+		unsigned int w = vinfo.v_width, h = vinfo.v_height;
+		if (y1 > h) {
+			y1 = h;
+		}
+		for (unsigned int y = y0; y < y1; y++) {
+			memcpy((void *)(vinfo.v_baseaddr + (vm_offset_t)y * vinfo.v_rowbytes), f + (size_t)y * w, w * 4);
+		}
+		/* AppleCLCD flips the console frame when it is dirty */
+		if (sweet_shadow_va != 0) {
+			sweet_dirty_top = 0;
+			sweet_dirty_bottom = vinfo.v_rows ? vinfo.v_rows : 1;
+		}
+	}
+	VCPUTC_LOCK_UNLOCK();
+}
+
+static void
+sweet_splash_sleep(unsigned int ms)
+{
+	delay_for_interval(ms, 1000 * 1000);
+}
+
+static void
+sweet_splash_line(uint32_t *f, unsigned int w, unsigned int h, int y, const char *s, int scale, uint32_t fg,
+    unsigned int ms)
+{
+	int x = ((int)w - (int)strlen(s) * 8 * scale) / 2;
+	for (; *s && sweet_splash_active; s++, x += 8 * scale) {
+		unsigned char ch = (unsigned char)*s;
+		if (ch == 1) {
+			sweet_splash_glyph(f, w, h, x, y, sweet_splash_heart, scale, SPLASH_HEART);
+		} else if (ch != ' ') {
+			sweet_splash_glyph(f, w, h, x, y, iso_font + ch * 16, scale, fg);
+		}
+		if (ms) {
+			sweet_splash_show(f, (unsigned int)y, (unsigned int)(y + 16 * scale));
+			sweet_splash_sleep(ms);
+		}
+	}
+}
+
+static void
+sweet_splash_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	unsigned int w = vinfo.v_width, h = vinfo.v_height;
+	vm_size_t size = (vm_size_t)w * h * 4;
+	uint32_t *f = kalloc_data(size, Z_WAITOK);
+	if (f == NULL) {
+		return;
+	}
+	sweet_splash_base(f, w * 4, w, h);
+	sweet_splash_line(f, w, h, (int)h - 150, "Hold VOL+ for Recovery", 2, SPLASH_GREY, 0);
+	sweet_splash_show(f, 0, h);
+
+	const unsigned int ms = 45;     /* per letter */
+	int y = 1220;
+	sweet_splash_line(f, w, h, y, "Thanks for using this port!", 4, 0xffffffffu, ms);
+	sweet_splash_line(f, w, h, y += 88, "Please consider donating", 4, 0xffffffffu, ms);
+	sweet_splash_line(f, w, h, y += 122, "#iOS4Sapphire", 5, 0xffffffffu, ms);
+	sweet_splash_line(f, w, h, y += 104, "Enjoy it!", 4, 0xffffffffu, ms);
+	sweet_splash_line(f, w, h, y += 110, "Made with \x01 by Angelpro09_Devv", 3, 0xffffffffu, ms);
+
+	/* kept on the panel until iOS's first frame (anything else drawing there is drawn over) */
+	for (unsigned int t = 0; sweet_splash_active && t < 600; t++) {
+		sweet_splash_show(f, 0, h);
+		sweet_splash_sleep(500);
+	}
+	kfree_data(f, size);
+}
+
+/* AppleCLCD, at iOS's first frame: stop painting; 1 if the boot screen was up */
+int sweet_splash_stop(void);
+int
+sweet_splash_stop(void)
+{
+	VCPUTC_LOCK_LOCK();
+	int was = sweet_splash_active;
+	sweet_splash_active = 0;
+	VCPUTC_LOCK_UNLOCK();
+	return was;
+}
+
+static void
+sweet_splash_start(void)
+{
+	static int started;
+	thread_t thread;
+	if (started || !sweet_splash_active) {
+		return;
+	}
+	started = 1;
+	if (kernel_thread_start(sweet_splash_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 /* Point the console at the shadow frame (same geometry as the boot one). */
 void
 sweet_console_retarget(vm_offset_t va)
