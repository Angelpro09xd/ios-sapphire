+/*
+ * sapphire 0299: called first thing in arm_init with the boot-args (no parsing services yet). With
+ * sweet_splash=<anything but 0> (the shim's boot screen is up) nothing but a panic is drawn.
+ */
+void
+sweet_early_cmdline(const char *cmdline)
+{
+	static const char key[] = "sweet_splash=";
+	for (unsigned int i = 0; cmdline != NULL && i < 608 && cmdline[i]; i++) {
+		if (i != 0 && cmdline[i - 1] != ' ') {
+			continue;
+		}
+		unsigned int k = 0;
+		while (key[k] && cmdline[i + k] == key[k]) {
+			k++;
+		}
+		if (key[k]) {
+			continue;
+		}
+		const char *v = cmdline + i + k;
+		if (*v != '\0' && *v != ' ' && !(v[0] == '0' && (v[1] == '\0' || v[1] == ' '))) {
+			early_quiet = 1;
+		}
+		return;
+	}
+}
