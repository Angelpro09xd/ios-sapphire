From 3d614d334e187bcc0b491cd42bbd3bc50fc0c199 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Wed, 21 Oct 2026 02:14:39 +0300
Subject: [PATCH 3/4] topaz-0142: TOPAZ_4K early screen console on the topaz
 splash framebuffer (VA=PA, then a KVA alias)

---
 osfmk/arm64/arm_vm_init.c | 49 +++++++++++++++++++++++++++++++++++++--
 osfmk/arm64/start.s       | 22 ++++++++++++++++++
 osfmk/arm64/sweet_early.c | 13 ++++-------
 3 files changed, 74 insertions(+), 10 deletions(-)

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 34537cf..b926886 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1825,6 +1825,44 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_ALIGNMENT_PADDING (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE)
 #endif
 
+#if defined(SWEET) && defined(TOPAZ_4K)
+/*
+ * 4 KiB pages: alias the topaz splash framebuffer (six 2 MB blocks) right
+ * above low globals, where the KVA has nothing, so the early console
+ * survives the TTBR0 teardown. Slots in use or no L2 table: no alias.
+ */
+#define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+static bool sweet_early_fb_mapped;
+
+static void
+sweet_early_map_final(void)
+{
+	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	if ((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		return;
+	}
+	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+	unsigned int first = (unsigned int)((va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
+	if (first + 6 > TTE_PGENTRIES) {
+		return;
+	}
+	for (unsigned int i = 0; i < 6; i++) {
+		if (l2[first + i] != ARM_TTE_EMPTY) {
+			return;
+		}
+	}
+	for (unsigned int i = 0; i < 6; i++) {
+		l2[first + i] = (0x5c000000ULL + i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
+	__asm__ volatile("dsb ishst" ::: "memory");
+	sweet_early_fb_mapped = true;
+}
+#endif
+
 #if defined(SWEET) && !defined(TOPAZ_4K)
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
@@ -2179,7 +2217,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	arm_set_user_tbi();
 
-#if defined(SWEET) && !defined(TOPAZ_4K)
+#if defined(SWEET)
 	/* phystokv() must still refer to the bootstrap aperture here. */
 	sweet_early_map_final();
 #endif
@@ -2188,7 +2226,14 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	ml_enable_monitor();
 
-#if defined(SWEET) && !defined(TOPAZ_4K)
+#if defined(SWEET) && defined(TOPAZ_4K)
+	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
+	if (sweet_early_fb_mapped) {
+		sweet_early_relocate(SWEET_EARLY_FB_VA);
+	} else {
+		sweet_early_disable();
+	}
+#elif defined(SWEET)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
 	sweet_early_relocate(SWEET_EARLY_FB_VA);
 #endif
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 0ab2cad..9fd1cb9 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -682,6 +682,28 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(SWEET) && defined(TOPAZ_4K)
+	/*
+	 * topaz splash framebuffer (0x5c000000, 1080x2400x4 = 10 MB) VA=PA as
+	 * Normal-NC: six 2 MB blocks in an L2 table of its own (L1 index 1;
+	 * RAM is at 0x140000000), for the early screen console.
+	 */
+	add		x2, x2, PGBYTES
+	MOV64	x10, 0x5c000000
+	create_l1_table_entry x10, x1, x2, x11, x12, x13
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x2, x12, lsl #(TTE_SHIFT)
+	mov		x12, #6
+Ltopaz_fb_block:
+	str		x11, [x13], #(1 << TTE_SHIFT)
+	add		x11, x11, #(ARM_TT_L2_SIZE)
+	subs	x12, x12, #1
+	b.ne	Ltopaz_fb_block
+#endif
+
 #if defined(SWEET) && !defined(TOPAZ_4K)
 	/*
 	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 2adaa7f..9429767 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -7,18 +7,15 @@
  */
 #include <arm64/sweet_early.h>
 
-#if defined(SWEET) && defined(TOPAZ_4K)
-/* 4 KiB pages: start.s does not map the splash framebuffer (16K block layout) */
-void sweet_early_putc(char c) { (void)c; }
-void sweet_early_mark(unsigned int stage, const char *label) { (void)stage; (void)label; }
-void sweet_early_panic(const char *fmt, va_list *args) { (void)fmt; (void)args; }
-void sweet_early_relocate(uint64_t base) { (void)base; }
-void sweet_early_disable(void) {}
-#elif defined(SWEET)
+#if defined(SWEET)
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
+#if defined(TOPAZ_4K)
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x5c000000;  /* topaz splash */
+#else
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+#endif
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
 #define EARLY_HEIGHT 2400u
-- 
