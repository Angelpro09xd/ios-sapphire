From 98853e2f9772d39aaec517f9b107ed1ede330648 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 19 Oct 2026 10:46:44 +0300
Subject: [PATCH] topaz-0107: display-only dcache clean (built for real), async
 panel brightness

---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 47 ++++++++++++++++++++-------
 osfmk/arm/caches.c                    | 40 ++++++++++++++++++-----
 osfmk/console/video_console.c         |  4 +--
 3 files changed, 68 insertions(+), 23 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 5a9f33c..989c16f 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -69,13 +69,14 @@ static AppleCLCD *sweet_cons_fb;
 static void sweet_cons_show(void);
 class OSDictionary;
 static void sweet_bl_log(const char *who, OSDictionary *d);
-extern "C" void flush_dcache64(addr64_t addr, unsigned count, int phys);  /* osfmk/arm/caches.c */
+extern "C" void sweet_dcache_clean(vm_offset_t addr, unsigned length);  /* osfmk/arm/caches.c */
 extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 
 #if defined(SWEET)
 #include <IOKit/IOService.h>
 #include <IOKit/IOUserClient.h>
 #include <libkern/c++/OSCollectionIterator.h>
+#include <kern/thread_call.h>
 #include <IOKit/IOKitKeys.h>
 #include <IOKit/IOLib.h>
 #include <IOKit/IOLocks.h>
@@ -190,6 +191,9 @@ public:
 	uint64_t      fDsiBufPhys;
 	IOLock       *fBlLock;
 	uint32_t      fBlLevel;       /* panel DBV 1..0x7ff, kept while the display is off */
+	uint32_t      fBlSent;        /* last level sent to the panel */
+	thread_call_t fBlCall;        /* sends the latest level off backboardd's thread */
+	static void   blWork(thread_call_param_t p0, thread_call_param_t p1);
 	bool          dsiDcsLong(const uint8_t *payload, uint32_t len);
 	bool          dsiSend(const uint8_t hdr[4], const uint8_t *payload, uint32_t len);
 	void          setPanelOn(bool on);
@@ -291,6 +295,8 @@ AppleCLCD::start(IOService *provider)
 	fDsiBufPhys = fDsiBuf ? fDsiBuf->getPhysicalSegment(0, NULL, kIOMemoryMapperNone) : 0;
 	fBlLock = IOLockAlloc();
 	fBlLevel = 0x133;                       /* panel init level (stock DT) */
+	fBlSent = ~0u;
+	fBlCall = thread_call_allocate(&AppleCLCD::blWork, this);
 	if (fDsi != NULL) {
 		IOLog("SWEET FB: DSI0 ctrl %#x, brightness via DCS 0x51\n", *(volatile uint32_t *)(fDsi + 0x004));
 		setProperty("IOMFBBrightnessLevel", (unsigned long long)(200u << 16), 32);
@@ -342,7 +348,7 @@ AppleCLCD::start(IOService *provider)
 		if (fCons != NULL) {
 			uint8_t *c = (uint8_t *)fCons->getBytesNoCopy();
 			memcpy(c, (const void *)fPixels, fsz);  /* keep what the console drew */
-			flush_dcache64((addr64_t)(uintptr_t)c, (unsigned)fsz, FALSE);   /* for panics */
+			sweet_dcache_clean((vm_offset_t)(uintptr_t)c, (unsigned)fsz);   /* for panics */
 			fConsPhys = fCons->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
 			sweet_cons_fb = this;
 			sweet_console_show_hook = sweet_cons_show;
@@ -582,7 +588,7 @@ AppleCLCD::dsiSend(const uint8_t hdr[4], const uint8_t *payload, uint32_t len)
 	if (len) {
 		memcpy(p + 4, payload, len);
 	}
-	flush_dcache64((addr64_t)(uintptr_t)p, 64, FALSE);
+	sweet_dcache_clean((vm_offset_t)(uintptr_t)p, 64);
 	uint32_t ctrl = dsi_rd(fDsi, 0x004), trig = dsi_rd(fDsi, 0x084);
 	if ((trig & 7) != 4) {
 		dsi_wr(fDsi, 0x084, (trig & ~7u) | 4);  /* DMA trigger: software */
@@ -596,10 +602,10 @@ AppleCLCD::dsiSend(const uint8_t hdr[4], const uint8_t *payload, uint32_t len)
 	dsi_wr(fDsi, 0x03c, dma & ~(1u << 26));          /* high speed */
 	dsi_wr(fDsi, 0x090, 1);                          /* SW trigger */
 	bool done = false;
-	for (int i = 0; i < 50 && !done; i++) {
+	for (int i = 0; i < 100 && !done; i++) {
 		done = (dsi_rd(fDsi, 0x110) & 1) != 0;
 		if (!done) {
-			IODelay(1000);
+			IODelay(200);
 		}
 	}
 	dsi_wr(fDsi, 0x110, dsi_rd(fDsi, 0x110) | 1);
@@ -661,14 +667,32 @@ AppleCLCD::setProperties(OSObject *properties)
 	}
 	IOLockLock(fLock);
 	fBlLevel = (uint32_t)level;
-	bool off = fPowerOff;
 	IOLockUnlock(fLock);
-	if (!off) {
-		setPanelLevel((uint32_t)level);
+	/*
+	 * CoreBrightness runs inside backboardd and ramps the level in many small
+	 * synchronous steps; waiting for the DSI here stalled rendering. Only note
+	 * the level; a thread call sends the latest one.
+	 */
+	if (fBlCall != NULL) {
+		thread_call_enter(fBlCall);
 	}
 	return kIOReturnSuccess;
 }
 
+void
+AppleCLCD::blWork(thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	AppleCLCD *fb = (AppleCLCD *)p0;
+	IOLockLock(fb->fLock);
+	uint32_t level = fb->fBlLevel;
+	bool off = fb->fPowerOff;
+	IOLockUnlock(fb->fLock);
+	if (!off && level != fb->fBlSent) {
+		fb->fBlSent = level;
+		fb->setPanelLevel(level);
+	}
+}
+
 static void
 sweet_bl_log(const char *who, OSDictionary *d)
 {
@@ -753,7 +777,7 @@ void
 AppleCLCD::flipBack(void)
 {
 	uint32_t idx = fFlipIdx ^ 1;
-	flush_dcache64((addr64_t)(uintptr_t)fFlip[idx]->getBytesNoCopy(), (unsigned)fFlip[idx]->getLength(), FALSE);
+	sweet_dcache_clean((vm_offset_t)(uintptr_t)fFlip[idx]->getBytesNoCopy(), (unsigned)fFlip[idx]->getLength());
 	scanFrom(fFlipPhys[idx], fRowBytes);
 	fFlipIdx = idx;
 }
@@ -815,8 +839,7 @@ AppleCLCD::directPresent(const uint8_t *rec)
 					flipFrom((const uint8_t *)(va + s->offset + (uint64_t)oy * s->bytesPerRow + (uint64_t)ox * 4),
 					    s->bytesPerRow);
 				} else {
-					flush_dcache64((addr64_t)(va + s->offset + (uint64_t)oy * s->bytesPerRow),
-					    (unsigned)((uint64_t)fHeight * s->bytesPerRow), FALSE);
+					sweet_dcache_clean((vm_offset_t)(va + s->offset + (uint64_t)oy * s->bytesPerRow), (unsigned)((uint64_t)fHeight * s->bytesPerRow));
 					scanFrom(pa, s->bytesPerRow);
 				}
 				ok = true;
@@ -1112,10 +1135,10 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 			IOLockUnlock(fFB->fLock);
 			if (changed && fFB->fDsi != NULL) {
 				if (off) {
-					fFB->setPanelLevel(1);
 					fFB->setPanelOn(false);
 				} else {
 					fFB->setPanelOn(true);
+					fFB->fBlSent = level;
 					fFB->setPanelLevel(level);
 				}
 			}
diff --git a/osfmk/arm/caches.c b/osfmk/arm/caches.c
index 6ef93ad..89d83a0 100644
--- a/osfmk/arm/caches.c
+++ b/osfmk/arm/caches.c
@@ -382,12 +382,15 @@ platform_cache_flush_wimg(
 
 #else   /* __ARM_COHERENT_IO__ */
 
-#if defined(ARM64_BOARD_CONFIG_SWEET)
 /*
- * topaz/sweet: Apple SoCs keep DMA coherent with the CPU caches, so these
- * are no-ops upstream. The Qualcomm display (MDP) and other masters here
- * read DRAM behind the caches: clean/invalidate to the point of coherency.
+ * topaz/sweet: Apple SoCs keep DMA coherent with the CPU caches, so
+ * flush_dcache/clean_dcache stay no-ops (making them real slowed the whole
+ * kernel to a crawl: XNU calls them on every pmap/IOMD path). Drivers whose
+ * hardware reads DRAM behind the caches (the MDP scanout, DSI command DMA)
+ * call sweet_dcache_clean() on just their buffers.
  */
+void sweet_dcache_clean(vm_offset_t addr, unsigned length);
+
 static void
 sweet_dcache_op(vm_offset_t addr, unsigned length, boolean_t phys, bool invalidate)
 {
@@ -412,18 +415,29 @@ sweet_dcache_op(vm_offset_t addr, unsigned length, boolean_t phys, bool invalida
 	__builtin_arm_dsb(DSB_SY);
 }
 
+
+#if 0
+
+#endif
+
 void
-flush_dcache(vm_offset_t addr, unsigned length, boolean_t phys)
+flush_dcache(
+	__unused vm_offset_t addr,
+	__unused unsigned length,
+	__unused boolean_t phys)
 {
-	sweet_dcache_op(addr, length, phys, true);
+	__builtin_arm_dsb(DSB_SY);
 }
 
 void
-clean_dcache(vm_offset_t addr, unsigned length, boolean_t phys)
+clean_dcache(
+	__unused vm_offset_t addr,
+	__unused unsigned length,
+	__unused boolean_t phys)
 {
-	sweet_dcache_op(addr, length, phys, false);
+	__builtin_arm_dsb(DSB_SY);
 }
-#else
+#if 0
 void
 flush_dcache(
 	__unused vm_offset_t addr,
@@ -534,3 +548,11 @@ platform_cache_flush_wimg(
 }
 
 #endif  /* __ARM_COHERENT_IO__ */
+
+/* topaz: display/DSI buffers (MDP and DSI DMA read DRAM behind the caches) */
+void sweet_dcache_clean(vm_offset_t addr, unsigned length);
+void
+sweet_dcache_clean(vm_offset_t addr, unsigned length)
+{
+	clean_dcache(addr, length, FALSE);
+}
diff --git a/osfmk/console/video_console.c b/osfmk/console/video_console.c
index df9605e..4193f57 100644
--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -147,7 +147,7 @@ static struct {
  * iOS surfaces; each drawn text row is cleaned to memory right away, so text
  * appears at cache speed and stays visible in a panic.
  */
-extern void flush_dcache64(addr64_t addr, unsigned count, int phys);
+extern void sweet_dcache_clean(vm_offset_t addr, unsigned length);
 void sweet_console_retarget(vm_offset_t va);
 void (*sweet_console_show_hook)(void);
 static vm_offset_t sweet_shadow_va;
@@ -3345,7 +3345,7 @@ sweet_flush_rows(unsigned int top, unsigned int bottom)
 		}
 		return;
 	}
-	flush_dcache64((addr64_t)(vinfo.v_baseaddr + top * band), (unsigned)((bottom - top) * band), FALSE);
+	sweet_dcache_clean((vm_offset_t)(vinfo.v_baseaddr + top * band), (unsigned)((bottom - top) * band));
 	if (sweet_console_show_hook != NULL) {
 		sweet_console_show_hook();
 	}
-- 
