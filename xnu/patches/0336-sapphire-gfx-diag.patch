+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	OSAddAtomic64(1, (volatile SInt64 *)&t->n);
+	OSAddAtomic64((SInt64)ns, (volatile SInt64 *)&t->ns);
+	if (ns > t->max) {
+		t->max = ns;
+	}
+}
