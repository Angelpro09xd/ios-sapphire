+		{ "swap to flip (ms <2 <4 <8 <12 <16 <24 <32 <48 <64 <100 <200 more; us)", &sweet_fbd.swap_to_flip, 12 },
+		{ "tick late (us <50 <100 <200 <400 <800 <1600 <3200 <6400 <12800 more)", &sweet_fbd.tick_late, 10 },
