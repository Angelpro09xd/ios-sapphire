From c9c3ee8f11bcc2a372b70dee421c3719577dbe73 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Tue, 20 Oct 2026 06:46:08 +0000
Subject: [PATCH] sapphire-0128: IORPC.kernelContent for Xcode 16+ iig

Newer iig dispatch stubs take the decoded IORPCMessage from
IORPC.kernelContent (added in later xnu); xnu-8796 has no such field.
Add it (kernel only) and fill it where the kernel builds an IORPC from
a user message, as later xnu does, so the kernel builds with the
Xcode 16 that hosted macOS CI still offers.
---
 iokit/DriverKit/IORPC.h       | 5 +++++
 iokit/IOKit/IORPC.h           | 5 +++++
 iokit/Kernel/IOUserServer.cpp | 3 ++-
 3 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/iokit/DriverKit/IORPC.h b/iokit/DriverKit/IORPC.h
index 3ded78c..c95c58c 100644
--- a/iokit/DriverKit/IORPC.h
+++ b/iokit/DriverKit/IORPC.h
@@ -224,6 +224,11 @@ struct IORPC {
 	IORPCMessageMach * reply;
 	uint32_t           sendSize;
 	uint32_t           replySize;
+#ifdef KERNEL
+	/* sapphire: newer iig (Xcode 16+) dispatch stubs read the decoded
+	 * message from here instead of calling IORPCMessageFromMach() */
+	IORPCMessage     * kernelContent;
+#endif /* KERNEL */
 };
 typedef struct IORPC IORPC;
 
diff --git a/iokit/IOKit/IORPC.h b/iokit/IOKit/IORPC.h
index 3ded78c..c95c58c 100644
--- a/iokit/IOKit/IORPC.h
+++ b/iokit/IOKit/IORPC.h
@@ -224,6 +224,11 @@ struct IORPC {
 	IORPCMessageMach * reply;
 	uint32_t           sendSize;
 	uint32_t           replySize;
+#ifdef KERNEL
+	/* sapphire: newer iig (Xcode 16+) dispatch stubs read the decoded
+	 * message from here instead of calling IORPCMessageFromMach() */
+	IORPCMessage     * kernelContent;
+#endif /* KERNEL */
 };
 typedef struct IORPC IORPC;
 
diff --git a/iokit/Kernel/IOUserServer.cpp b/iokit/Kernel/IOUserServer.cpp
index 5d1d922..1406bef 100644
--- a/iokit/Kernel/IOUserServer.cpp
+++ b/iokit/Kernel/IOUserServer.cpp
@@ -3209,7 +3209,7 @@ IOUserServer::server(ipc_kmsg_t requestkmsg, ipc_kmsg_t * pReply)
 		msgout = (typeof(msgout))ikm_header(replykmsg);
 	}
 
-	IORPC rpc = { .message = msgin, .reply = msgout, .sendSize = msgin->msgh.msgh_size, .replySize = replyAlloc };
+	IORPC rpc = { .message = msgin, .reply = msgout, .sendSize = msgin->msgh.msgh_size, .replySize = replyAlloc, .kernelContent = message };
 
 	if (object) {
 		kern_allocation_name_t prior;
@@ -3358,6 +3358,7 @@ IOUserServerUEXTTrap(OSObject * object, void * p1, void * p2, void * p3, void *
 	rpc.sendSize  = mach->msgh.msgh_size;
 	rpc.reply     = (IORPCMessageMach *) (p + inSize);
 	rpc.replySize = ((uint32_t) (sizeof(buffer.buffer) - inSize));    // inSize was checked
+	rpc.kernelContent = message;
 
 	message->objects[0] = 0;
 	if ((action = OSDynamicCast(OSAction, object))) {
-- 
