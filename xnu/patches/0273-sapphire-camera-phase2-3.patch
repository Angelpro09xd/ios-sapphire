 sysctl_sweet_cam SYSCTL_HANDLER_ARGS
 {
@@ -610,6 +1288,21 @@ sysctl_sweet_cam SYSCTL_HANDLER_ARGS
 	case 9:
 		r = cam_off();
 		break;
+	case 10:
