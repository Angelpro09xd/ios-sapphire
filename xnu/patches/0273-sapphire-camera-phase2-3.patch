+/* ================================================================ 0272: phases 2 and 3 */
+
+/*
+ * camera.md sections 5-11: the sensor's init/mode/stream tables over CCI (op 10), CSIPHY + PPI +
+ * CSID0 RDI0 with the packet counters (op 11, no DMA), TFE0 RDI0 + bus write master 7 into the
+ * frame pool through an identity SMMU bank (op 12), stop (op 13), the pool's pattern test (op 14);
+ * kern.sweet_cam_seek + kern.sweet_cam_frame hand the frame to user space in 1 MB pieces.
+ * kern.sweet_cam_arg: op 10: bits 0-3 slot (0 main S5KHM6, 2 ultra wide S5K4H7), bits 4-7 mode
+ * (HM6 0/1/4, 4H7 0); op 11: bits 8-15 the CSIPHY settle count (0: the sensor's own); op 14: 1
+ * checks the pattern without writing it.
+ */
+#include "sweet_cam_tables.h"
+
+extern void *topaz_map_wc(uint64_t pa, uint64_t size);                                  /* TopazModem.cpp */
+extern int topaz_smmu_identity(uint32_t sid, uint32_t mask, const char *name);         /* TopazModem.cpp */
+extern int topaz_rpm_ldo(uint32_t id, uint32_t uv, uint32_t ma, uint32_t set);         /* TopazModem.cpp */
+extern unsigned long gPhysBase, gPhysSize;
+
+#define CAM_POOL_PA     0xD7000000ull
+#define CAM_POOL_SIZE   0x09000000ull           /* 144 MB, to the modem pool at 0xE0000000 */
+#define CSIPHY_PA(n)    (0x05C52000u + 0x2000u * (n))
+#define PPI_PA          0x05CB3000u             /* PPI n at +0x200 n */
+#define CSID0_PA        0x05C6E000u             /* CSID0 at +0, TFE0 at +0x1000 */
+#define SMMU_PA         0x0C600000u
+#define TFE_SID         0x400
+
+
+/* ---------------------------------------------------------------- CCI batches (queue 0) */
+
+struct cci_batch {
+	unsigned m, addr, n, cmds;
+	uint32_t w[64];
+	bool checked;
+};
+
+static bool
+cci_flush(struct cci_batch *b)
+{
+	if (b->n == 0) {
+		return true;
+	}
+	unsigned m = b->m, q = 0;
+	wr(cci, CCI_Q(m, q) + 0x10, 0x1u | (b->addr & 0x7f) << 4 | 3u << 16);          /* SET_PARAM */
+	wr(cci, CCI_Q(m, q) + 0x10, 0x6u);                                               /* LOCK */
+	for (unsigned i = 0; i < b->n; i++) {
+		wr(cci, CCI_Q(m, q) + 0x10, b->w[i]);
+	}
+	wr(cci, CCI_Q(m, q) + 0x10, 0x7u);                                               /* UNLOCK */
+	wr(cci, CCI_Q(m, q) + 0x10, 0x8u | 1u << 8);                                     /* REPORT */
+	if (!b->checked) {
+		uint32_t cnt = rd(cci, CCI_Q(m, q) + 0x4);
+		camlog("CCI m%u q0: %u words loaded, CUR_WORD_CNT %u", m, b->n + 4, cnt);
+		if (cnt != b->n + 4) {
+			camlog("CCI queue 0 does not hold them: stop");
+			(void)cci_reset();
+			return false;
+		}
+		b->checked = true;
+	}
+	bool ok = cci_run(m, q, m == 0 ? 1u << 4 : 1u << 16, "batch write");
+	b->n = 0;
+	return ok;
+}
+
+/* one I2C write: cmd byte 0x9|len<<4, then len bytes (2 address bytes first), packed LE in words */
+static bool
+cci_put(struct cci_batch *b, const uint8_t *bytes, unsigned len)
+{
+	uint8_t c[12];
+	c[0] = (uint8_t)(0x9u | len << 4);
+	memcpy(c + 1, bytes, len);
+	unsigned words = (len + 1 + 3) / 4;
+	if (b->n + words > 58 && !cci_flush(b)) {   /* + SET_PARAM, LOCK, UNLOCK, REPORT <= 64 */
+		return false;
+	}
+	for (unsigned i = 0; i < words; i++) {
+		uint32_t v = 0;
+		for (unsigned j = 0; j < 4; j++) {
+			unsigned k = i * 4 + j;
+			v |= (uint32_t)(k < len + 1 ? c[k] : 0) << (8 * j);
+		}
+		b->w[b->n++] = v;
+	}
+	b->cmds++;
+	return true;
+}
+
+static int
+cam_replay(unsigned m, unsigned addr, const struct cam_reg *t, unsigned n, const char *name)
+{
+	struct cci_batch b;
+	unsigned bursts = 0, bbytes = 0, i = 0;
+	uint64_t t0 = mach_absolute_time(), ns;
+	bzero(&b, sizeof(b));
+	b.m = m;
+	b.addr = addr;
+	for (i = 0; i < n; i++) {
+		uint8_t x[11];
+		x[0] = (uint8_t)(t[i].addr >> 8);
+		x[1] = (uint8_t)t[i].addr;
+		if (t[i].blen != 0) {
+			/* a burst: auto-increment, so 9-byte pieces at addr + k */
+			for (unsigned k = 0; k < t[i].blen; k += 9) {
+				unsigned c = t[i].blen - k < 9 ? t[i].blen - k : 9;
+				unsigned a = t[i].addr + k;
+				x[0] = (uint8_t)(a >> 8);
+				x[1] = (uint8_t)a;
+				memcpy(x + 2, cam_burst + t[i].boff + k, c);
+				if (!cci_put(&b, x, 2 + c)) {
+					goto fail;
+				}
+			}
+			bursts++;
+			bbytes += t[i].blen;
+		} else if (t[i].dt == 2) {
+			x[2] = (uint8_t)(t[i].val >> 8);
+			x[3] = (uint8_t)t[i].val;
+			if (!cci_put(&b, x, 4)) {
+				goto fail;
+			}
+		} else {
+			x[2] = (uint8_t)t[i].val;
+			if (!cci_put(&b, x, 3)) {
+				goto fail;
+			}
+		}
+		if (t[i].delay_ms != 0) {
+			if (!cci_flush(&b)) {
+				goto fail;
+			}
+			IOSleep(t[i].delay_ms);
+		}
+	}
+	if (!cci_flush(&b)) {
+		goto fail;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	camlog("%s: %u entries (%u bursts, %u bytes), %u I2C writes, %llu ms", name, n, bursts, bbytes, b.cmds, ns / 1000000);
+	return 0;
+fail:
+	camlog("%s: stopped at entry %u of %u (%u I2C writes done)", name, i, n, b.cmds);
+	return EIO;
+}
+
+/* ---------------------------------------------------------------- op 10: sensor init, mode, stream on */
+
+static int
+cam_sensor_on(void)
+{
+	unsigned slot = (unsigned)cam_arg & 0xF, mode = ((unsigned)cam_arg >> 4) & 0xF;
+	const struct cam_reg *mt;
+	unsigned mn;
+	uint8_t id[2];
+	int r;
+
+	if (!camss_up || slot > 3 || !slot_up[slot]) {
+		camlog("op 10: slot %u is not powered (op 2..5 first)", slot);
+		return EAGAIN;
+	}
+	if (slot == 0) {
+		if (mode == 0) {
+			mt = hm6_mode0; mn = sizeof(hm6_mode0) / sizeof(hm6_mode0[0]); cs.w = 12000; cs.h = 9000;
+		} else if (mode == 1) {
+			mt = hm6_mode1; mn = sizeof(hm6_mode1) / sizeof(hm6_mode1[0]); cs.w = 4000; cs.h = 3000;
+		} else if (mode == 4) {
+			mt = hm6_mode4; mn = sizeof(hm6_mode4) / sizeof(hm6_mode4[0]); cs.w = 4000; cs.h = 3000;
+		} else {
+			camlog("op 10: HM6 mode %u not built in (0, 1, 4)", mode);
+			return EINVAL;
+		}
+		cs.phy = 0; cs.cphy = true; cs.settle = 0x32;
+		if (!cci_read(0, 0x10, 0x0000, id, 2) || (id[0] << 8 | id[1]) != 0x1AD6) {
+			camlog("op 10: no S5KHM6 at m0 0x10: stop");
+			return ENODEV;
+		}
+		r = cam_replay(0, 0x10, hm6_init, sizeof(hm6_init) / sizeof(hm6_init[0]), "HM6 init");
+		r = r ? r : cam_replay(0, 0x10, mt, mn, "HM6 mode");
+		r = r ? r : cam_replay(0, 0x10, hm6_on, sizeof(hm6_on) / sizeof(hm6_on[0]), "HM6 stream on");
+	} else if (slot == 2) {
+		if (mode != 0) {
+			camlog("op 10: S5K4H7 mode %u not built in (0)", mode);
+			return EINVAL;
+		}
+		cs.w = 3264; cs.h = 2448; cs.phy = 1; cs.cphy = false; cs.settle = 0x0E;
+		if (!cci_read(1, 0x2D, 0x0000, id, 2) || (id[0] << 8 | id[1]) != 0x487B) {
+			camlog("op 10: no S5K4H7 at m1 0x2d: stop");
+			return ENODEV;
+		}
+		r = cam_replay(1, 0x2D, h7_init, sizeof(h7_init) / sizeof(h7_init[0]), "4H7 init");
+		r = r ? r : cam_replay(1, 0x2D, h7_mode0, sizeof(h7_mode0) / sizeof(h7_mode0[0]), "4H7 mode 0");
+		r = r ? r : cam_replay(1, 0x2D, h7_on, sizeof(h7_on) / sizeof(h7_on[0]), "4H7 stream on");
+	} else {
+		camlog("op 10: slot %u has no tables yet (0 main, 2 ultra wide)", slot);
+		return EINVAL;
+	}
+	cs.slot = slot;
+	cs.mode = mode;
+	cam_streaming = r == 0;
+	camlog("op 10: slot %u mode %u (%ux%u RAW10, %u bytes a frame): %s", slot, mode, cs.w, cs.h, cs.w * cs.h * 10 / 8,
+	    r == 0 ? "streaming" : "FAILED");
+	return r;
+}
+
+/* ---------------------------------------------------------------- op 11: CSIPHY, PPI, CSID0 RDI0 */
+
+static void
+phy_w(uint32_t off, uint32_t v, unsigned delay_ms)
+{
+	wr(cam_phy, off, v);
+	if (delay_ms) {
+		IOSleep(delay_ms);
+	}
+}
+
+static void
+phy_dphy_lane(uint32_t blk, uint32_t hi, unsigned settle)
+{
+	/* lane block blk (0x000/0x200/0x400/0x600), its 0x9xx-style registers at hi (0x900/0xA00/0xB00/0xC00) */
+	phy_w(blk + 0x030, 0x00, 0); phy_w(hi + 0x00, 0x05, 0); phy_w(hi + 0x08, 0x10, 0); phy_w(hi + 0x04, 0x00, 0);
+	phy_w(hi + 0x04, 0x07, 0); phy_w(blk + 0x004, 0x0C, 0); phy_w(blk + 0x02C, 0x01, 0); phy_w(blk + 0x034, 0x07, 0);
+	phy_w(blk + 0x010, 0x02, 0); phy_w(blk + 0x01C, 0x08, 0); phy_w(blk + 0x03C, 0xB8, 0); phy_w(blk + 0x008, settle, 0);
+	phy_w(blk + 0x000, 0x8D, 0); phy_w(blk + 0x038, 0xFE, 0); phy_w(blk + 0x014, 0x80, 0); phy_w(0x800, 0x02, 0);
+	phy_w(0x884, 0x01, 0);
+}
+
+static void
+phy_cphy_trio(uint32_t lo, uint32_t hi, unsigned settle)
+{
+	/* trio: 0x1xx registers at lo (0x100/0x300/0x500), 0x9xx at hi (0x900/0xA00/0xB00) */
+	phy_w(hi + 0x90, 0x00, 0); phy_w(hi + 0x94, 0x00, 0); phy_w(hi + 0x98, 0x00, 0); phy_w(hi + 0x90, 0x08, 0);
+	phy_w(hi + 0x94, 0x08, 0); phy_w(hi + 0x98, 0x1A, 0); phy_w(hi + 0x8C, 0xAF, 1);
+	phy_w(lo + 0x5C, 0x46, 0); phy_w(lo + 0x68, 0xA0, 0); phy_w(lo + 0x04, 0x06, 0); phy_w(lo + 0x0C, settle & 0xff, 0);
+	phy_w(lo + 0x08, (settle >> 8) & 0xff, 0); phy_w(lo + 0x14, 0x20, 0); phy_w(lo + 0x50, 0x00, 0);
+	phy_w(lo + 0x88, 0x00, 0); phy_w(lo + 0x8C, 0x7F, 0); phy_w(lo + 0x90, 0x7F, 0); phy_w(lo + 0x18, 0x3E, 0);
+	phy_w(lo + 0x1C, 0x41, 0); phy_w(lo + 0x20, 0x41, 0); phy_w(lo + 0x24, 0x7F, 0); phy_w(lo + 0x28, 0x00, 0);
+	phy_w(lo + 0x2C, 0x00, 0); phy_w(lo + 0x60, 0x02, 0); phy_w(lo + 0xCC, 0x41, 0); phy_w(lo + 0xDC, 0x50, 0);
+	phy_w(hi + 0x84, 0x20, 0); phy_w(hi + 0x88, 0x05, 0); phy_w(hi + 0x80, 0x60, 0); phy_w(hi + 0xAC, 0x35, 0);
+	phy_w(hi + 0xB0, 0x01, 0); phy_w(0x800, 0x0E, 0); phy_w(0x884, 0x01, 0);
+}
+
+static void
+phy_status(const char *when)
+{
+	uint32_t v[11];
+	for (unsigned i = 0; i < 11; i++) {
+		v[i] = rd(cam_phy, 0x8B0 + 4 * i);
+	}
+	camlog("CSIPHY%u status %s: %x %x %x %x %x %x %x %x %x %x %x", cs.phy, when, v[0], v[1], v[2], v[3], v[4], v[5], v[6],
+	    v[7], v[8], v[9], v[10]);
+	for (unsigned i = 0; i < 11; i++) {
+		wr(cam_phy, 0x858 + 4 * i, v[i]);
+	}
+	wr(cam_phy, 0x828, 1);
+	wr(cam_phy, 0x828, 0);
+}
+
+static void
+csid_counters(const char *when)
+{
+	uint32_t rx = rd(cam_csid, 0x020), rdi = rd(cam_csid, 0x040);
+	camlog("CSID %s: packets %u, ECC %u, CRC %u; rx irq %#x, rdi0 irq %#x (SOF %u EOF %u ovf %u), rdi0 bytes %u/%u, rdi0 status %#x",
+	    when, rd(cam_csid, 0x160), rd(cam_csid, 0x164), rd(cam_csid, 0x168), rx, rdi, (rdi >> 12) & 1, (rdi >> 9) & 1,
+	    (rdi >> 2) & 1, rd(cam_csid, 0x3E0), rd(cam_csid, 0x3E4), rd(cam_csid, 0x350));
+	wr(cam_csid, 0x028, rx);
+	wr(cam_csid, 0x048, rdi);
+	wr(cam_csid, 0x080, 1);
+}
+
+static int
+cam_link_on(void)
+{
+	unsigned n;
+	if (!cam_streaming) {
+		camlog("op 11: no stream (op 10 first)");
+		return EAGAIN;
+	}
+	n = cs.phy;
+	unsigned settle = ((unsigned)cam_arg >> 8) & 0xff;
+	settle = settle != 0 ? settle : cs.settle;
+	int l4 = topaz_rpm_ldo(4, 880000, 100, 0), l18 = topaz_rpm_ldo(18, 1232000, 100, 0);
+	camlog("CSIPHY rails: RPM ldoa4 0.88 V %d, ldoa18 1.232 V %d (0: taken)", l4, l18);
+	if (l4 != 0 || l18 != 0) {
+		return EIO;
+	}
+	static const uint32_t cbcr_cphy[3] = { 0x52088u, 0x5208Cu, 0x52090u };
+	if (!rcg_set("tfe_cphy_rx 300 MHz", 0x52064u, 0x103) || !branch_on("cphy", cbcr_cphy[n]) ||
+	    !rcg_set("csiphytimer 300 MHz", 0x59000u + 0x1Cu * n, 0x201) || !branch_on("csiphytimer", 0x59018u + 0x1Cu * n) ||
+	    !rcg_set("tfe_0_csid 300 MHz", 0x52094u, 0x103) || !branch_on("tfe_0_csid", 0x520ACu) ||
+	    !branch_on("tfe_0_cphy_rx", 0x5207Cu) || !rcg_set("tfe_0 300 MHz", 0x52004u, 0x103) ||
+	    !branch_on("tfe_0", 0x5201Cu)) {
+		return EIO;
+	}
+	cam_phy = ml_io_map(CSIPHY_PA(n), 0x2000);
+	if (cam_ppi == 0) {
+		cam_ppi = ml_io_map(PPI_PA, 0x1000);
+		cam_csid = ml_io_map(CSID0_PA, 0x5000);
+	}
+	if (cam_phy == 0 || cam_ppi == 0 || cam_csid == 0) {
+		camlog("CSIPHY/PPI/CSID not mapped");
+		return EIO;
+	}
+	camlog("CSIPHY%u: %s, settle %#x", n, cs.cphy ? "C-PHY 3 trios" : "D-PHY 4 lanes", settle);
+	/* reset, common */
+	phy_w(0x814, 0x00, 5); phy_w(0x818, 0x00, 0); phy_w(0x81C, 0x00, 0); phy_w(0x800, 0x01, 1); phy_w(0x800, 0x00, 0);
+	if (cs.cphy) {
+		phy_w(0x814, 0x2A, 0); phy_w(0x818, 0x01, 0); phy_w(0x81C, 0x52, 0); phy_w(0x800, 0x03, 1); phy_w(0x800, 0x0E, 0);
+		phy_cphy_trio(0x100, 0x900, settle);
+		phy_cphy_trio(0x300, 0xA00, settle);
+		phy_cphy_trio(0x500, 0xB00, settle);
+		/* data rate <= 10.26 Gbps */
+		phy_w(0x9B4, 0x02, 1); phy_w(0xAB4, 0x02, 1); phy_w(0xBB4, 0x02, 1);
+		for (uint32_t lo = 0x100; lo <= 0x500; lo += 0x200) {
+			phy_w(lo + 0x44, 0xB2, 0); phy_w(lo + 0x64, 0x33, 0); phy_w(lo + 0x6C, 0x25, 0);
+		}
+	} else {
+		phy_w(0x814, 0xD5, 0); phy_w(0x818, 0x01, 0); phy_w(0x81C, 0x02, 0); phy_w(0x800, 0x03, 1); phy_w(0x800, 0x02, 0);
+		phy_dphy_lane(0x000, 0x900, settle);
+		/* clock lane */
+		phy_w(0x730, 0x00, 0); phy_w(0xC80, 0x05, 0); phy_w(0xC88, 0x10, 0); phy_w(0xC84, 0x00, 0); phy_w(0xC84, 0x07, 0);
+		phy_w(0x704, 0x0C, 0); phy_w(0x72C, 0x01, 0); phy_w(0x734, 0x07, 0); phy_w(0x710, 0x02, 0); phy_w(0x71C, 0x08, 0);
+		phy_w(0x73C, 0xB8, 0); phy_w(0x708, settle, 0); phy_w(0x700, 0x80, 0); phy_w(0x70C, 0xA5, 0); phy_w(0x738, 0x1F, 0);
+		phy_w(0x714, 0x80, 0); phy_w(0x728, 0x04, 0); phy_w(0x800, 0x02, 0); phy_w(0x884, 0x01, 0);
+		phy_dphy_lane(0x200, 0xA00, settle);
+		phy_dphy_lane(0x400, 0xB00, settle);
+		phy_dphy_lane(0x600, 0xC00, settle);
+	}
+	static const uint8_t irqm[11] = { 0xFF, 0xFF, 0xFB, 0xFF, 0x7F, 0xFF, 0xFF, 0xEF, 0xFF, 0xFF, 0xFF };
+	for (unsigned i = 0; i < 11; i++) {
+		phy_w(0x82C + 4 * i, irqm[i], 0);
+	}
+	phy_status("after config");
+
+	/* PPI n */
+	vm_offset_t p = cam_ppi + 0x200u * n;
+	camlog("PPI%u hw version %#x", n, rd(p, 0x00));
+	wr(p, 0x6C, 0); wr(p, 0x70, 1); wr(p, 0x7C, 1); wr(p, 0x78, 2);
+	bool rst = false;
+	for (int i = 0; i < 100 && !rst; i++) {
+		rst = (rd(p, 0x68) & 1) != 0;
+		if (!rst) {
+			IODelay(100);
+		}
+	}
+	wr(p, 0x74, 1); wr(p, 0x78, 1);
+	wr(p, 0x6C, 0x0E); wr(p, 0x74, 1); wr(p, 0x78, 1); wr(p, 0x60, cs.cphy ? 0x73 : 0x70);
+	camlog("PPI%u: reset %s, module cfg %#x", n, rst ? "done" : "NOT acknowledged", rd(p, 0x60));
+
+	/* CSID0 */
+	camlog("CSID0 hw version %#x", rd(cam_csid, 0x000));
+	wr(cam_csid, 0x074, 0); wr(cam_csid, 0x078, 1); wr(cam_csid, 0x080, 1); wr(cam_csid, 0x010, 0x1E);
+	rst = false;
+	for (int i = 0; i < 1000 && !rst; i++) {
+		rst = (rd(cam_csid, 0x070) & 1) != 0;
+		if (!rst) {
+			IODelay(100);
+		}
+	}
+	wr(cam_csid, 0x078, 1); wr(cam_csid, 0x080, 1);
+	if (!rst) {
+		camlog("CSID0: no reset done in 100 ms (top irq %#x): stop", rd(cam_csid, 0x070));
+		return EIO;
+	}
+	wr(cam_csid, 0x028, 0x0FFFFFFF); wr(cam_csid, 0x048, 0x3FFFF); wr(cam_csid, 0x080, 1);
+	uint32_t cfg0 = cs.cphy ? 0x01102102u : 0x00232103u;
+	wr(cam_csid, 0x100, cfg0);
+	wr(cam_csid, 0x104, 0x41);
+	wr(cam_csid, 0x024, 0x09BFB8FF);
+	wr(cam_csid, 0x300, 0x002BF005); wr(cam_csid, 0x304, 0x2); wr(cam_csid, 0x3B0, 0x9); wr(cam_csid, 0x308, 0);
+	wr(cam_csid, 0x300, 0x802BF005);
+	wr(cam_csid, 0x108, 1);                         /* capture the first long packet */
+	wr(cam_csid, 0x308, 1);
+	wr(cam_csid, 0x044, 0x61206);
+	camlog("CSID0: rx cfg0 %#x cfg1 %#x, RDI0 cfg0 %#x, resumed", rd(cam_csid, 0x100), rd(cam_csid, 0x104), rd(cam_csid, 0x300));
+	cam_csid_up = true;
+	for (int i = 0; i < 5; i++) {
+		IOSleep(100);
+		csid_counters(i == 0 ? "+100 ms" : i == 4 ? "+500 ms" : "...");
+	}
+	camlog("CSID0 long packet: %#x %#x %#x (word count = bytes a line: %u expected)", rd(cam_csid, 0x130),
+	    rd(cam_csid, 0x134), rd(cam_csid, 0x138), cs.w * 10 / 8);
+	phy_status("streaming");
+	return 0;
+}
+
+/* ---------------------------------------------------------------- op 12: TFE0 RDI0 + WM7, one frame */
+
+static void
+cam_smmu_report(const char *when)
+{
+	if (cam_smmu == 0) {
+		cam_smmu = ml_io_map(SMMU_PA, 0x80000);
+	}
+	if (cam_smmu == 0) {
+		return;
+	}
+	uint32_t id0 = rd(cam_smmu, 0x20), id1 = rd(cam_smmu, 0x24), nsmr = id0 & 0xFF;
+	uint32_t psize = (id1 & (1u << 31)) ? 0x10000 : 0x1000, npage = 1u << (((id1 >> 28) & 7) + 1);
+	for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+		uint32_t smr = rd(cam_smmu, 0x800 + 4 * i);
+		if ((smr >> 31) != 0 && (smr & 0x7FFF) == TFE_SID) {
+			uint32_t s2cr = rd(cam_smmu, 0xC00 + 4 * i), cb = s2cr & 0x3F;
+			vm_offset_t cbp = cam_smmu + (vm_offset_t)npage * psize + (vm_offset_t)cb * psize;
+			if ((uint64_t)(npage + cb + 1) * psize > 0x80000) {
+				return;
+			}
+			camlog("SMMU %s: SMR%u %#x S2CR %#x CB%u SCTLR %#x FSR %#x FAR %#x%08x", when, i, smr, s2cr, cb, rd(cbp, 0x0),
+			    rd(cbp, 0x58), rd(cbp, 0x64), rd(cbp, 0x60));
+			return;
+		}
+	}
+	camlog("SMMU %s: no SMR for stream %#x", when, TFE_SID);
+}
+
+static bool
+cam_pool_map(void)
+{
+	if (cam_pool != NULL) {
+		return true;
+	}
+	if (CAM_POOL_PA < gPhysBase + gPhysSize && CAM_POOL_PA + CAM_POOL_SIZE > gPhysBase) {
+		camlog("pool %llx-%llx overlaps kernel RAM %lx-%lx: stop", CAM_POOL_PA, CAM_POOL_PA + CAM_POOL_SIZE, gPhysBase,
+		    gPhysBase + gPhysSize);
+		return false;
+	}
+	cam_pool = (uint8_t *)topaz_map_wc(CAM_POOL_PA, CAM_POOL_SIZE);
+	camlog("pool %llx-%llx (kernel RAM %lx-%lx): %s", CAM_POOL_PA, CAM_POOL_PA + CAM_POOL_SIZE, gPhysBase,
+	    gPhysBase + gPhysSize, cam_pool ? "mapped write-combined" : "NOT mapped");
+	return cam_pool != NULL;
+}
+
+static int
+cam_capture(void)
+{
+	uint32_t bytes = cs.w * cs.h * 10 / 8;
+	if (!cam_csid_up) {
+		camlog("op 12: CSID not up (op 11 first)");
+		return EAGAIN;
+	}
+	if (!cam_pool_map() || bytes > CAM_POOL_SIZE) {
+		return ENOMEM;
+	}
+	memset(cam_pool, 0xA5, 4096);
+	memset(cam_pool + bytes - 4096, 0xA5, 4096);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	cam_smmu_report("before");
+	if (!topaz_smmu_identity(TFE_SID, 0, "TFE")) {
+		camlog("op 12: the TFE's identity bank did not read back: stop");
+		return EIO;
+	}
+	cam_smmu_report("identity");
+	vm_offset_t t = cam_csid;
+	wr(t, 0x308, 0);                                /* RDI0 halt at the frame boundary while the TFE is set up */
+	camlog("TFE0 hw version %#x", rd(t, 0x1000));
+	wr(t, 0x1034, 0xFFFFFFFF); wr(t, 0x1038, 0xFFFFFFFF); wr(t, 0x103C, 0xFFFFFFFF);
+	wr(t, 0x1040, 0xFFFFFFFF); wr(t, 0x1044, 0xFFFFFFFF); wr(t, 0x1048, 0xFFFFFFFF); wr(t, 0x1030, 1);
+	wr(t, 0x1A18, 0xFFFFFFFF); wr(t, 0x1A1C, 0xFFFFFFFF);
+	wr(t, 0x1A20, 0xFFFFFFFF); wr(t, 0x1A24, 0xFFFFFFFF); wr(t, 0x1A30, 1);
+	/* write master 7 (RDI0), frame mode: packed RAW10 back to back */
+	wr(t, 0x231C, 0xF);
+	wr(t, 0x230C, 0x0000FFFF);
+	wr(t, 0x2318, 0xA);
+	wr(t, 0x2314, 0xFFFF);
+	wr(t, 0x2304, (uint32_t)CAM_POOL_PA);
+	wr(t, 0x2308, bytes);
+	wr(t, 0x2338, 0);
+	wr(t, 0x233C, 1);
+	wr(t, 0x2300, 0x00010001);
+	wr(t, 0x1460, 0x1);
+	wr(t, 0x1470, 0x00140014);
+	wr(t, 0x102C, 0x2);                             /* reg update: RDI0 */
+	camlog("TFE0: WM7 cfg %#x addr %#x size %u, RDI0 cfg %#x", rd(t, 0x2300), rd(t, 0x2304), rd(t, 0x2308), rd(t, 0x1460));
+	wr(t, 0x308, 1);                                /* RDI0 resume */
+	uint64_t t0 = mach_absolute_time(), ns = 0;
+	uint32_t last0 = 0, last1 = 0, b0 = 0, b1 = 0, logs = 0;
+	bool eof = false, done = false;
+	while (!done) {
+		uint32_t s0 = rd(t, 0x104C), s1 = rd(t, 0x1050), rdi = rd(t, 0x040);
+		b0 = rd(t, 0x1A28); b1 = rd(t, 0x1A2C);
+		if ((s0 != last0 || s1 != last1 || b0 != 0 || b1 != 0) && logs < 12) {
+			camlog("TFE top %#x %#x %#x, bus %#x %#x, overflow %#x, size violation %#x, rdi0 irq %#x", s0, s1,
+			    rd(t, 0x1054), b0, b1, rd(t, 0x1A68), rd(t, 0x1A70), rdi);
+			logs++;
+			last0 = s0;
+			last1 = s1;
+		}
+		if (s0 | s1) {
+			wr(t, 0x1040, s0); wr(t, 0x1044, s1); wr(t, 0x1030, 1);
+		}
+		if (b0 | b1) {
+			wr(t, 0x1A20, b0); wr(t, 0x1A24, b1); wr(t, 0x1A30, 1);
+		}
+		eof |= (rdi & (1u << 9)) != 0;
+		if (rdi) {
+			wr(t, 0x048, rdi); wr(t, 0x080, 1);
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		done = (eof && (b0 | b1) != 0) || ns > 3000000000ull;
+		if (!done) {
+			IOSleep(2);
+		}
+	}
+	wr(t, 0x308, 0);                                /* halt the RDI at the frame boundary */
+	IOSleep(cs.w > 4000 ? 200 : 50);
+	wr(t, 0x2300, 0);
+	wr(t, 0x102C, 0x2);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	unsigned changed = 0, tail = 0;
+	for (unsigned i = 0; i < 4096; i++) {
+		changed += cam_pool[i] != 0xA5;
+		tail += cam_pool[bytes - 4096 + i] != 0xA5;
+	}
+	camlog("frame: %s after %llu ms; WM7 addr status %#x; first 4 KB %u bytes written, last 4 KB %u", eof ? "EOF" : "NO EOF",
+	    ns / 1000000, rd(t, 0x2368), changed, tail);
+	camlog("frame +0: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x", cam_pool[0],
+	    cam_pool[1], cam_pool[2], cam_pool[3], cam_pool[4], cam_pool[5], cam_pool[6], cam_pool[7], cam_pool[8], cam_pool[9],
+	    cam_pool[10], cam_pool[11], cam_pool[12], cam_pool[13], cam_pool[14], cam_pool[15]);
+	cam_smmu_report("after");
+	cam_frame_len = changed != 0 ? bytes : 0;
+	cam_seek = 0;
+	camlog("op 12: %s (%u bytes in kern.sweet_cam_frame)", changed ? "FRAME CAPTURED" : "nothing written", cam_frame_len);
+	return changed ? 0 : EIO;
+}
+
+/* ---------------------------------------------------------------- op 13: stop */
+
+static int
+cam_stop(void)
+{
+	if (cam_csid != 0 && cam_csid_up) {
+		wr(cam_csid, 0x308, 0);
+		wr(cam_csid, 0x2300, 0);
+		wr(cam_csid, 0x102C, 0x2);
+		csid_counters("at stop");
+		cam_csid_up = false;
+	}
+	if (cam_streaming) {
+		int r = cs.slot == 0 ? cam_replay(0, 0x10, hm6_off, sizeof(hm6_off) / sizeof(hm6_off[0]), "HM6 stream off") :
+		    cam_replay(1, 0x2D, h7_off, sizeof(h7_off) / sizeof(h7_off[0]), "4H7 stream off");
+		cam_streaming = false;
+		camlog("op 13: stream off %d", r);
+	}
+	return 0;
+}
+
+/* ---------------------------------------------------------------- op 14: the pool's pattern test */
+
+static int
+cam_pool_test(void)
+{
+	if (!cam_pool_map()) {
+		return ENOMEM;
+	}
+	volatile uint64_t *p = (volatile uint64_t *)(void *)cam_pool;
+	uint64_t n = CAM_POOL_SIZE / 8, bad = 0, first = ~0ull, got = 0, want = 0;
+	bool write = cam_arg != 1;
+	uint64_t t0 = mach_absolute_time(), ns;
+	if (write) {
+		for (uint64_t i = 0; i < n; i++) {
+			uint64_t pa = CAM_POOL_PA + i * 8;
+			p[i] = pa ^ 0xA5A55A5A00000000ull ^ (pa << 32);
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	for (uint64_t i = 0; i < n; i++) {
+		uint64_t pa = CAM_POOL_PA + i * 8, w = pa ^ 0xA5A55A5A00000000ull ^ (pa << 32), v = p[i];
+		if (v != w) {
+			if (bad++ == 0) {
+				first = pa;
+				got = v;
+				want = w;
+			}
+		}
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	if (bad == 0) {
+		camlog("pool test (%s): 144 MB match the pattern (%llu ms)", write ? "written + read back" : "read back only", ns / 1000000);
+	} else {
+		camlog("pool test (%s): %llu mismatching words, the first at %#llx: %#llx, expected %#llx (%llu ms)",
+		    write ? "written + read back" : "read back only", bad, first, got, want, ns / 1000000);
+	}
+	cam_frame_len = 0;
+	return bad == 0 ? 0 : EIO;
+}
+
+/* ---------------------------------------------------------------- the frame for user space */
+
+static int
+sysctl_sweet_cam_frame SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (req->newptr != USER_ADDR_NULL) {
+		return EPERM;
+	}
+	lck_mtx_lock(&sweet_cam_mtx);
+	int err = 0;
+	if (cam_pool == NULL || cam_frame_len == 0) {
+		err = ENOENT;
+	} else if (cam_seek < 0 || cam_seek >= (int64_t)cam_frame_len) {
+		err = 0;                                /* the end: nothing more */
+	} else {
+		uint32_t n = cam_frame_len - (uint32_t)cam_seek;
+		n = n > (1u << 20) ? (1u << 20) : n;
+		err = SYSCTL_OUT(req, cam_pool + cam_seek, n);
+		if (err == 0 && req->oldptr != USER_ADDR_NULL) {
+			cam_seek += n;
+		}
+	}
+	lck_mtx_unlock(&sweet_cam_mtx);
+	return err;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_frame, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_cam_frame, "S", "the captured frame: up to 1 MB from kern.sweet_cam_seek, which advances");
+SYSCTL_QUAD(_kern, OID_AUTO, sweet_cam_seek, CTLFLAG_RW | CTLFLAG_LOCKED, &cam_seek, "offset of the next kern.sweet_cam_frame read");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_cam_frame_len, CTLFLAG_RD | CTLFLAG_LOCKED, &cam_frame_len, 0, "bytes in the captured frame");
+SYSCTL_INT(_kern, OID_AUTO, sweet_cam_arg, CTLFLAG_RW | CTLFLAG_LOCKED, &cam_arg, 0,
+    "argument of the camera ops (op 10: slot | mode << 4; op 11: settle << 8; op 14: 1 = check only)");
+
