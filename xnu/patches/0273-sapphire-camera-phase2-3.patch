+/*
+ * after a NACK or a timeout on master m (Linux i2c-qcom-cci / Android cam_cci_halt): HALT_REQ
+ * (0x034) for that master, its HALT_ACK (status bit 25 + m), the master's own reset
+ * (RESET_CMD 0x3F1 for M0, 0x3F001 for M1), reset done, then its timings again; the global reset
+ * if any of that does not answer.
+ */
+static void
+cci_recover(unsigned m)
+{
+	wr(cci, 0x034, 1u << m);
+	bool halted = cci_wait(1u << (25 + m), 0, "halt");
+	cci_clear(0xffffffffu);
+	wr(cci, CCI_RESET_CMD, m == 0 ? 0x3F1u : 0x3F001u);
+	bool reset = cci_wait(CCI_RST_DONE, 0, "master reset");
+	wr(cci, CCI_IRQ_MASK0, 0x7FFF7FF7u);
+	wr(cci, CCI_IRQ_GCLEAR, 1);
+	cci_timings(m);
+	camlog("CCI m%u recovered: halt %s, master reset %s, queues %u/%u words", m, halted ? "acked" : "NOT acked",
+	    reset ? "done" : "NOT done", rd(cci, CCI_Q(m, 0) + 0x4), rd(cci, CCI_Q(m, 1) + 0x4));
+	if (!halted || !reset) {
+		(void)cci_reset();
+		camlog("CCI: global reset after it (irq mask %#x)", rd(cci, CCI_IRQ_MASK0));
+	}
+}
