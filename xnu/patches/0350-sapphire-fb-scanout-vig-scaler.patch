+sweet_scanout_pool_set(uint64_t pa, uint32_t slots, uint32_t slot_size, uint32_t width, uint32_t height)
+{
+	sweet_pool_pa = pa;
+	sweet_pool_slot_size = slot_size;
+	sweet_pool_w = width;
+	sweet_pool_h = height;
+	sweet_pool_slots = slots < 32 ? slots : 32;
