+static uint32_t sweet_pool_slots, sweet_pool_slot_size, sweet_pool_w, sweet_pool_h;
+static uint32_t sweet_pool_used;                /* bit per slot, sweet_surface_lock */
+static uint64_t sweet_pool_made, sweet_pool_refused;
