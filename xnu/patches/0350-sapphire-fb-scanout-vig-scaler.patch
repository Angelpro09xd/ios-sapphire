+} sweet_fbs;
+extern uint32_t sapphire_gpu_msm_fence(void);           /* SapphireGpu.cpp: the last msm submission's fence */
+extern bool sapphire_gpu_msm_fence_done(uint32_t fence); /* ... and whether a given one is done */
