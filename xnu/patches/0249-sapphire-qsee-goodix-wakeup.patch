+/* WAKEUP (1002,9), 0x20: +0x1d screen index 0xff, +0x1e reset-before-wakeup; out +0x1c "woken" */
 static bool
-sensor_probe(uint32_t app_id)
+gf_wakeup(uint32_t app_id, bool reset_first, uint32_t *res)
 {
 	uint8_t c[0x40];
+	const char *name = reset_first ? "WAKEUP(reset)" : "WAKEUP";
+
+	gf_header(c, 0x20, GF_TARGET_SENSOR, GF_SENSOR_WAKEUP);
+	c[0x1d] = 0xff;
+	c[0x1e] = reset_first ? 1 : 0;
+	if (!gf_send(app_id, c, 0x20, name)) {
+		LOG("%s: the call itself failed", name);
+		return false;
+	}
+	*res = *(uint32_t *)(c + 0x0c);
+	LOG("%s: gf result %u %s, woken byte +0x1c = %u", name, *res, gf_err_name(*res), c[0x1c]);
+	return true;
+}
+
+/* PRE_DETECT / DETECT_SENSOR: retried (after a reset pulse) only on FAILED_AND_RETRY, as SensorDetector does */
+static bool
+gf_detect_step(uint32_t app_id, uint32_t cmd, uint32_t len, const char *name, uint8_t *c)
+{
 	clock_sec_t sec;
 	clock_usec_t usec;
-	bool pre = false;
-
-	for (unsigned i = 0; i < 4 && !pre; i++) {     /* SensorDetector::init: up to 4 tries */
-		gf_header(c, 0x28, GF_TARGET_SENSOR, GF_SENSOR_PRE_DETECT);
-		clock_get_calendar_microtime(&sec, &usec);
-		*(uint64_t *)(c + 0x20) = (uint64_t)sec;
-		if (!gf_send(app_id, c, 0x28, "PRE_DETECT")) {
-			LOG("PRE_DETECT: the call itself failed: stop");
+
+	for (unsigned i = 0; i < 4; i++) {
+		gf_header(c, len, GF_TARGET_SENSOR, cmd);
+		if (cmd == GF_SENSOR_PRE_DETECT) {
+			clock_get_calendar_microtime(&sec, &usec);
+			*(uint64_t *)(c + 0x20) = (uint64_t)sec;
+		}
+		if (!gf_send(app_id, c, len, name)) {
+			LOG("%s: the call itself failed: stop", name);
+			return false;
+		}
+		uint32_t r = *(uint32_t *)(c + 0x0c);
+		if (r == 0) {
+			return true;
+		}
+		if (r != GF_FAILED_AND_RETRY) {
+			LOG("%s: gf error %u %s: stop", name, r, gf_err_name(r));
+			return false;
+		}
+		LOG("%s: FAILED_AND_RETRY (try %u): reset pulse, again", name, i + 1);
+		if (!fp_reset_pulse(60)) {
 			return false;
 		}
-		pre = *(uint32_t *)(c + 0x0c) == 0;
-		if (!pre) {
-			IOSleep(10);
+	}
+	LOG("%s: still FAILED_AND_RETRY after 4 tries: stop", name);
+	return false;
+}
+
+/* HalContext::init from step 7: doResetBeforeWakeup, doWakeup, PRE_DETECT, DETECT_SENSOR */
+static bool
+sensor_probe(uint32_t app_id)
+{
+	uint8_t c[0x40];
+	uint32_t r = 0;
+
+	fp_diag("before WAKEUP(reset)");
+	if (!gf_wakeup(app_id, true, &r)) {
+		return false;
+	}
+	if (r == 0) {
+		/* Device::reset(false): another hardware reset pulse */
+		LOG("WAKEUP(reset) ok: hardware reset pulse");
+		if (!fp_reset_pulse(60)) {
+			return false;
 		}
 	}
+	fp_diag("after WAKEUP(reset)");
+	if (!gf_wakeup(app_id, false, &r)) {
+		return false;
+	}
+	if (r != 0) {
+		LOG("WAKEUP: gf error %u %s: going on to PRE_DETECT for the log", r, gf_err_name(r));
+	}
+	bool pre = gf_detect_step(app_id, GF_SENSOR_PRE_DETECT, 0x28, "PRE_DETECT", c);
+	fp_diag("after PRE_DETECT");
 	if (!pre) {
-		LOG("PRE_DETECT: gf error after 4 tries: stop");
 		return false;
 	}
-	gf_header(c, 0x2c, GF_TARGET_SENSOR, GF_SENSOR_DETECT);
-	if (!gf_send(app_id, c, 0x2c, "DETECT_SENSOR")) {
-		LOG("DETECT_SENSOR: the call failed");
+	if (!gf_detect_step(app_id, GF_SENSOR_DETECT, 0x2c, "DETECT_SENSOR", c)) {
 		return false;
 	}
-	uint32_t err = *(uint32_t *)(c + 0x0c);
 	const uint32_t *info = (const uint32_t *)(c + 0x1c);
-	LOG("DETECT_SENSOR: gf result %u, sensor info %08x %08x %08x %08x%s", err, info[0], info[1], info[2], info[3],
-	    err == 0 ? ": TZ talks to the sensor" : "");
-	return err == 0;
+	LOG("DETECT_SENSOR: sensor info %08x %08x %08x %08x: TZ talks to the sensor", info[0], info[1], info[2], info[3]);
+	return true;
 }
 
-/* ---------------------------------------------------------------- the milestone */
-
+/* APP_SHUTDOWN of a loaded goodixfp: 0 done or not loaded, else an errno */
 static int
-milestone(void)
+shutdown_app(void)
+{
+	uint64_t ret[3];
+
+	int64_t id = qsee_lookup("goodixfp");
+	if (id <= 0) {
+		return id == 0 ? 0 : EIO;
+	}
+	uint64_t a[1] = { (uint64_t)id };
+	int64_t x0 = scm_call(FN_APP_SHUTDOWN, 0x1, a, 1, ret);
+	bool ok = qsee_finish("APP_SHUTDOWN goodixfp", x0, ret, (uint32_t)id);
+	LOG("APP_SHUTDOWN goodixfp (app %lld): %s", id, ok ? "done" : "FAILED");
+	if (ok) {
+		q_goodix_id = 0;
+	}
+	return ok ? 0 : EIO;
+}
+
+/* the TA: restart = shutdown a loaded one first (a clean TA state), else reuse it */
+static int64_t
+ta_ready(bool restart)
+{
+	if (restart && shutdown_app() != 0) {
+		return -1;
+	}
+	int64_t id = qsee_lookup("goodixfp");
+	if (id < 0) {
+		return -1;
+	}
+	if (id > 0) {
+		LOG("goodixfp already loaded: app id %lld (reused)", id);
+		return id;
+	}
+	id = ta_start();
+	if (id > 0) {
+		LOG("goodixfp started: app id %lld", id);
+	}
+	return id;
+}
+
+static bool
+qsee_up(void)
 {
 	uint64_t wl = 0;
-	const uint64_t t0 = mach_absolute_time();
 
-	LOG("milestone 1 begins");
