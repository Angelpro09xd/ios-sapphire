+		/* 0249: the table is 8 entries, 64 bytes (libQSEEComAPI's size) */
+		uint64_t a[7] = { app_id, QSEE_POOL_PA + OFF_SB, 0x40, QSEE_POOL_PA + OFF_SB, 0x40, QSEE_POOL_PA + OFF_SGL, 64 };
