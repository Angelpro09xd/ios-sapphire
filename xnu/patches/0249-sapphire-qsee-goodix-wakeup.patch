+/*
+ * 0249, read-only diagnostics: GCC (0x1400000) QUPv3 wrapper 0 branches (gcc-khaje.c, the same
+ * layout sweet_i2c1.c / sweet_touch.c use for SE1 0x1f274 and SE2 0x1f3a4: SE n's CBCR at
+ * 0x1f144 + n * 0x130, its RCG right after it; bit 31 of a CBCR = clock off), the APCS vote
+ * register 0x7900c (bits 6 m_ahb, 7 s_ahb, 8 core, 9 core_2x, 10 + n SE n). SE5 is presumed to
+ * be the sensor's SPI (fingerprint-hw.md), on gpio14..17.
+ */
+#define GCC_PA              0x01400000ull
+#define GCC_QUP_VOTE        0x7900cu
+#define GCC_WRAP0_M_AHB     0x1f004u
+#define GCC_WRAP0_S_AHB     0x1f008u
+#define GCC_WRAP0_CORE      0x1f00cu
+#define GCC_WRAP0_CORE2X    0x1f014u
+#define GCC_WRAP0_S5_CBCR   (0x1f144u + 5 * 0x130u)
+
