+	{ 1024, "INVALID_DATA" },
+	{ 1025, "SPI_TRANSFER_ERROR" },
+	{ 1026, "SPI_GENERAL_ERROR" },
+	{ 1027, "SPI_IRQ_HANDLE" },
+	{ 1028, "SPI_RAW_DATA_CRC_FAILED" },
+	{ 1051, "TA_DEAD" },
+	{ 1112, "FAILED_AND_RETRY" },
+};
+
+static const char *
+gf_err_name(uint32_t code)
+{
+	for (unsigned i = 0; i < sizeof(gf_errors) / sizeof(gf_errors[0]); i++) {
+		if (gf_errors[i].code == code) {
+			return gf_errors[i].name;
+		}
+	}
+	return "?";
+}
 
 static IOLock *q_lock;
 static IOMemoryMap *q_map;
@@ -367,6 +414,37 @@ gpio_out(unsigned gpio, bool high)
 	return true;
 }
 
+/* read only: the presumed SPI pins, the reset pin, and the QUP clocks */
+static void
+fp_diag(const char *when)
+{
+	/* not gpio14..17 or the QUP clocks: TZ owns the sensor's SPI and touching them hangs the phone */
+	static const unsigned pins[] = { GPIO_RST, GPIO_IRQ };
+	for (unsigned i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		volatile uint32_t *g = tlmm(pins[i]);
+		if (g != NULL) {
+			uint32_t ctl = g[0], io = g[1];
+			LOG("diag %s: gpio%u ctl %08x (func %u, drv %u mA, pull %u, oe %u) io %08x", when, pins[i], ctl,
+			    (ctl >> 2) & 0xf, (((ctl >> 6) & 7) + 1) * 2, ctl & 3, (ctl >> 9) & 1, io);
+		}
+	}
+}
+
+/* FP_IOC_RESET / fp_hw_reset(): reset low, 5 ms, high, then delay_ms */
+static bool
+fp_reset_pulse(unsigned delay_ms)
+{
+	if (!gpio_out(GPIO_RST, false)) {
+		return false;
+	}
+	IOSleep(5);
+	if (!gpio_out(GPIO_RST, true)) {
+		return false;
+	}
+	IOSleep(delay_ms);
+	return true;
+}
