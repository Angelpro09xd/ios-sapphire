@@ -96,6 +102,47 @@ extern "C" int topaz_rpm_vote(uint32_t set, uint32_t type, uint32_t id, uint32_t
 #define GF_TARGET_SENSOR    1002
 #define GF_SENSOR_PRE_DETECT 0
 #define GF_SENSOR_DETECT    1
+#define GF_SENSOR_WAKEUP    9
+#define GF_FAILED_AND_RETRY 0x458
