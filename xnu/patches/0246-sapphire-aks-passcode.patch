+/*
+ * aks_change_secret (keybagd KBChangeSystemNonSeSecret, for profiled's
+ * MKBKeyBagChangeSystemSecret): scalars { handle, generation flags, 0xff,
+ * old ptr, old len, new ptr, new len, 0, 0, 0, 0 }; one scalar out, the new
+ * bag keybagd then saves (3: our blob, written to systembag.kb), makes the
+ * system bag (5), finishes (105) and unloads (4). An empty new secret removes
+ * the passcode. Only memory changes here; keybagd's save persists it.
+ */
+static IOReturn
+sweet_aks_change_secret(IOExternalMethodArguments *args, uint32_t *post)
+{
+	uint8_t oldp[SWEET_AKS_PASS_MAX], newp[SWEET_AKS_PASS_MAX];
+	size_t oldlen, newlen;
+	struct sweet_aks_secret s;
+	bool had_pass;
+	IOReturn ret;
+
+	if (args->scalarInputCount < 7) {
+		return kIOReturnBadArgument;
+	}
+	ret = sweet_aks_copyin_pass(args->scalarInput[3], args->scalarInput[4], oldp, &oldlen);
+	if (ret == kIOReturnSuccess) {
+		ret = sweet_aks_copyin_pass(args->scalarInput[5], args->scalarInput[6], newp, &newlen);
+	}
+	if (ret != kIOReturnSuccess) {
+		cc_clear(sizeof(oldp), oldp);
+		args->scalarOutputCount = 0;
+		return ret;
+	}
+
+	IOLockLock(sweet_aks_lock);
+	had_pass = sa.has_pass;
+	IOLockUnlock(sweet_aks_lock);
+	/* with no verifier any old secret goes: a passcode "set" before this kernel was never kept */
+	ret = had_pass ? sweet_aks_check(oldp, oldlen, post) : kIOReturnSuccess;
+	if (ret == kIOReturnSuccess) {
+		bzero(&s, sizeof(s));
+		if (newlen != 0) {
+			s.iterations = SWEET_AKS_ITERATIONS;
+			read_random(s.salt, sizeof(s.salt));
+			sweet_aks_pbkdf2(newp, newlen, s.salt, sizeof(s.salt), s.iterations, s.verifier);
+		}
+		IOLockLock(sweet_aks_lock);
+		sa.has_pass = newlen != 0;
+		memcpy(&sa.secret, &s, sizeof(sa.secret));
+		sa.generation++;
+		sa.failed = 0;
+		sa.backoff_until = 0;
+		sweet_aks_unlock_locked(post);
+		IOLockUnlock(sweet_aks_lock);
+		cc_clear(sizeof(s), &s);
+		*post |= SWEET_AKS_POST_LOCK_STATE;
+		IOLog("SWEET AKS: passcode %s (kept when keybagd saves the bag)\n",
+		    newlen == 0 ? "removed" : had_pass ? "changed" : "set");
+	}
+	cc_clear(sizeof(oldp), oldp);
+	cc_clear(sizeof(newp), newp);
+	if (ret == kIOReturnSuccess && args->scalarOutputCount >= 1) {
+		args->scalarOutput[0] = SWEET_AKS_NEW_HANDLE;   /* keybagd wants a bag != the old one */
+		args->scalarOutputCount = 1;
+	} else {
+		args->scalarOutputCount = 0;
+	}
+	return ret;
+}
