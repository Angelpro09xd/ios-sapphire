+/* aks_verify_password: scalar handle; struct = packed { u32 n; n x { u32 len; bytes; pad 4 } }, item 0 the passcode. */
+static IOReturn
+sweet_aks_verify_password(IOExternalMethodArguments *args, uint32_t *post)
+{
+	uint8_t in[SWEET_AKS_PASS_MAX + 64];
+	uint32_t len = sizeof(in), n, plen;
+	IOReturn ret;
+
+	if (args->structureInputDescriptor != NULL) {
+		len = (uint32_t)args->structureInputDescriptor->getLength();
+		if (len > sizeof(in) || sweet_aks_md_copy(args->structureInputDescriptor, in, len, false) != len) {
+			return kIOReturnBadArgument;
+		}
+	} else {
+		len = args->structureInputSize;
+		if (len > sizeof(in) || (len > 0 && args->structureInput == NULL)) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(in, args->structureInput, len);
+	}
+	if (len < 8) {
+		cc_clear(sizeof(in), in);
+		return kIOReturnBadArgument;
+	}
+	memcpy(&n, in, 4);
+	memcpy(&plen, in + 4, 4);
+	if (n < 1 || plen > len - 8) {
+		cc_clear(sizeof(in), in);
+		return kIOReturnBadArgument;
+	}
+	ret = sweet_aks_check(in + 8, plen, post);
+	cc_clear(sizeof(in), in);
+	return ret;
+}
