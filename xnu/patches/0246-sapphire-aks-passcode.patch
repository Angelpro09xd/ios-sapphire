-/* The system (device) bag handle. */
+/* Bag handles: the system (device) bag, the one keybagd's two-phase change gets back, a loaded one. */
 #define SWEET_AKS_SYSTEM_HANDLE 0
+#define SWEET_AKS_NEW_HANDLE    1
+#define SWEET_AKS_LOADED_HANDLE 2
 
 /*
- * aks lock state bits (aks_get_lock_state): bit 2 is "unlocked since boot"
- * (MobileKeyBag MKBDeviceUnlockedSinceBoot); clear lock bits = unlocked.
+ * aks lock state bits (aks_get_lock_state, also the device state's "ss"):
+ * Security's keybag_state_locked / no_pin / been_unlocked. MobileKeyBag's
+ * MKBDeviceUnlockedSinceBoot is bit 2. keybagd tests bit 13 (SE-bound
+ * passcode) and bit 22 (xART bag); both stay clear.
  */
-#define SWEET_AKS_LOCK_STATE    0x4
+#define SWEET_AKS_STATE_LOCKED          0x1
+#define SWEET_AKS_STATE_NO_PIN          0x2
+#define SWEET_AKS_STATE_BEEN_UNLOCKED   0x4
+
+/* MobileKeyBag lock states (MKBGetDeviceLockState = the device state's "sls"). */
+#define SWEET_MKB_UNLOCKED      0
+#define SWEET_MKB_LOCKED        1
+#define SWEET_MKB_LOCKING       2       /* grace period running */
+#define SWEET_MKB_DISABLED      3       /* no passcode */
+
+/* IOGeneralInterest messages the kext sends (MobileKeyBag aksNotificationCB, UserEventAgent). */
+#define SWEET_AKS_MSG_LOCK_STATE        0xe3ffd00dU
+#define SWEET_AKS_MSG_FIRST_UNLOCK      0xe3ffd00fU
+
+#define SWEET_AKS_PASS_MAX      256             /* longest passcode accepted */
+#define SWEET_AKS_ITERATIONS    20000           /* PBKDF2-HMAC-SHA256 rounds of a new verifier */
+#define SWEET_AKS_ITER_MIN      1000
+#define SWEET_AKS_ITER_MAX      1000000
+#define SWEET_AKS_FAILED_SHOWN  9               /* SpringBoard wipes/blocks for good at 10 */
 
 class AppleKeyStore : public IOService {
 	OSDeclareDefaultStructors(AppleKeyStore);
@@ -68,15 +139,592 @@ public:
 
 OSDefineMetaClassAndStructors(AppleKeyStore, IOService);
 
+/* ------------------------------------------------------------------ state */
+
+/*
+ * The system bag blob (aks_save_bag / aks_load_bag), 104 bytes, little endian.
+ * check is an HMAC of the blob under a fixed key: it catches torn or foreign
+ * data, it is not a secret.
+ */
+struct sweet_aks_bag {
+	char     magic[8];              /* "SWAKSB1" */
+	uint32_t version;               /* 1 */
+	uint32_t flags;                 /* bit 0: a passcode is set */
+	uint32_t iterations;
+	uint32_t failed;                /* consecutive failed attempts */
+	uint8_t  salt[16];
+	uint8_t  verifier[32];          /* PBKDF2-HMAC-SHA256(passcode, salt, iterations) */
+	uint8_t  check[32];
+};
+static_assert(sizeof(struct sweet_aks_bag) == 104, "bag blob size");
+
+#define SWEET_AKS_BAG_MAGIC     "SWAKSB1"
+#define SWEET_AKS_BAG_VERSION   1
+#define SWEET_AKS_BAG_PASSCODE  0x1
+
+static const uint8_t sweet_aks_check_key[] = "SWEET AKS system bag v1";
+
+static IOLock *sweet_aks_lock;          /* the fields of sa; never held across anything that blocks */
+static AppleKeyStore *sweet_aks_service;
+static thread_call_t sweet_aks_grace_call;
+static uint32_t sweet_aks_grace_secs;
+static uint32_t sweet_aks_nopass;
+
+/* The verifier part of the state, copied out to run the KDF without the lock. */
+struct sweet_aks_secret {
+	uint32_t iterations;
+	uint8_t  salt[16];
+	uint8_t  verifier[32];
+};
+
+static struct {
+	uint32_t sys_state;             /* 0: no bag yet, 1: told keybagd NotFound, 2: system bag in place */
+	bool     has_pass;
+	bool     locked;
+	bool     locking;               /* grace period: unlocked until grace_deadline */
+	bool     been_unlocked;
+	bool     notify_state;          /* aks_notify_state_set (UserEventAgent first unlock) */
+	uint32_t failed;
+	uint32_t generation;            /* bumped when the verifier changes */
+	uint64_t grace_deadline;        /* mach_absolute_time */
+	uint64_t backoff_until;         /* mach_continuous_time */
+	struct sweet_aks_secret secret;
+} sa = {
+	.been_unlocked = true,          /* until a bag with a passcode is loaded */
+};
+
+#define SWEET_AKS_POST_LOCK_STATE       0x1
+#define SWEET_AKS_POST_FIRST_UNLOCK     0x2
+
+/* Tell MobileKeyBag/UserEventAgent clients. Never called with a lock held. */
+static void
+sweet_aks_post(uint32_t what)
+{
+	if (sweet_aks_service == NULL) {
+		return;
+	}
+	if (what & SWEET_AKS_POST_FIRST_UNLOCK) {
+		sweet_aks_service->messageClients(SWEET_AKS_MSG_FIRST_UNLOCK);
+	}
+	if (what & (SWEET_AKS_POST_LOCK_STATE | SWEET_AKS_POST_FIRST_UNLOCK)) {
+		sweet_aks_service->messageClients(SWEET_AKS_MSG_LOCK_STATE);
+	}
+}
+
+static uint32_t
+sweet_aks_backoff_secs(uint32_t failed)
+{
+	/* iOS: no delay for 4 failures, then 1 min, 5 min, 15 min, 15 min, 1 h (and 1 h from then on here) */
+	if (failed < 5) {
+		return 0;
+	}
+	switch (failed) {
+	case 5:
+		return 60;
+	case 6:
+		return 5 * 60;
+	case 7:
+	case 8:
+		return 15 * 60;
+	default:
+		return 60 * 60;
+	}
+}
+
+static void
+sweet_aks_arm_backoff_locked(void)
+{
+	uint32_t secs = sweet_aks_backoff_secs(sa.failed);
+	uint64_t abs;
+
+	if (secs == 0) {
+		sa.backoff_until = 0;
+		return;
+	}
+	nanoseconds_to_absolutetime((uint64_t)secs * NSEC_PER_SEC, &abs);
+	sa.backoff_until = mach_continuous_time() + abs;
+}
+
+/* Seconds of back-off left (the device state's "sb"; SpringBoard adds it to now). */
+static uint64_t
+sweet_aks_backoff_left_locked(void)
+{
+	uint64_t now = mach_continuous_time(), ns;
+
+	if (sa.backoff_until <= now) {
+		return 0;
+	}
+	absolutetime_to_nanoseconds(sa.backoff_until - now, &ns);
+	return (ns + NSEC_PER_SEC - 1) / NSEC_PER_SEC;
+}
+
+static uint32_t
+sweet_aks_lock_bits_locked(void)
+{
+	uint32_t s = 0;
+
+	if (!sa.has_pass) {
+		s |= SWEET_AKS_STATE_NO_PIN;
+	}
+	if (sa.locked) {
+		s |= SWEET_AKS_STATE_LOCKED;
+	}
+	if (sa.been_unlocked) {
+		s |= SWEET_AKS_STATE_BEEN_UNLOCKED;
+	}
+	return s;
+}
+
+static uint32_t
+sweet_aks_mkb_state_locked(void)
+{
+	if (!sa.has_pass) {
+		return SWEET_MKB_DISABLED;
+	}
+	if (sa.locked) {
+		return SWEET_MKB_LOCKED;
+	}
+	return sa.locking ? SWEET_MKB_LOCKING : SWEET_MKB_UNLOCKED;
+}
+
+static const char *
+sweet_aks_state_name(uint32_t mkb)
+{
+	static const char *const names[] = { "unlocked", "locked", "locking", "no passcode" };
+	return mkb < 4 ? names[mkb] : "?";
+}
+
+/* ------------------------------------------------------------------ crypto */
+
+/* HMAC-SHA256 context storage without a VLA (cchmac_di_size(sha256) is ~170 bytes). */
+typedef struct {
+	uint64_t b[64];
+} sweet_aks_hmac_ctx;
+
+/* PBKDF2-HMAC-SHA256 (RFC 8018) with a 32-byte output: a single block. No lock held. */
+static void
+sweet_aks_pbkdf2(const uint8_t *pass, size_t passlen, const uint8_t *salt, size_t saltlen,
+    uint32_t iterations, uint8_t out[32])
+{
+	const struct ccdigest_info *di = ccsha256_di();
+	sweet_aks_hmac_ctx keyed, work;
+	uint8_t u[32];
+	const uint8_t one[4] = { 0, 0, 0, 1 };
+
+	if (cchmac_di_size(di) > sizeof(keyed)) {
+		panic("SWEET AKS: HMAC context too small");
+	}
+	cchmac_init(di, (cchmac_ctx_t)&keyed, passlen, pass);
+
+	memcpy(&work, &keyed, sizeof(work));
+	cchmac_update(di, (cchmac_ctx_t)&work, saltlen, salt);
+	cchmac_update(di, (cchmac_ctx_t)&work, sizeof(one), one);
+	cchmac_final(di, (cchmac_ctx_t)&work, u);
+	memcpy(out, u, sizeof(u));
+	for (uint32_t i = 1; i < iterations; i++) {
+		memcpy(&work, &keyed, sizeof(work));
+		cchmac_update(di, (cchmac_ctx_t)&work, sizeof(u), u);
+		cchmac_final(di, (cchmac_ctx_t)&work, u);
+		for (unsigned int j = 0; j < sizeof(u); j++) {
+			out[j] ^= u[j];
+		}
+	}
+	cc_clear(sizeof(keyed), &keyed);
+	cc_clear(sizeof(work), &work);
+	cc_clear(sizeof(u), u);
+}
+
+static void
+sweet_aks_bag_check(const struct sweet_aks_bag *b, uint8_t check[32])
+{
+	cchmac(ccsha256_di(), sizeof(sweet_aks_check_key), sweet_aks_check_key,
+	    offsetof(struct sweet_aks_bag, check), b, check);
+}
+
+/* The blob keybagd saves: built from the current state. */
+static void
+sweet_aks_bag_build(struct sweet_aks_bag *b)
+{
+	bzero(b, sizeof(*b));
+	memcpy(b->magic, SWEET_AKS_BAG_MAGIC, sizeof(b->magic));
+	b->version = SWEET_AKS_BAG_VERSION;
+	IOLockLock(sweet_aks_lock);
+	if (sa.has_pass) {
+		b->flags = SWEET_AKS_BAG_PASSCODE;
+		b->iterations = sa.secret.iterations;
+		b->failed = sa.failed;
+		memcpy(b->salt, sa.secret.salt, sizeof(b->salt));
+		memcpy(b->verifier, sa.secret.verifier, sizeof(b->verifier));
+	}
+	IOLockUnlock(sweet_aks_lock);
+	sweet_aks_bag_check(b, b->check);
+}
+
+/*
+ * The system bag keybagd --init loaded from systembag.kb. Anything that is not
+ * a valid blob of ours (the image's "SWEET" placeholder, a torn file) is a bag
+ * without a passcode: refusing it would be keybagd's FATAL KEYBAG ERROR.
+ */
+static void
+sweet_aks_bag_adopt(const uint8_t *data, uint32_t len)
+{
+	struct sweet_aks_bag b;
+	uint8_t check[32];
+	bool ours = false, pass = false, ignored = false;
+	uint32_t failed = 0;
+
+	bzero(&b, sizeof(b));
+	if (len == sizeof(b)) {
+		memcpy(&b, data, sizeof(b));
+		sweet_aks_bag_check(&b, check);
+		ours = memcmp(b.magic, SWEET_AKS_BAG_MAGIC, sizeof(b.magic)) == 0 &&
+		    b.version == SWEET_AKS_BAG_VERSION &&
+		    cc_cmp_safe(sizeof(check), check, b.check) == 0;
+		cc_clear(sizeof(check), check);
+	}
+	if (ours && (b.flags & SWEET_AKS_BAG_PASSCODE) &&
+	    b.iterations >= SWEET_AKS_ITER_MIN && b.iterations <= SWEET_AKS_ITER_MAX) {
+		if (sweet_aks_nopass) {
+			ignored = true;
+		} else {
+			pass = true;
+			failed = b.failed;
+		}
+	}
+
+	IOLockLock(sweet_aks_lock);
+	sa.sys_state = 2;
+	sa.has_pass = pass;
+	sa.locked = pass;
+	sa.locking = false;
+	sa.been_unlocked = !pass;
+	sa.failed = failed;
+	sa.generation++;
+	bzero(&sa.secret, sizeof(sa.secret));
+	if (pass) {
+		sa.secret.iterations = b.iterations;
+		memcpy(sa.secret.salt, b.salt, sizeof(sa.secret.salt));
+		memcpy(sa.secret.verifier, b.verifier, sizeof(sa.secret.verifier));
+	}
+	sweet_aks_arm_backoff_locked();
+	IOLockUnlock(sweet_aks_lock);
+	cc_clear(sizeof(b), &b);
+
+	if (ignored) {
+		IOLog("SWEET AKS: system bag: passcode ignored (sweetaks_nopass)\n");
+	}
+	IOLog("SWEET AKS: system bag loaded (%u bytes, %s): %s, %u failed attempts\n", len,
+	    ours ? "ours" : "not ours", pass ? "passcode set, locked (before first unlock)" : "no passcode",
+	    failed);
+}
+
+/* ------------------------------------------------------------------ passcode checks */
+
+/* Copy a passcode the caller passed by address (aks_unlock_device, aks_change_secret). */
+static IOReturn
+sweet_aks_copyin_pass(uint64_t uaddr, uint64_t len, uint8_t *buf, size_t *outlen)
+{
+	*outlen = 0;
+	if (len == 0) {
+		return kIOReturnSuccess;
+	}
+	if (len > SWEET_AKS_PASS_MAX || uaddr == 0) {
+		return kIOReturnBadArgument;
+	}
+	if (copyin((user_addr_t)uaddr, buf, (vm_size_t)len) != 0) {
+		return kIOReturnBadArgument;
+	}
+	*outlen = (size_t)len;
+	return kIOReturnSuccess;
+}
+
+/*
+ * Check a passcode against the verifier, counting failures. No lock held on
+ * entry; the KDF runs unlocked on a copy of the secret. kIOReturnSuccess on a
+ * match (or with no passcode set), kIOReturnNotPermitted on a mismatch or while
+ * backing off. *post gets the notifications to send.
+ */
+static IOReturn
+sweet_aks_check(const uint8_t *pass, size_t len, uint32_t *post)
+{
+	struct sweet_aks_secret s;
+	uint8_t key[32];
+	uint32_t gen, failed = 0;
+	uint64_t left;
+	bool match;
+
+	IOLockLock(sweet_aks_lock);
+	if (!sa.has_pass) {
+		IOLockUnlock(sweet_aks_lock);
+		return kIOReturnSuccess;
+	}
+	left = sweet_aks_backoff_left_locked();
+	gen = sa.generation;
+	memcpy(&s, &sa.secret, sizeof(s));
+	IOLockUnlock(sweet_aks_lock);
+	if (left != 0) {
+		cc_clear(sizeof(s), &s);
+		IOLog("SWEET AKS: passcode refused, backing off for %llu s more\n", left);
+		return kIOReturnNotPermitted;
+	}
+
+	sweet_aks_pbkdf2(pass, len, s.salt, sizeof(s.salt), s.iterations, key);
+	match = cc_cmp_safe(sizeof(key), key, s.verifier) == 0;
+	cc_clear(sizeof(key), key);
+	cc_clear(sizeof(s), &s);
+
+	IOLockLock(sweet_aks_lock);
+	if (gen != sa.generation) {
+		/* the passcode changed meanwhile: neither a success nor a failure */
+		IOLockUnlock(sweet_aks_lock);
+		return kIOReturnNotPermitted;
+	}
+	if (match) {
+		sa.failed = 0;
+		sa.backoff_until = 0;
+	} else {
+		failed = ++sa.failed;
+		sweet_aks_arm_backoff_locked();
+		left = sweet_aks_backoff_left_locked();
+	}
+	IOLockUnlock(sweet_aks_lock);
+	if (match) {
+		return kIOReturnSuccess;
+	}
+	IOLog("SWEET AKS: wrong passcode, %u failed attempts, back-off %llu s\n", failed, left);
+	*post |= SWEET_AKS_POST_LOCK_STATE;
+	return kIOReturnNotPermitted;
+}
+
+/* Unlock after a good passcode (or none needed). sweet_aks_lock held. */
+static void
+sweet_aks_unlock_locked(uint32_t *post)
+{
+	if (!sa.been_unlocked) {
+		sa.been_unlocked = true;
