+/* aks_unlock_device: scalars { handle, user address of the passcode, length }. */
+static IOReturn
+sweet_aks_unlock_device(IOExternalMethodArguments *args, uint32_t *post)
+{
+	uint8_t pass[SWEET_AKS_PASS_MAX];
+	size_t len;
+	IOReturn ret;
+	bool check = false;
+
+	if (args->scalarInputCount < 3) {
+		return kIOReturnBadArgument;
+	}
+	ret = sweet_aks_copyin_pass(args->scalarInput[1], args->scalarInput[2], pass, &len);
+	if (ret != kIOReturnSuccess) {
+		return ret;
+	}
+	IOLockLock(sweet_aks_lock);
+	if (!sa.has_pass) {
+		sweet_aks_unlock_locked(post);
+	} else if (len == 0) {
+		/* no passcode given: fine while unlocked or within the grace period */
+		if (sa.locked) {
+			ret = kIOReturnNotPermitted;
+		} else {
+			sweet_aks_unlock_locked(post);
+		}
+	} else {
+		check = true;
+	}
+	IOLockUnlock(sweet_aks_lock);
+	if (check) {
+		ret = sweet_aks_check(pass, len, post);
+		if (ret == kIOReturnSuccess) {
+			IOLockLock(sweet_aks_lock);
+			sweet_aks_unlock_locked(post);
+			IOLockUnlock(sweet_aks_lock);
+		}
+	}
+	cc_clear(sizeof(pass), pass);
+	return ret;
+}
