+/* aks_lock_device: SpringBoard when the screen locks (8), or "lock now" (32). */
+static IOReturn
+sweet_aks_lock_device(bool now, uint32_t *post)
+{
+	uint64_t deadline = 0;
+	bool arm = false;
+
+	if (!now && sweet_aks_grace_secs != 0) {
+		clock_interval_to_deadline(sweet_aks_grace_secs, kSecondScale, &deadline);
+	}
+	IOLockLock(sweet_aks_lock);
+	if (sa.has_pass && !sa.locked) {
+		if (deadline != 0) {
+			if (!sa.locking) {
+				sa.locking = true;
+				sa.grace_deadline = deadline;
+				arm = true;
+				*post |= SWEET_AKS_POST_LOCK_STATE;
+			}
+		} else {
+			sa.locking = false;
+			sa.locked = true;
+			*post |= SWEET_AKS_POST_LOCK_STATE;
+		}
+	}
+	IOLockUnlock(sweet_aks_lock);
+	if (arm) {
+		thread_call_enter_delayed(sweet_aks_grace_call, deadline);
+	}
+	return kIOReturnSuccess;
+}
