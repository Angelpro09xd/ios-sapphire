+/* The grace period ran out: locked now. Thread call context, no lock held on entry. */
+static void
+sweet_aks_grace_fire(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	bool changed = false;
+
+	IOLockLock(sweet_aks_lock);
+	if (sa.locking && mach_absolute_time() >= sa.grace_deadline) {
+		sa.locking = false;
+		sa.locked = true;
+		changed = true;
+	}
+	IOLockUnlock(sweet_aks_lock);
+	if (changed) {
+		IOLog("SWEET AKS: grace period over: locked\n");
+		sweet_aks_post(SWEET_AKS_POST_LOCK_STATE);
+	}
+}
