+/*
+ * A large structure comes as a memory descriptor of the caller's memory, not wired yet: readBytes /
+ * writeBytes on it unprepared panicked ("IOGMD: not wired for the IODMACommand", keybagd's save of the
+ * bag after a passcode change, sel 3). Wired for the copy, then released.
+ */
+static IOByteCount
+sweet_aks_md_copy(IOMemoryDescriptor *md, void *buf, IOByteCount len, bool out)
+{
+	if (md->prepare() != kIOReturnSuccess) {
+		return 0;
+	}
+	IOByteCount n = out ? md->writeBytes(0, buf, len) : md->readBytes(0, buf, len);
+	md->complete();
+	return n;
+}
