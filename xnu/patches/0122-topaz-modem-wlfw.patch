@@ -2891,13 +2892,13 @@ scm_assign_to_modem(uint64_t addr, uint64_t size)
 	uint32_t *src = (uint32_t *)(p + 8);        /* 0x040: src vmids */
 	src[0] = VMID_HLOS;
 	uint32_t *dst = (uint32_t *)(p + 16);       /* 0x080: {vmid, perm, ctx(8), ctx_size, unused} x3 */
-	for (unsigned i = 0; i < 3; i++) {
