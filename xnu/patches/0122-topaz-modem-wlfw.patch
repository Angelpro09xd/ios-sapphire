 	return args[0] != 0 ? args[0] : res;
 }
 
@@ -2985,7 +2986,8 @@ rmtfs_rx(uint32_t node, uint32_t port, uint16_t txn, uint16_t msg, const uint8_t
 			if (rmtfs_va == NULL) {
 				rmtfs_pa = 0;
 			} else {
-				(void)scm_assign_to_modem(rmtfs_pa, RMTFS_BUF_SIZE);
+				static const uint32_t v[] = { VMID_HLOS, VMID_MSS_MSA, VMID_NAV };
+				(void)scm_assign(rmtfs_pa, RMTFS_BUF_SIZE, v, 3);
