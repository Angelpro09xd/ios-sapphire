 	p[35] = 0;
 	mb();
 	uint64_t args[8] = { SCM_FN(0x0C, 0x16), 7 | (1 << 4) | (1 << 8) | (1 << 12), pa, 16, pa + 0x40, pa + 0x100, 0, 0 };
@@ -2908,7 +2909,7 @@ scm_assign_to_modem(uint64_t addr, uint64_t size)
