 		rpm_status = -1;
 		return;
 	}
-	uint32_t off = 8, end = MIN(len, 8 + h[1]);
+	uint32_t off = 8, end = MIN(len, 8 + h[1]), id = 0;
+	bool has_id = false;
+	char s[40] = {};
 	while (off + 8 <= end) {
