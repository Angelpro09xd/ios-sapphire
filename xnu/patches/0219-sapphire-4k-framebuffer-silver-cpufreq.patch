From 723705d706f9d62852ddd62f4ec71629cbbfb4f9 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Sun, 25 Oct 2026 11:26:26 +0000
Subject: [PATCH 4/4] sapphire-0219: 4 KiB pages on sapphire: splash
 framebuffer at 0x9c000000 (not topaz's 0x5c000000), silver cluster to its top
 cpufreq level too

---
 bsd/dev/sweet_cpufreq.c   | 29 ++++++++++++++++++++---------
 osfmk/arm64/arm_vm_init.c |  2 +-
 osfmk/arm64/start.s       | 10 +++++-----
 osfmk/arm64/sweet_early.c |  2 +-
 4 files changed, 27 insertions(+), 16 deletions(-)

diff --git a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
index 94c7552..128fd74 100644
--- a/bsd/dev/sweet_cpufreq.c
+++ b/bsd/dev/sweet_cpufreq.c
@@ -2,6 +2,8 @@
  * topaz: run the Gold cluster at its top frequency. SM6225 cpufreq-hw
  * (qcom,cpufreq-hw, freq-domain1 at 0xf523000; msm-4.19 qcom-cpufreq-hw.c
  * layout): LUT at +0x110, 32-byte rows, PERF_STATE at +0x920.
+ * sapphire 0216: the Silver cluster too (freq-domain0 at 0xf521000), now
+ * that a 4 KiB-page kernel runs it as the E cluster.
  * Nothing scales it down again: there is no XNU cpufreq driver yet.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
@@ -13,20 +15,16 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 int sweet_cpufreq_max(void);
 
 #define CPUFREQ_GOLD_PA         0x0f523000u
+#define CPUFREQ_SILVER_PA       0x0f521000u
 #define CPUFREQ_FREQ_LUT        0x110u
 #define CPUFREQ_LUT_ROW         0x20u
 #define CPUFREQ_PERF_STATE      0x920u
 #define CPUFREQ_LUT_MAX         12
 
-int
-sweet_cpufreq_max(void)
+static int
+sweet_cpufreq_domain_max(uint32_t pa, const char *name)
 {
-	int on = 1;
-	PE_parse_boot_argn("sweetcpufreq", &on, sizeof(on));
-	if (!on) {
-		return 0;
-	}
-	vm_offset_t b = ml_io_map(CPUFREQ_GOLD_PA, 0x1000);
+	vm_offset_t b = ml_io_map(pa, 0x1000);
 	if (b == 0) {
 		return -1;
 	}
@@ -48,7 +46,20 @@ sweet_cpufreq_max(void)
 	__asm__ volatile("dsb sy" ::: "memory");
 	*(volatile uint32_t *)(b + CPUFREQ_PERF_STATE) = best;
 	__asm__ volatile("dsb sy" ::: "memory");
-	printf("SWEET CPUFREQ: gold perf state %u -> %u (%u MHz)\n", old, best, bestKHz / 1000);
+	printf("SWEET CPUFREQ: %s perf state %u -> %u (%u MHz)\n", name, old, best, bestKHz / 1000);
 	return 0;
 }
+
+int
+sweet_cpufreq_max(void)
+{
+	int on = 1;
+	PE_parse_boot_argn("sweetcpufreq", &on, sizeof(on));
+	if (!on) {
+		return 0;
+	}
+	int rc = sweet_cpufreq_domain_max(CPUFREQ_GOLD_PA, "gold");
+	(void)sweet_cpufreq_domain_max(CPUFREQ_SILVER_PA, "silver");
+	return rc;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index b926886..694edc9 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1853,7 +1853,7 @@ sweet_early_map_final(void)
 		}
 	}
 	for (unsigned int i = 0; i < 6; i++) {
-		l2[first + i] = (0x5c000000ULL + i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		l2[first + i] = (0x9c000000ULL + i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 9fd1cb9..4f8d562 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -516,7 +516,7 @@ LEXT(start_first_cpu)
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
 #if defined(TOPAZ_4K)
-	MOV64	x0, (0x5c000000 + 2368 * 4320)	/* topaz splash framebuffer */
+	MOV64	x0, (0x9c000000 + 2368 * 4320)	/* sapphire splash framebuffer */
 #else
 	MOV64	x0, (0x9c000000 + 2368 * 4320)
 #endif
@@ -684,12 +684,12 @@ Lkernelcache_base_found:
 
 #if defined(SWEET) && defined(TOPAZ_4K)
 	/*
-	 * topaz splash framebuffer (0x5c000000, 1080x2400x4 = 10 MB) VA=PA as
-	 * Normal-NC: six 2 MB blocks in an L2 table of its own (L1 index 1;
-	 * RAM is at 0x140000000), for the early screen console.
+	 * sapphire splash framebuffer (0x9c000000, 1080x2400x4 = 10 MB) VA=PA as
+	 * Normal-NC: six 2 MB blocks in an L2 table of its own (L1 index 2;
+	 * RAM is above 4 GB), for the early screen console.
 	 */
 	add		x2, x2, PGBYTES
-	MOV64	x10, 0x5c000000
+	MOV64	x10, 0x9c000000
 	create_l1_table_entry x10, x1, x2, x11, x12, x13
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 9429767..0644461 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -12,7 +12,7 @@
 #include <kern/misc_protos.h>
 
 #if defined(TOPAZ_4K)
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x5c000000;  /* topaz splash */
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;  /* sapphire splash */
 #else
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
 #endif
-- 
